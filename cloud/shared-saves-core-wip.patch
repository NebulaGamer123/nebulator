+// Shared Saves: a named save that several PCs keep in step through a small cloud store (see cloud/worker.js).
+//
+//  - a save is linked to one game on this PC. While linked, the game's real save folder holds the shared save
+//    (the player's own save is set aside and put back when they switch back)
+//  - before the game starts the newest version is downloaded, while it runs every save is uploaded a few seconds after it
+//    happens, and when it closes anything left over is uploaded
+//  - the server keeps the current and the previous version, so a bad overwrite can be undone
+
+#include "ControlApi.h"
+
+#include "config/ActiveSettings.h"
+
+#include <curl/curl.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <random>
+#include <thread>
+
