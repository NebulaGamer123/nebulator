+					loggedInit = true;
+					EngineLog("The game initialised the graphics system (GX2Init) after " + std::to_string(sec) + " s", true);
+				}
+				std::string ipc = "?";
+				{
+					std::unique_lock l(g_ipcM, std::try_to_lock);
+					if (l.owns_lock())
+					{
+						int n = 0;
+						for (auto& [k, e] : g_ipc)
+							if (!e.done && !e.exempt)
+								n++;
+						ipc = std::to_string(n) + "/" + std::to_string(g_ipc.size());
+					}
+				}
+				char buf[420];
+				snprintf(buf, sizeof(buf),
+					"t=%ds tick=%u sysEv/s=%llu idle/s=%llu slices/s=%llu | gx2=%d gpuAlive=%d ungated=%d epoch=%u seen=%u limit=%u ring r/w=%u/%u polls/s=%llu windows/s=%llu | ipc pending=%s impure=%u stalls=%u virtCycles=%llu | syncCompiles=%llu (%llu ms total)",
+					sec, g_dbgTick.load(), (unsigned long long)(sys - pSys), (unsigned long long)(idle - pIdle), (unsigned long long)(sl - pSl), gx2 ? 1 : 0, g_gpuAlive.load() ? 1 : 0, g_gpuUngated.load() ? 1 : 0,
+					g_epoch.load(), g_gpuSeen.load(), g_gpuLimit.load(), TCL::TCLGetRingReadIndex(), TCL::TCLGetRingWriteIndex(), (unsigned long long)(poll - pPoll), (unsigned long long)(win - pWin), ipc.c_str(), g_impure, g_stalls,
+					(unsigned long long)VirtualCycles(), (unsigned long long)g_dbgCompiles.load(), (unsigned long long)(g_dbgCompileUs.load() / 1000));
+				EngineLog(buf, false);
+				if (sys == pSys)
+				{
+					char w[400];
+					uint32_t curPc = 0, curLr = 0;
+					if (auto* c = g_dbgCpu.load()) { curPc = c->instructionPointer; curLr = c->spr.LR; }
+					snprintf(w, sizeof(w), "   stuck-in: %s | last guest thread '%s' entry=%08x slicePC=%08x sliceLR=%08x | now PC=%08x LR=%08x",
+						g_dbgWhere.load(), g_dbgThrName.load(), g_dbgThrEntry.load(), g_dbgThrPc.load(), g_dbgThrLr.load(), curPc, curLr);
+					EngineLog(w, false);
+					if (auto* c = g_dbgCpu.load())
+					{
+						std::string hle = "(not an HLE stub)";
+						const uint32_t pc = c->instructionPointer;
+						if (pc >= 0x00010000 && pc < 0xE0000000)
+						{
+							const uint32_t op = memory_readU32(pc);
+							if ((op >> 26) == 1)
+								hle = PPCInterpreter_getHLEName((HLEIDX)(op & 0xFFFF));
+						}
+						snprintf(w, sizeof(w), "   blocked in host function: %s | r3=%08x r4=%08x r5=%08x r6=%08x", hle.c_str(), c->gpr[3], c->gpr[4], c->gpr[5], c->gpr[6]);
+						EngineLog(w, false);
+					}
+				}
+				if (sys == pSys)
+				{
+					stalledSecs++;
+					if (stalledSecs == 3)
+						EngineLog("The game's CPU scheduler has not reached its system-event loop for 3 s (virtual time cannot advance)", true);
+				}
+				else
+					stalledSecs = 0;
+				pSys = sys; pIdle = idle; pSl = sl; pWin = win; pPoll = poll;
+			}
+			g_dbgRun = false;
+		}
+	} // namespace
