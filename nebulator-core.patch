+// =================================================================================================
+// menu mode, game launch, entry point
+// =================================================================================================
+namespace
+{
+	void SetError(const std::string& e)
+	{
+		std::scoped_lock l(g_stateMutex);
+		g_lastError = e;
+	}
+
+	std::string SelfExePath()
+	{
+#if BOOST_OS_WINDOWS
+		wchar_t buf[MAX_PATH * 2];
+		DWORD n = GetModuleFileNameW(nullptr, buf, (DWORD)std::size(buf));
+		return boost::nowide::narrow(std::wstring(buf, n));
+#else
+		std::error_code ec;
+		return _pathToUtf8(fs::read_symlink("/proc/self/exe", ec));
+#endif
+	}
+
+	std::string LoadOrCreateToken()
+	{
+		const fs::path file = ActiveSettings::GetUserDataPath("ui-token.txt");
+		{
+			std::ifstream in(file);
+			std::string t;
+			if (in && std::getline(in, t) && t.size() >= 32)
+				return t;
+		}
+		std::random_device rd;
+		std::string t;
+		for (int i = 0; i < 32; i++)
+			t += "0123456789abcdef"[rd() & 15];
+		std::ofstream out(file, std::ios::trunc);
+		out << t;
+		return t;
+	}
+
+	void OpenUi(const std::string& url)
+	{
+#if BOOST_OS_WINDOWS
+		const std::string arg = "--app=" + url;
+		const char* args[] = {"cmd", "/c", "start", "", "msedge", arg.c_str(), nullptr};
+		if (SDL_Process* p = SDL_CreateProcess(args, false))
+			SDL_DestroyProcess(p);
+		else
+			SDL_OpenURL(url.c_str());
+#else
+		SDL_OpenURL(url.c_str());
+#endif
+	}
+
+	void RelaunchMenu()
+	{
+		Lockstep::GameStopped();
+		g_server.Stop();
+		SDL_setenv_unsafe("NEBULATOR_RELAUNCH", "1", 1);
+		const std::string exe = SelfExePath();
+		const char* args[] = {exe.c_str(), nullptr};
+		if (SDL_Process* p = SDL_CreateProcess(args, false))
+			SDL_DestroyProcess(p);
+	}
+
+	void SaveErrorForNextRun(const std::string& e)
+	{
+		std::ofstream out(ActiveSettings::GetUserDataPath("last-error.txt"), std::ios::trunc);
+		out << e;
+	}
+
+	// returns false (with the error stored) when the game could not be started; the menu keeps running then
+	bool StartGame(const LaunchRequest& req)
+	{
+		g_state = ControlApi::State::Loading;
+		SetError("");
+		const fs::path path = _utf8ToPath(req.path);
+		std::string error;
+
+		if (!InitializeGlobalVulkan())
+		{
+			SetError("No usable Vulkan driver was found. NEBULATOR needs Vulkan 1.1 or newer.");
+			g_state = ControlApi::State::Ui;
+			return false;
+		}
+		g_window = SDL_CreateWindow("NEBULATOR", 1280, 720, SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIGH_PIXEL_DENSITY);
+		if (!g_window)
+		{
+			SetError(std::string("Couldn't create the window: ") + SDL_GetError());
+			g_state = ControlApi::State::Ui;
+			return false;
+		}
+		RefreshSizes();
+		g_window_info.app_active = true;
+		g_window_info.pad_open = false;
+		g_window_info.window_main = g_window_info.canvas_main = GetNativeHandle(g_window);
+		if (req.fullscreen)
+			SetFullscreen(true);
+
+		if (!PrepareTitle(path, std::nullopt, error))
+		{
+			SetError(error);
+			SDL_DestroyWindow(g_window);
+			g_window = nullptr;
+			g_state = ControlApi::State::Ui;
+			return false;
+		}
+		g_gameStarted = true;
+		try
+		{
+			g_renderer = std::make_unique<VulkanRenderer>();
+			VulkanRenderer::GetInstance()->InitializeSurface({g_window_info.phys_width.load(), g_window_info.phys_height.load()}, true);
+		}
+		catch (const std::exception& ex)
+		{
+			// the core can't be rewound after PrepareForegroundTitle: report and restart into the menu
+			SaveErrorForNextRun(std::string("Error when initialising the Vulkan renderer:\n") + ex.what());
+			g_quit = true;
+			g_state = ControlApi::State::Ui;
+			return false;
+		}
+		{
+			std::scoped_lock l(g_stateMutex);
+			g_currentTitle = CafeSystem::GetForegroundTitleName();
+		}
+		AssignDefaultInput();
+		ControlApi::SkyRestore();
+		CafeSystem::LaunchForegroundTitle();
+		g_state = ControlApi::State::Running;
+		return true;
+	}
+
+	void SetupControlApi()
+	{
+		ControlApi::Callbacks cb;
+		cb.state = [] { return g_state.load(); };
+		cb.lastError = [] { std::scoped_lock l(g_stateMutex); return g_lastError; };
+		cb.currentTitle = [] { std::scoped_lock l(g_stateMutex); return g_currentTitle; };
+		cb.launch = [](const std::string& path, bool fullscreen, std::string& err)
+		{
+			std::scoped_lock l(g_stateMutex);
+			if (g_launchRequest || g_state != ControlApi::State::Ui)
+			{
+				err = "busy";
+				return false;
+			}
+			g_launchRequest = LaunchRequest{path, fullscreen};
+			return true;
+		};
+		cb.quit = [](bool appQuit)
+		{
+			g_appQuit = appQuit;
+			g_quit = true;
+		};
+		const fs::path uiDir = ActiveSettings::GetDataPath("ui");
+		ControlApi::Init(std::move(cb), LoadOrCreateToken(), uiDir);
+		Lockstep::Init({});
+	}
+} // namespace
+
+void WindowSystem::Create()
+{
+	// ---- paths, config, MLC (CemuApp::OnInit) ----
+	std::set<fs::path> failedWriteAccess;
+	DeterminePaths(failedWriteAccess);
+	for (auto& path : failedWriteAccess)
+		cemuLog_log(LogType::Force, "NEBULATOR can't write to {}", _pathToUtf8(path));
+
+	std::error_code ec;
+	fs::create_directories(ActiveSettings::GetConfigPath("controllerProfiles"), ec);
+	fs::create_directories(ActiveSettings::GetUserDataPath("memorySearcher"), ec);
+
+	GetConfigHandle().SetFilename(ActiveSettings::GetConfigPath("settings.xml").generic_wstring());
+	const bool isFirstStart = !fs::exists(ActiveSettings::GetConfigPath("settings.xml"), ec);
+	NetworkConfig::LoadOnce();
+	if (!isFirstStart)
+		GetConfigHandle().Load();
+	else
+		GetConfigHandle().Save();
+
+	if (!CreateDefaultMLCFiles(ActiveSettings::GetMlcPath()))
+	{
+		Fatal("NEBULATOR failed to write to the mlc directory:\n" + _pathToUtf8(ActiveSettings::GetMlcPath()));
+		std::_Exit(1);
+	}
+	ActiveSettings::Init();
+	LatteOverlay_init();
+
+	// ---- SDL: video for our window, gamepads for the input layer ----
+	SDL_SetHint(SDL_HINT_JOYSTICK_ALLOW_BACKGROUND_EVENTS, "1");
+	if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_EVENTS))
+	{
+		Fatal(std::string("Couldn't initialise SDL video: ") + SDL_GetError());
+		std::_Exit(1);
+	}
+	try
+	{
+		SDLControllerProvider::InitSDL(); // must happen before InputManager creates the provider
+	}
+	catch (const std::exception& ex)
+	{
+		cemuLog_log(LogType::Force, "Gamepad support unavailable: {}", ex.what());
+	}
+
+	// ---- core subsystems (audio, graphic packs, input, CafeSystem, title list) ----
+	CemuCommonInit();
+	GetConfig().graphic_api = kVulkan; // the only backend NEBULATOR builds
+	CafeSystem::SetImplementation(&g_systemImpl);
+	g_userProfileLoaded = InputManager::instance().get_controller(0) != nullptr;
+
+	// ---- control server + UI ----
+	SetupControlApi();
+	if (!g_server.Start(kUiPort, [](const HttpRequest& r) { return ControlApi::Handle(r); }))
+	{
+		Fatal("NEBULATOR couldn't open its local control port (17771-17780). Is another copy already running?");
+		std::_Exit(1);
+	}
+	const std::string url = fmt::format("http://127.0.0.1:{}/", g_server.Port());
+	{
+		std::ifstream in(ActiveSettings::GetUserDataPath("last-error.txt"));
+		std::string e((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+		in.close();
+		if (!e.empty())
+		{
+			SetError(e);
+			fs::remove(ActiveSettings::GetUserDataPath("last-error.txt"), ec);
+		}
+	}
+	AssignDefaultInput();
+
+	// direct launch from the command line: nebulator-core -g <game>
+	std::optional<LaunchRequest> startup;
+	if (LaunchSettings::GetLoadFile())
+	{
+		g_directLaunch = true;
+		startup = LaunchRequest{_pathToUtf8(*LaunchSettings::GetLoadFile()), LaunchSettings::FullscreenEnabled().value_or(false)};
+	}
+	else if (LaunchSettings::GetLoadTitleID())
+	{
+		// resolve through the title list
+		g_directLaunch = true;
+		GameInfo2 gi = CafeTitleList::GetGameInfo(*LaunchSettings::GetLoadTitleID());
+		if (gi.IsValid())
+			startup = LaunchRequest{_pathToUtf8(gi.GetBase().GetPath()), LaunchSettings::FullscreenEnabled().value_or(false)};
+	}
+	if (startup)
+		g_launchRequest = startup;
+
+	const bool relaunched = SDL_getenv("NEBULATOR_RELAUNCH") != nullptr;
+	const Uint64 startTicks = SDL_GetTicks();
+	bool openedUi = g_directLaunch; // direct launches don't open the menu
+	bool openedFallback = false;
+	if (!relaunched && !openedUi)
+	{
+		OpenUi(url + "?t=" + ControlApi::GetToken());
+		openedUi = true;
+	}
+
+	// ---- main loop ----
+	while (!g_quit)
+	{
+		SDL_Event e;
+		if (SDL_WaitEventTimeout(&e, 30))
+		{
+			do
+			{
+				HandleEvent(e);
+			} while (SDL_PollEvent(&e));
+		}
+		if (g_titleDirty.exchange(false) && g_window)
+		{
+			std::scoped_lock lock(g_titleMutex);
+			SDL_SetWindowTitle(g_window, g_pendingTitle.c_str());
+		}
+
+		if (g_state == ControlApi::State::Ui)
+		{
+			std::optional<LaunchRequest> req;
+			{
+				std::scoped_lock l(g_stateMutex);
+				req = std::move(g_launchRequest);
+				g_launchRequest.reset();
+			}
+			if (req && !StartGame(*req))
+			{
+				if (g_directLaunch)
+				{
+					std::string err;
+					{
+						std::scoped_lock l(g_stateMutex);
+						err = g_lastError;
+					}
+					Fatal(err.empty() ? "Failed to start the game." : err);
+					std::_Exit(1);
+				}
+			}
+
+			// menu bookkeeping: bring the UI up after a relaunch if the old window is gone, and quit when it is abandoned
+			if (g_state == ControlApi::State::Ui && !g_directLaunch)
+			{
+				const int64_t since = ControlApi::MsSinceLastPoll();
+				const Uint64 up = SDL_GetTicks() - startTicks;
+				if (relaunched && since < 0 && up > 5000 && !openedFallback)
+				{
+					OpenUi(url + "?t=" + ControlApi::GetToken());
+					openedFallback = true;
+				}
+				if (since >= 0 && since > 180000)
+					g_quit = true; // the UI window was closed
+				else if (since < 0 && up > 120000)
+					g_quit = true; // the UI never connected
+			}
+		}
+	}
+
+	// ---- shutdown ----
+	if (g_gameStarted)
+	{
+		if (auto status = CafeSystem::GetForegroundTitleReturnStatus())
+			g_exitCode = *status;
+		CafeSystem::Shutdown();
+	}
+	InputManager::instance().Shutdown();
+	SDLControllerProvider::ShutdownSDL();
+	fflush(stdout);
+	fflush(stderr);
+	if (g_gameStarted && !g_directLaunch && !g_appQuit)
+		RelaunchMenu();
+	else
+		g_server.Stop();
+	// Skip static destructors: the GPU/audio threads may still be winding down and Cemu itself does not
+	// tear the renderer down cleanly either.
+	std::_Exit(g_exitCode);
+}
