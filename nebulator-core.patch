+++ b/src/gui/sdlgui/ControlApi.cpp
@@ -0,0 +1,689 @@
+#include "ControlApi.h"
+
+#include "config/ActiveSettings.h"
+#include "config/CemuConfig.h"
+#include "Cafe/TitleList/TitleList.h"
+#include "Cafe/TitleList/TitleInfo.h"
+#include "Cafe/TitleList/GameInfo.h"
+#include "audio/IAudioAPI.h"
+
+#include <SDL3/SDL.h>
+#include <atomic>
+#include <fstream>
+#include <mutex>
+#include "Cafe/Filesystem/fsc.h"
+#include "util/helpers/helpers.h"
+#include <chrono>
+#include <set>
+
+#if BOOST_OS_WINDOWS
+#include <windows.h>
+#endif
+
+namespace ControlApi
+{
+	namespace
+	{
+		Callbacks g_cb;
+		std::string g_token;
+		fs::path g_uiDir;
+		std::atomic<int64_t> g_lastPollMs{-1};
+
+		int64_t NowMs()
+		{
+			return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+		}
+
+
+		std::string ContentType(const std::string& ext)
+		{
+			if (ext == ".html") return "text/html; charset=utf-8";
+			if (ext == ".css") return "text/css; charset=utf-8";
+			if (ext == ".js") return "text/javascript; charset=utf-8";
+			if (ext == ".json") return "application/json";
+			if (ext == ".svg") return "image/svg+xml";
+			if (ext == ".png") return "image/png";
+			if (ext == ".ico") return "image/x-icon";
+			if (ext == ".woff2") return "font/woff2";
+			return "application/octet-stream";
+		}
+
+		HttpResponse ServeStatic(const std::string& urlPath)
+		{
+			std::string p = urlPath == "/" ? "/index.html" : urlPath;
+			if (p.find("..") != std::string::npos || p.find('\\') != std::string::npos || p.find('\0') != std::string::npos)
+				return Err(403, "forbidden");
+			for (char c : p)
+				if (!(std::isalnum((unsigned char)c) || c == '/' || c == '.' || c == '-' || c == '_'))
+					return Err(403, "forbidden");
+			fs::path file = g_uiDir / fs::path(p.substr(1));
+			std::error_code ec;
+			if (!fs::is_regular_file(file, ec))
+				return Err(404, "not found");
+			std::ifstream in(file, std::ios::binary);
+			if (!in)
+				return Err(404, "not found");
+			HttpResponse r;
+			r.contentType = ContentType(file.extension().string());
+			r.body.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+			return r;
+		}
+
+		std::string RegionString(CafeConsoleRegion r)
+		{
+			std::string s;
+			auto add = [&](CafeConsoleRegion flag, const char* n)
+			{
+				if (((uint32)r & (uint32)flag) != 0)
+				{
+					if (!s.empty()) s += "/";
+					s += n;
+				}
+			};
+			add(CafeConsoleRegion::JPN, "JPN");
+			add(CafeConsoleRegion::USA, "USA");
+			add(CafeConsoleRegion::EUR, "EUR");
+			add(CafeConsoleRegion::CHN, "CHN");
+			add(CafeConsoleRegion::KOR, "KOR");
+			add(CafeConsoleRegion::TWN, "TWN");
+			return s.empty() ? "-" : s;
+		}
+
+		const char* FormatString(TitleInfo::TitleDataFormat f)
+		{
+			switch (f)
+			{
+			case TitleInfo::TitleDataFormat::HOST_FS: return "folder";
+			case TitleInfo::TitleDataFormat::WUD: return "wud/wux";
+			case TitleInfo::TitleDataFormat::WIIU_ARCHIVE: return "wua";
+			case TitleInfo::TitleDataFormat::NUS: return "nus";
+			case TitleInfo::TitleDataFormat::WUHB: return "wuhb";
+			default: return "unknown";
+			}
+		}
+
+		void WriteTitleInfo(Json& j, TitleInfo& t)
+		{
+			j.w.StartObject();
+			j.KS("titleId", HexId(t.GetAppTitleId()));
+			j.KI("version", t.GetAppTitleVersion());
+			j.KS("path", _pathToUtf8(t.GetPath()));
+			j.KS("format", FormatString(t.GetFormat()));
+			j.w.EndObject();
+		}
+
+
+		// ------------------------------------------------------------------ game icon
+		// Every Wii U title ships its icon as meta/iconTex.tga (sometimes gzipped). We extract it once, cache the raw
+		// TGA in <data>/icons and hand the bytes to the UI, which decodes and draws it.
+		HttpResponse Icon(const HttpRequest& req)
+		{
+			const std::string idStr = QueryParam(req, "id");
+			if (idStr.size() != 16 || idStr.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos)
+				return Err(400, "bad id");
+			const TitleId titleId = std::strtoull(idStr.c_str(), nullptr, 16);
+			static std::mutex s_mtx;
+			std::lock_guard<std::mutex> lock(s_mtx);
+
+			std::error_code ec;
+			const fs::path cacheDir = ActiveSettings::GetUserDataPath() / "icons";
+			const fs::path cacheFile = cacheDir / (idStr + ".tga");
+			HttpResponse r;
+			r.contentType = "application/octet-stream";
+			{
+				std::ifstream in(cacheFile, std::ios::binary);
+				if (in)
+				{
+					r.body.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+					if (r.body.size() > 18)
+						return r;
+				}
+			}
+			TitleInfo titleInfo;
+			if (!CafeTitleList::GetFirstByTitleId(titleId, titleInfo))
+				return Err(404, "unknown title");
+			const std::string mountPath = TitleInfo::GetUniqueTempMountingPath();
+			if (!titleInfo.Mount(mountPath, "", FSC_PRIORITY_BASE))
+				return Err(404, "can't open title");
+			auto tga = fsc_extractFile((mountPath + "/meta/iconTex.tga").c_str());
+			if (!tga)
+			{
+				tga = fsc_extractFile((mountPath + "/meta/iconTex.tga.gz").c_str());
+				if (tga)
+				{
+					auto dec = zlibDecompress(*tga, 70 * 1024);
+					std::swap(tga, dec);
+				}
+			}
+			titleInfo.Unmount(mountPath);
+			if (!tga || tga->size() <= 18)
+				return Err(404, "no icon");
+			fs::create_directories(cacheDir, ec);
+			{
+				std::ofstream out(cacheFile, std::ios::binary | std::ios::trunc);
+				if (out)
+					out.write((const char*)tga->data(), (std::streamsize)tga->size());
+			}
+			r.body.assign((const char*)tga->data(), tga->size());
+			return r;
+		}
+
+		// ------------------------------------------------------------------ library
+		HttpResponse Library()
+		{
+			Json j;
+			j.w.StartObject();
+			j.KB("scanning", CafeTitleList::IsScanning());
+			j.K("games");
+			j.w.StartArray();
+			std::set<TitleId> seen;
+			for (TitleId id : CafeTitleList::GetAllTitleIds())
+			{
+				TitleId base;
+				if (!CafeTitleList::FindBaseTitleId(id, base))
+					continue;
+				if (!seen.insert(base).second)
+					continue;
+				GameInfo2 gi = CafeTitleList::GetGameInfo(base);
+				if (!gi.IsValid() || gi.IsSystemDataTitle())
+					continue;
+				j.w.StartObject();
+				j.KS("titleId", HexId(base));
+				j.KS("name", gi.GetTitleName());
+				j.KI("version", gi.GetVersion());
+				j.KS("region", RegionString(gi.GetRegion()));
+				j.K("base");
+				WriteTitleInfo(j, gi.GetBase());
+				j.K("update");
+				if (gi.HasUpdate())
+					WriteTitleInfo(j, gi.GetUpdate());
+				else
+					j.w.Null();
+				j.K("dlc");
+				j.w.StartArray();
+				for (auto& aoc : gi.GetAOC())
+					WriteTitleInfo(j, aoc);
+				j.w.EndArray();
+				j.w.EndObject();
+			}
+			j.w.EndArray();
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		// ------------------------------------------------------------------ settings
+		void WriteSettings(Json& j)
+		{
+			auto& c = GetConfig();
+			j.w.StartObject();
+			j.K("gamePaths");
+			j.w.StartArray();
+			for (auto& p : c.game_paths)
+				j.S(p);
+			j.w.EndArray();
+			j.KI("vsync", c.vsync.GetValue());
+			j.KB("asyncCompile", c.async_compile.GetValue());
+			j.KI("upscaleFilter", c.upscale_filter.GetValue());
+			j.KI("downscaleFilter", c.downscale_filter.GetValue());
+			j.KI("fullscreenScaling", c.fullscreen_scaling.GetValue());
+			j.KI("cpuMode", (int)c.cpu_mode.GetValue());
+			j.KI("language", (int)c.console_language.GetValue());
+			j.KB("overlayFps", c.overlay.position != ScreenPosition::kDisabled && c.overlay.fps);
+			j.KB("overlayCpu", c.overlay.position != ScreenPosition::kDisabled && c.overlay.cpu_usage);
+			j.KB("overlayRam", c.overlay.position != ScreenPosition::kDisabled && c.overlay.ram_usage);
+			j.KI("audioApi", c.audio_api);
+			j.KI("audioDelay", c.audio_delay);
+			j.KS("tvDevice", boost::nowide::narrow(c.tv_device));
+			j.KI("tvVolume", c.tv_volume);
+			j.KI("padVolume", c.pad_volume);
+			j.KI("portalVolume", c.portal_volume);
+			j.KI("tvChannels", (int)c.tv_channels);
+			j.KB("playBootSound", c.play_boot_sound.GetValue());
+			j.KB("emulateSkylanderPortal", c.emulated_usb_devices.emulate_skylander_portal.GetValue());
+			j.w.EndObject();
+		}
+
+		HttpResponse SetSettings(const HttpRequest& req)
+		{
+			rapidjson::Document d;
+			if (!ParseBody(req, d))
+				return Err(400, "invalid json");
+			auto& c = GetConfig();
+			if (d.HasMember("gamePaths") && d["gamePaths"].IsArray())
+			{
+				c.game_paths.clear();
+				for (auto& v : d["gamePaths"].GetArray())
+					if (v.IsString() && v.GetStringLength() > 0)
+						c.game_paths.emplace_back(v.GetString());
+			}
+			if (Has(d, "vsync")) c.vsync = (int)std::clamp<int64_t>(GetInt(d, "vsync"), 0, 3);
+			if (Has(d, "asyncCompile")) c.async_compile = GetBool(d, "asyncCompile");
+			if (Has(d, "upscaleFilter")) c.upscale_filter = (sint32)std::clamp<int64_t>(GetInt(d, "upscaleFilter"), 0, 3);
+			if (Has(d, "downscaleFilter")) c.downscale_filter = (sint32)std::clamp<int64_t>(GetInt(d, "downscaleFilter"), 0, 3);
+			if (Has(d, "fullscreenScaling")) c.fullscreen_scaling = (sint32)std::clamp<int64_t>(GetInt(d, "fullscreenScaling"), 0, 1);
+			if (Has(d, "cpuMode"))
+			{
+				int64_t m = GetInt(d, "cpuMode");
+				if (m == 0 || m == 1 || m == 3 || m == 4)
+					c.cpu_mode = (CPUMode)m;
+			}
+			if (Has(d, "language")) c.console_language = (CafeConsoleLanguage)std::clamp<int64_t>(GetInt(d, "language"), 0, 11);
+			if (Has(d, "overlayFps") || Has(d, "overlayCpu") || Has(d, "overlayRam"))
+			{
+				const bool fps = Has(d, "overlayFps") ? GetBool(d, "overlayFps") : (c.overlay.position != ScreenPosition::kDisabled && c.overlay.fps);
+				const bool cpu = Has(d, "overlayCpu") ? GetBool(d, "overlayCpu") : (c.overlay.position != ScreenPosition::kDisabled && c.overlay.cpu_usage);
+				const bool ram = Has(d, "overlayRam") ? GetBool(d, "overlayRam") : (c.overlay.position != ScreenPosition::kDisabled && c.overlay.ram_usage);
+				c.overlay.fps = fps;
+				c.overlay.cpu_usage = cpu;
+				c.overlay.ram_usage = ram;
+				c.overlay.position = (fps || cpu || ram) ? ScreenPosition::kTopLeft : ScreenPosition::kDisabled;
+			}
+			if (Has(d, "audioApi")) c.audio_api = (sint32)std::clamp<int64_t>(GetInt(d, "audioApi"), 0, 3);
+			if (Has(d, "audioDelay")) c.audio_delay = (sint32)std::clamp<int64_t>(GetInt(d, "audioDelay"), 0, 5);
+			if (Has(d, "tvDevice")) c.tv_device = boost::nowide::widen(GetStr(d, "tvDevice", "default"));
+			if (Has(d, "tvVolume")) c.tv_volume = (sint32)std::clamp<int64_t>(GetInt(d, "tvVolume"), 0, 100);
+			if (Has(d, "padVolume")) c.pad_volume = (sint32)std::clamp<int64_t>(GetInt(d, "padVolume"), 0, 100);
+			if (Has(d, "portalVolume")) c.portal_volume = (sint32)std::clamp<int64_t>(GetInt(d, "portalVolume"), 0, 100);
+			if (Has(d, "tvChannels")) c.tv_channels = (AudioChannels)std::clamp<int64_t>(GetInt(d, "tvChannels"), 0, 2);
+			if (Has(d, "playBootSound")) c.play_boot_sound = GetBool(d, "playBootSound");
+			if (Has(d, "emulateSkylanderPortal")) c.emulated_usb_devices.emulate_skylander_portal = GetBool(d, "emulateSkylanderPortal");
+			GetConfigHandle().Save();
+			Json j;
+			WriteSettings(j);
+			return Ok(j);
+		}
+
+		HttpResponse AudioInfo(const HttpRequest& req)
+		{
+			Json j;
+			j.w.StartObject();
+			j.K("apis");
+			j.w.StartArray();
+			const char* names[] = {"DirectSound", "XAudio 2.7", "XAudio 2", "Cubeb"};
+			for (int i = 0; i < 4; i++)
+			{
+				j.w.StartObject();
+				j.KI("id", i);
+				j.KS("name", names[i]);
+				bool avail = false;
+				try { avail = IAudioAPI::IsAudioAPIAvailable((IAudioAPI::AudioAPI)i); } catch (...) {}
+				j.KB("available", avail);
+				j.w.EndObject();
+			}
+			j.w.EndArray();
+			int api = GetConfig().audio_api;
+			const std::string q = QueryParam(req, "api");
+			if (!q.empty()) api = std::atoi(q.c_str());
+			j.K("devices");
+			j.w.StartArray();
+			try
+			{
+				if (api >= 0 && api < 4 && IAudioAPI::IsAudioAPIAvailable((IAudioAPI::AudioAPI)api))
+				{
+					for (auto& dev : IAudioAPI::GetDevices((IAudioAPI::AudioAPI)api))
+					{
+						j.w.StartObject();
+						j.KS("id", boost::nowide::narrow(dev->GetIdentifier()));
+						j.KS("name", boost::nowide::narrow(dev->GetName()));
+						j.w.EndObject();
+					}
+				}
+			}
+			catch (...) {}
+			j.w.EndArray();
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		// ------------------------------------------------------------------ folder browser
+		HttpResponse Browse(const HttpRequest& req)
+		{
+			std::string path = QueryParam(req, "path");
+			Json j;
+			j.w.StartObject();
+			j.K("entries");
+			j.w.StartArray();
+			std::string parent;
+			std::string current;
+			std::error_code ec;
+#if BOOST_OS_WINDOWS
+			if (path.empty())
+			{
+				DWORD mask = GetLogicalDrives();
+				for (int i = 0; i < 26; i++)
+					if (mask & (1u << i))
+					{
+						j.w.StartObject();
+						j.KS("name", std::string(1, (char)('A' + i)) + ":");
+						j.KS("path", std::string(1, (char)('A' + i)) + ":\\");
+						j.KI("games", 0);
+						j.w.EndObject();
+					}
+				j.w.EndArray();
+				j.KS("path", "");
+				j.KS("parent", "");
+				j.w.EndObject();
+				return Ok(j);
+			}
+#else
+			if (path.empty())
+				path = "/";
+#endif
+			fs::path dir = _utf8ToPath(path);
+			if (!fs::is_directory(dir, ec))
+				return Err(404, "not a folder");
+			current = _pathToUtf8(dir);
+			parent = dir.has_parent_path() && dir.parent_path() != dir ? _pathToUtf8(dir.parent_path()) : "";
+			std::vector<std::pair<std::string, std::string>> dirs;
+			int games = 0;
+			for (fs::directory_iterator it(dir, fs::directory_options::skip_permission_denied, ec), end; !ec && it != end; it.increment(ec))
+			{
+				std::error_code e2;
+				const auto& p = it->path();
+				if (it->is_directory(e2))
+				{
+					const std::string n = _pathToUtf8(p.filename());
+					if (!n.empty() && n[0] != '.')
+						dirs.emplace_back(n, _pathToUtf8(p));
+				}
+				else
+				{
+					std::string ext = _pathToUtf8(p.extension());
+					for (auto& ch : ext) ch = (char)std::tolower((unsigned char)ch);
+					if (ext == ".wua" || ext == ".wud" || ext == ".wux" || ext == ".wup" || ext == ".rpx" || ext == ".wuhb")
+						games++;
+				}
+			}
+			std::sort(dirs.begin(), dirs.end(), [](auto& a, auto& b) { return boost::algorithm::ilexicographical_compare(a.first, b.first); });
+			for (auto& [n, p] : dirs)
+			{
+				j.w.StartObject();
+				j.KS("name", n);
+				j.KS("path", p);
+				j.w.EndObject();
+			}
+			j.w.EndArray();
+			j.KS("path", current);
+			j.KS("parent", parent);
+			j.KI("games", games);
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		HttpResponse Status()
+		{
+			g_lastPollMs = NowMs();
+			Json j;
+			j.w.StartObject();
+			const State s = g_cb.state ? g_cb.state() : State::Ui;
+			j.KS("state", s == State::Ui ? "ui" : s == State::Loading ? "loading" : "running");
+			j.KS("title", g_cb.currentTitle ? g_cb.currentTitle() : "");
+			j.KS("error", g_cb.lastError ? g_cb.lastError() : "");
+			j.KS("version", "NEBULATOR " + AppVersion());
+			j.KS("dataPath", _pathToUtf8(ActiveSettings::GetUserDataPath()));
+			j.KB("scanning", CafeTitleList::IsScanning());
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		HttpResponse Launch(const HttpRequest& req)
+		{
+			if (GetState() != State::Ui)
+				return Err(409, "a game is already running");
+			rapidjson::Document d;
+			if (!ParseBody(req, d))
+				return Err(400, "invalid json");
+			std::string path = GetStr(d, "path");
+			const std::string tid = GetStr(d, "titleId");
+			if (path.empty() && !tid.empty())
+			{
+				try
+				{
+					TitleId id = std::stoull(tid, nullptr, 16);
+					GameInfo2 gi = CafeTitleList::GetGameInfo(id);
+					if (gi.IsValid())
+						path = _pathToUtf8(gi.GetBase().GetPath());
+				}
+				catch (...) {}
+			}
+			if (path.empty())
+				return Err(400, "no game given");
+			std::string err;
+			if (!g_cb.launch || !g_cb.launch(path, GetBool(d, "fullscreen", false), err))
+				return Err(500, err.empty() ? "launch failed" : err);
+			return OkSimple();
+		}
+	} // namespace
+
+	bool LaunchTitle(const std::string& titleIdHex, std::string& err)
+	{
+		if (GetState() != State::Ui)
+		{
+			err = "a game is already running";
+			return false;
+		}
+		std::string path;
+		try
+		{
+			TitleId id = std::stoull(titleIdHex, nullptr, 16);
+			GameInfo2 gi = CafeTitleList::GetGameInfo(id);
+			if (gi.IsValid())
+				path = _pathToUtf8(gi.GetBase().GetPath());
+		}
+		catch (...) {}
+		if (path.empty())
+		{
+			err = "this game was not found on this PC";
+			return false;
+		}
+		return g_cb.launch && g_cb.launch(path, false, err);
+	}
+
+	// ====================================================================== helpers
+	std::string SanitizeUtf8(const std::string& s)
+	{
+		std::string out;
+		out.reserve(s.size());
+		for (size_t i = 0; i < s.size();)
+		{
+			const unsigned char c = (unsigned char)s[i];
+			size_t len = c < 0x80 ? 1 : (c >> 5) == 6 ? 2 : (c >> 4) == 14 ? 3 : (c >> 3) == 30 ? 4 : 0;
+			bool ok = len != 0 && i + len <= s.size();
+			for (size_t k = 1; ok && k < len; k++)
+				ok = ((unsigned char)s[i + k] & 0xC0) == 0x80;
+			if (ok && !(len == 1 && c < 0x20 && c != '\n' && c != '\t'))
+			{
+				out.append(s, i, len);
+				i += len;
+			}
+			else
+			{
+				out += '?';
+				i += ok ? len : 1;
+			}
+		}
+		return out;
+	}
+
+	HttpResponse Ok(Json& j)
+	{
+		HttpResponse r;
+		r.body.assign(j.sb.GetString(), j.sb.GetSize());
+		return r;
+	}
+	HttpResponse OkSimple()
+	{
+		HttpResponse r;
+		r.body = "{\"ok\":true}";
+		return r;
+	}
+	HttpResponse Err(int status, const std::string& msg)
+	{
+		Json j;
+		j.w.StartObject();
+		j.KS("error", msg);
+		j.w.EndObject();
+		HttpResponse r;
+		r.status = status;
+		r.body.assign(j.sb.GetString(), j.sb.GetSize());
+		return r;
+	}
+	bool ParseBody(const HttpRequest& req, rapidjson::Document& doc)
+	{
+		if (req.body.empty())
+		{
+			doc.SetObject();
+			return true;
+		}
+		doc.Parse(req.body.c_str(), req.body.size());
+		return !doc.HasParseError() && doc.IsObject();
+	}
+	bool Has(const rapidjson::Value& v, const char* key) { return v.IsObject() && v.HasMember(key); }
+	std::string GetStr(const rapidjson::Value& v, const char* key, const std::string& def)
+	{
+		if (Has(v, key) && v[key].IsString())
+			return std::string(v[key].GetString(), v[key].GetStringLength());
+		return def;
+	}
+	int64_t GetInt(const rapidjson::Value& v, const char* key, int64_t def)
+	{
+		if (Has(v, key))
+		{
+			if (v[key].IsInt64()) return v[key].GetInt64();
+			if (v[key].IsDouble()) return (int64_t)v[key].GetDouble();
+			if (v[key].IsBool()) return v[key].GetBool() ? 1 : 0;
+		}
+		return def;
+	}
+	bool GetBool(const rapidjson::Value& v, const char* key, bool def)
+	{
+		if (Has(v, key) && v[key].IsBool())
+			return v[key].GetBool();
+		return def;
+	}
+	std::string QueryParam(const HttpRequest& req, const std::string& key)
+	{
+		size_t pos = 0;
+		const std::string& q = req.query;
+		while (pos <= q.size())
+		{
+			size_t amp = q.find('&', pos);
+			if (amp == std::string::npos) amp = q.size();
+			std::string pair = q.substr(pos, amp - pos);
+			size_t eq = pair.find('=');
+			std::string k = pair.substr(0, eq);
+			if (k == key)
+			{
+				std::string raw = eq == std::string::npos ? "" : pair.substr(eq + 1);
+				std::string out;
+				for (size_t i = 0; i < raw.size(); i++)
+				{
+					if (raw[i] == '%' && i + 2 < raw.size() + 0 && std::isxdigit((unsigned char)raw[i + 1]) && std::isxdigit((unsigned char)raw[i + 2]))
+					{
+						out += (char)std::stoi(raw.substr(i + 1, 2), nullptr, 16);
+						i += 2;
+					}
+					else if (raw[i] == '+')
+						out += ' ';
+					else
+						out += raw[i];
+				}
+				return out;
+			}
+			pos = amp + 1;
+		}
+		return {};
+	}
+	std::string HexId(uint64 id) { return fmt::format("{:016x}", id); }
+
+	void Init(Callbacks cb, std::string token, fs::path uiDir)
+	{
+		g_cb = std::move(cb);
+		g_token = std::move(token);
+		g_uiDir = std::move(uiDir);
+	}
+	void RequestQuit(bool appQuit)
+	{
+		if (g_cb.quit)
+			g_cb.quit(appQuit);
+	}
+
+	int64_t MsSinceLastPoll()
+	{
+		const int64_t last = g_lastPollMs;
+		return last < 0 ? -1 : NowMs() - last;
+	}
+	State GetState() { return g_cb.state ? g_cb.state() : State::Ui; }
+	const std::string& GetToken() { return g_token; }
+	std::string CurrentTitle() { return g_cb.currentTitle ? g_cb.currentTitle() : ""; }
+
+	// ====================================================================== router
+	HttpResponse Handle(const HttpRequest& req)
+	{
+		if (req.path.rfind("/api/", 0) != 0)
+		{
+			if (req.method != "GET")
+				return Err(405, "method not allowed");
+			return ServeStatic(req.path);
+		}
+		auto tok = req.headers.find("x-nebulator-token");
+		std::string given = tok == req.headers.end() ? "" : tok->second;
+		// <img>/<audio> style streams can't send headers: they pass the token in the query string
+		if (given.empty() && (req.path == "/api/coop/stream" || req.path == "/api/coop/audio"))
+			given = QueryParam(req, "t");
+		if (given.empty() || g_token.empty() || given != g_token)
+			return Err(401, "bad token");
+		if (req.method != "GET" && req.method != "POST")
+			return Err(405, "method not allowed");
+
+		const std::string route = req.path.substr(5); // after /api/
+		const bool post = req.method == "POST";
+		if (route == "status")
+			return Status();
+		if (route == "library")
+			return Library();
+		if (route == "icon")
+			return Icon(req);
+		if (route == "library/rescan" && post)
+		{
+			CafeTitleList::ClearScanPaths();
+			for (auto& p : GetConfig().game_paths)
+				CafeTitleList::AddScanPath(_utf8ToPath(p));
+			CafeTitleList::Refresh();
+			return OkSimple();
+		}
+		if (route == "launch" && post)
+			return Launch(req);
+		if (route == "quit" && post)
+		{
+			rapidjson::Document d;
+			ParseBody(req, d);
+			if (g_cb.quit)
+				g_cb.quit(GetBool(d, "app", false));
+			return OkSimple();
+		}
+		if (route == "settings")
+		{
+			if (post)
+				return SetSettings(req);
+			Json j;
+			WriteSettings(j);
+			return Ok(j);
+		}
+		if (route == "audio")
+			return AudioInfo(req);
+		if (route == "fs")
+			return Browse(req);
+		if (route.rfind("input", 0) == 0)
+			return HandleInput(req, route.substr(5));
+		if (route.rfind("sky", 0) == 0)
+			return HandleSky(req, route.substr(3));
+		if (route.rfind("gfx", 0) == 0)
+			return HandleGfx(req, route.substr(3));
+		if (route.rfind("coop", 0) == 0)
+			return HandleCoop(req, route.substr(4));
+		if (route.rfind("update", 0) == 0)
+			return HandleUpdate(req, route.substr(6));
+		return Err(404, "unknown route");
+	}
+} // namespace ControlApi
diff --git a/src/gui/sdlgui/ControlApi.h b/src/gui/sdlgui/ControlApi.h
new file mode 100644
index 0000000..75a440c
--- /dev/null
+++ b/src/gui/sdlgui/ControlApi.h
@@ -0,0 +1,84 @@
+#pragma once
+// JSON API + static file server behind the NEBULATOR UI.
+
+#include "HttpServer.h"
+
+#include <rapidjson/document.h>
+#include <rapidjson/stringbuffer.h>
+#include <rapidjson/writer.h>
+#include <functional>
+#include <string>
+
+namespace ControlApi
+{
+	enum class State
+	{
+		Ui,
+		Loading,
+		Running
+	};
+
+	struct Callbacks
+	{
+		// returns false and fills err if the launch can't be started
+		std::function<bool(const std::string& path, bool fullscreen, std::string& err)> launch;
+		// appQuit=false: stop the running game and return to the UI; true: exit everything
+		std::function<void(bool appQuit)> quit;
+		std::function<State()> state;
+		std::function<std::string()> lastError;
+		std::function<std::string()> currentTitle;
+	};
+
+	void Init(Callbacks cb, std::string token, fs::path uiDir);
+	HttpResponse Handle(const HttpRequest& req);
+	int64_t MsSinceLastPoll(); // -1 if the UI never polled
+	State GetState();
+	const std::string& GetToken();
+
+	// ---- shared helpers ----
+	std::string SanitizeUtf8(const std::string& s);
+
+	struct Json
+	{
+		rapidjson::StringBuffer sb;
+		rapidjson::Writer<rapidjson::StringBuffer> w;
+		Json() : w(sb) {}
+		void K(const char* k) { w.Key(k); }
+		void S(const std::string& s)
+		{
+			const std::string c = SanitizeUtf8(s);
+			w.String(c.c_str(), (rapidjson::SizeType)c.size());
+		}
+		void KS(const char* k, const std::string& s) { K(k); S(s); }
+		void KB(const char* k, bool b) { K(k); w.Bool(b); }
+		void KI(const char* k, int64_t v) { K(k); w.Int64(v); }
+		void KD(const char* k, double v) { K(k); w.Double(v); }
+		void Null(const char* k) { K(k); w.Null(); }
+	};
+
+	HttpResponse Ok(Json& j);
+	HttpResponse OkSimple();
+	HttpResponse Err(int status, const std::string& msg);
+	bool ParseBody(const HttpRequest& req, rapidjson::Document& doc);
+	std::string GetStr(const rapidjson::Value& v, const char* key, const std::string& def = {});
+	int64_t GetInt(const rapidjson::Value& v, const char* key, int64_t def = 0);
+	bool GetBool(const rapidjson::Value& v, const char* key, bool def = false);
+	bool Has(const rapidjson::Value& v, const char* key);
+	std::string QueryParam(const HttpRequest& req, const std::string& key);
+	std::string HexId(uint64 id);
+
+	// sub modules (each returns a 404 response for unknown routes)
+	HttpResponse HandleInput(const HttpRequest& req, const std::string& sub);
+	HttpResponse HandleSky(const HttpRequest& req, const std::string& sub);
+	HttpResponse HandleGfx(const HttpRequest& req, const std::string& sub);
+	HttpResponse HandleUpdate(const HttpRequest& req, const std::string& sub);
+	HttpResponse HandleCoop(const HttpRequest& req, const std::string& sub);
+	HttpResponse HandleLock(const HttpRequest& req, const std::string& sub); // coop/lock/*
+	bool LaunchTitle(const std::string& titleIdHex, std::string& err);
+	std::string CurrentTitle();
+	std::string AppVersion(); // from version.txt next to the exe ("dev" when missing)
+	void RequestQuit(bool appQuit);
+	void SkyRestore(); // re-apply the saved portal slots
+	void InputSetUserProfile(); // called when the UI changed bindings of player 1
+	bool InputHasUserProfile();
+} // namespace ControlApi
diff --git a/src/gui/sdlgui/ControlCoop.cpp b/src/gui/sdlgui/ControlCoop.cpp
new file mode 100644
index 0000000..26986d0
--- /dev/null
+++ b/src/gui/sdlgui/ControlCoop.cpp
@@ -0,0 +1,1195 @@
+// LAN co-op. One person hosts (the game runs on their PC), friends on the same Wi-Fi press Join in their own
+// NEBULATOR and type the host's code. The host streams picture and sound to each guest; the guests' buttons arrive as
+// extra controllers (players 2-4) on the host, so the game just sees more people on the same console.
+//
+// Wire protocol (TCP 17800, little endian): [u8 type][u32 length][payload]
+//   1 HELLO   guest->host  "NEBCOOP1" u8 codeLen code u8 nameLen name
+//   2 WELCOME host->guest  u8 ok, u8 slot (1..3), u8 msgLen msg
+//   3 INPUT   guest->host  u32 buttons, i8 lx ly rx ry
+//   4 FRAME   host->guest  u16 w, u16 h, JPEG bytes
+//   5 AUDIO   host->guest  s16 stereo 48 kHz
+//   6 BYE     either
+//   7 PING / 8 PONG  either way, u64 echo
+// UDP 17801: a guest broadcasts "NEBCOOP?"; the host answers "NEBCOOP!" u16 tcpPort u8 nameLen name u8 titleLen title u8 freeSlots
+
+#include "ControlApi.h"
+#include "ControlCoop.h"
+#include "CoopRemote.h"
+#include "JpegEnc.h"
+
+#include "input/InputManager.h"
+#include "input/emulated/ProController.h"
+
+#include <boost/asio.hpp>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <random>
+#include <thread>
+
+#ifdef _WIN32
+#include <winsock2.h>
+#else
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <netinet/tcp.h>
+#endif
+
+namespace asio = boost::asio;
+using asio::ip::tcp;
+using asio::ip::udp;
+
+namespace
+{
+	constexpr uint16_t kTcpPort = 17800;
+	constexpr uint16_t kUdpPort = 17801;
+	constexpr int kMaxGuests = 3;
+
+	enum Msg : uint8_t { kHello = 1, kWelcome = 2, kInput = 3, kFrame = 4, kAudio = 5, kBye = 6, kPing = 7, kPong = 8 };
+
+	int64_t NowMs()
+	{
+		return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+	}
+	uint64_t NowUs()
+	{
+		return std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+	}
+
+	void SetRecvTimeout(tcp::socket& s, int ms)
+	{
+#ifdef _WIN32
+		DWORD v = (DWORD)ms;
+		setsockopt(s.native_handle(), SOL_SOCKET, SO_RCVTIMEO, (const char*)&v, sizeof(v));
+#else
+		timeval tv{ms / 1000, (ms % 1000) * 1000};
+		setsockopt(s.native_handle(), SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+#endif
+	}
+
+	void Tune(tcp::socket& s)
+	{
+		boost::system::error_code ec;
+		s.set_option(tcp::no_delay(true), ec);
+	}
+
+	void PutU32(std::string& o, uint32_t v) { for (int i = 0; i < 4; i++) o.push_back((char)(v >> (8 * i))); }
+	void PutU16(std::string& o, uint32_t v) { o.push_back((char)v); o.push_back((char)(v >> 8)); }
+	uint32_t GetU32(const char* p) { uint32_t v = 0; for (int i = 0; i < 4; i++) v |= (uint32_t)(uint8_t)p[i] << (8 * i); return v; }
+	uint64_t GetU64(const char* p) { uint64_t v = 0; for (int i = 0; i < 8; i++) v |= (uint64_t)(uint8_t)p[i] << (8 * i); return v; }
+	void PutU64(std::string& o, uint64_t v) { for (int i = 0; i < 8; i++) o.push_back((char)(v >> (8 * i))); }
+
+	bool SendMsg(tcp::socket& s, uint8_t type, const void* data, uint32_t len)
+	{
+		uint8_t hdr[5] = {type, (uint8_t)len, (uint8_t)(len >> 8), (uint8_t)(len >> 16), (uint8_t)(len >> 24)};
+		std::array<asio::const_buffer, 2> bufs = {asio::buffer(hdr, 5), asio::buffer(data, len)};
+		boost::system::error_code ec;
+		asio::write(s, bufs, ec);
+		return !ec;
+	}
+	bool SendMsg(tcp::socket& s, uint8_t type, const std::string& p) { return SendMsg(s, type, p.data(), (uint32_t)p.size()); }
+
+	bool RecvMsg(tcp::socket& s, uint8_t& type, std::string& payload, uint32_t maxLen)
+	{
+		uint8_t hdr[5];
+		boost::system::error_code ec;
+		asio::read(s, asio::buffer(hdr, 5), ec);
+		if (ec)
+			return false;
+		type = hdr[0];
+		const uint32_t len = GetU32((const char*)hdr + 1);
+		if (len > maxLen)
+			return false;
+		payload.resize(len);
+		if (len)
+			asio::read(s, asio::buffer(payload.data(), len), ec);
+		return !ec;
+	}
+
+	std::string LocalIp()
+	{
+		try
+		{
+			asio::io_context io;
+			udp::socket s(io);
+			s.connect(udp::endpoint(asio::ip::make_address("192.0.2.1"), 9)); // no packet is sent
+			return s.local_endpoint().address().to_string();
+		}
+		catch (...)
+		{
+			return "";
+		}
+	}
+
+	std::string MakeCode()
+	{
+		static const char alpha[] = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"; // no 0/O/1/I
+		std::random_device rd;
+		std::string c;
+		for (int i = 0; i < 5; i++)
+			c.push_back(alpha[rd() % (sizeof(alpha) - 1)]);
+		return c;
+	}
+
+	std::string NormCode(std::string c)
+	{
+		std::string o;
+		for (char ch : c)
+			if (ch != ' ' && ch != '-')
+				o.push_back((char)std::toupper((unsigned char)ch));
+		return o;
+	}
+
+	bool SameCode(const std::string& a, const std::string& b)
+	{
+		if (a.size() != b.size())
+			return false;
+		unsigned d = 0;
+		for (size_t i = 0; i < a.size(); i++)
+			d |= (unsigned)(a[i] ^ b[i]);
+		return d == 0;
+	}
+
+	// ====================================================================== host
+	struct GuestConn
+	{
+		tcp::socket sock;
+		int slot = 0;
+		std::string name;
+		std::shared_ptr<CoopRemote> pad;
+		std::atomic_bool alive{true};
+		std::atomic<int> pingMs{-1};
+		std::mutex wm; // serialises writes
+		std::mutex m;
+		std::condition_variable cv;
+		std::string frame;
+		bool frameNew = false;
+		std::deque<std::string> audio;
+		explicit GuestConn(tcp::socket s) : sock(std::move(s)) {}
+		void Close()
+		{
+			alive = false;
+			boost::system::error_code ec;
+			sock.shutdown(tcp::socket::shutdown_both, ec);
+			sock.close(ec);
+			cv.notify_all();
+		}
+	};
+
+	struct HostState
+	{
+		std::mutex m;
+		std::atomic_bool running{false};
+		std::string code, name;
+		std::atomic<int> quality{60}, fps{30}, maxWidth{640};
+		std::vector<std::shared_ptr<GuestConn>> guests;
+		std::unique_ptr<asio::io_context> io;
+		std::unique_ptr<tcp::acceptor> acc;
+		std::unique_ptr<udp::socket> disc;
+		std::thread ioThread, encThread, testThread;
+		// encoder hand-off (latest wins)
+		std::mutex em;
+		std::condition_variable ecv;
+		std::vector<uint8_t> pend;
+		int pw = 0, ph = 0;
+		bool pendNew = false;
+		int64_t lastEnc = 0;
+		std::atomic<int64_t> lastWant{0};
+		std::atomic<int> wrongTries{0};
+		std::atomic_bool test{false};
+	} H;
+
+	std::atomic<int> g_guestCount{0};
+
+	void DetachPad(GuestConn& g)
+	{
+		if (!g.pad)
+			return;
+		auto& im = InputManager::instance();
+		if (auto emu = im.get_controller((size_t)g.slot))
+			emu->remove_controller(g.pad);
+		// put back whatever the host had saved for that player
+		if (!im.load((size_t)g.slot))
+			im.delete_controller((size_t)g.slot, false);
+		g.pad.reset();
+	}
+
+	void AttachPad(GuestConn& g)
+	{
+		auto& im = InputManager::instance();
+		auto emu = im.set_controller((size_t)g.slot, EmulatedController::Type::Pro);
+		if (!emu)
+			return;
+		emu->clear_controllers();
+		emu->clear_mappings();
+		g.pad = std::make_shared<CoopRemote>("coop-" + std::to_string(g.slot), "Guest " + g.name);
+		emu->add_controller(g.pad);
+		CoopRemote::ApplyMapping(emu, g.pad);
+	}
+
+	void DropGuest(const std::shared_ptr<GuestConn>& g)
+	{
+		g->Close();
+		std::scoped_lock l(H.m);
+		auto it = std::find(H.guests.begin(), H.guests.end(), g);
+		if (it != H.guests.end())
+		{
+			DetachPad(**it);
+			H.guests.erase(it);
+			g_guestCount = (int)H.guests.size();
+		}
+	}
+
+	void GuestWriter(std::shared_ptr<GuestConn> g)
+	{
+		int64_t nextPing = NowMs();
+		while (g->alive && H.running)
+		{
+			std::string frame;
+			std::deque<std::string> audio;
+			{
+				std::unique_lock l(g->m);
+				g->cv.wait_for(l, std::chrono::milliseconds(250), [&] { return g->frameNew || !g->audio.empty() || !g->alive; });
+				if (!g->alive)
+					break;
+				if (g->frameNew)
+				{
+					frame.swap(g->frame);
+					g->frameNew = false;
+				}
+				audio.swap(g->audio);
+			}
+			std::scoped_lock wl(g->wm);
+			for (auto& a : audio)
+				if (!SendMsg(g->sock, kAudio, a))
+				{
+					g->alive = false;
+					break;
+				}
+			if (!frame.empty() && g->alive && !SendMsg(g->sock, kFrame, frame))
+				g->alive = false;
+			if (NowMs() >= nextPing)
+			{
+				std::string p;
+				PutU64(p, NowUs());
+				SendMsg(g->sock, kPing, p);
+				nextPing = NowMs() + 1000;
+			}
+		}
+		g->alive = false;
+	}
+
+	void GuestReader(std::shared_ptr<GuestConn> g)
+	{
+		SetRecvTimeout(g->sock, 8000); // we ping every second, so silence means the guest is gone
+		std::thread(GuestWriter, g).detach();
+		uint8_t type;
+		std::string p;
+		while (g->alive && H.running && RecvMsg(g->sock, type, p, 1024))
+		{
+			if (type == kInput && p.size() >= 8 && g->pad)
+			{
+				g->pad->Set(GetU32(p.data()), (int8_t)p[4], (int8_t)p[5], (int8_t)p[6], (int8_t)p[7]);
+			}
+			else if (type == kPing && p.size() == 8)
+			{
+				std::scoped_lock wl(g->wm);
+				SendMsg(g->sock, kPong, p);
+			}
+			else if (type == kPong && p.size() == 8)
+			{
+				const uint64_t t = GetU64(p.data());
+				g->pingMs = (int)((NowUs() - t) / 1000);
+			}
+			else if (type == kBye)
+				break;
+		}
+		DropGuest(g);
+	}
+
+	void Handshake(tcp::socket sock)
+	{
+		Tune(sock);
+		SetRecvTimeout(sock, 4000);
+		uint8_t type;
+		std::string p;
+		auto reject = [&](const std::string& why) {
+			std::string w;
+			w.push_back(0);
+			w.push_back(0);
+			w.push_back((char)why.size());
+			w += why;
+			SendMsg(sock, kWelcome, w);
+			boost::system::error_code ec;
+			sock.close(ec);
+		};
+		if (!RecvMsg(sock, type, p, 256) || type != kHello || p.size() < 10 || p.compare(0, 8, "NEBCOOP1") != 0)
+		{
+			boost::system::error_code ec;
+			sock.close(ec);
+			return;
+		}
+		size_t i = 8;
+		const size_t cl = (uint8_t)p[i++];
+		if (i + cl >= p.size())
+			return reject("bad hello");
+		const std::string code = NormCode(p.substr(i, cl));
+		i += cl;
+		const size_t nl = (uint8_t)p[i++];
+		std::string name = i + nl <= p.size() ? p.substr(i, nl) : "Guest";
+		if (name.empty())
+			name = "Guest";
+		if (name.size() > 24)
+			name.resize(24);
+
+		if (H.wrongTries >= 8)
+			return reject("too many wrong codes, ask the host to restart hosting");
+		std::string hostCode;
+		{
+			std::scoped_lock l(H.m);
+			hostCode = H.code;
+		}
+		if (!H.running || !SameCode(code, hostCode))
+		{
+			H.wrongTries++;
+			return reject("wrong code");
+		}
+		auto g = std::make_shared<GuestConn>(std::move(sock));
+		g->name = name;
+		{
+			std::scoped_lock l(H.m);
+			bool used[kMaxGuests + 1] = {};
+			for (auto& o : H.guests)
+				used[o->slot] = true;
+			for (int s = 1; s <= kMaxGuests; s++)
+				if (!used[s])
+				{
+					g->slot = s;
+					break;
+				}
+			if (g->slot == 0)
+			{
+				std::string w;
+				w.push_back(0); w.push_back(0);
+				const std::string why = "the game is full";
+				w.push_back((char)why.size());
+				w += why;
+				SendMsg(g->sock, kWelcome, w);
+				return;
+			}
+			AttachPad(*g);
+			H.guests.push_back(g);
+			g_guestCount = (int)H.guests.size();
+		}
+		H.wrongTries = 0;
+		std::string w;
+		w.push_back(1);
+		w.push_back((char)g->slot);
+		w.push_back(0);
+		{
+			std::scoped_lock wl(g->wm);
+			if (!SendMsg(g->sock, kWelcome, w))
+			{
+				DropGuest(g);
+				return;
+			}
+		}
+		GuestReader(g);
+	}
+
+	struct AcceptCtx
+	{
+		tcp::socket sock;
+		explicit AcceptCtx(asio::io_context& io) : sock(io) {}
+	};
+
+	// listening is async on one io thread, so Stop can always wake it (closing a socket another thread is blocked on
+	// in accept()/recv() does not wake it on every OS)
+	void DoAccept()
+	{
+		auto ctx = std::make_shared<AcceptCtx>(*H.io);
+		H.acc->async_accept(ctx->sock, [ctx](const boost::system::error_code& ec) {
+			if (ec || !H.running)
+				return;
+			std::thread([sk = std::move(ctx->sock)]() mutable { Handshake(std::move(sk)); }).detach();
+			DoAccept();
+		});
+	}
+
+	struct DiscBuf
+	{
+		char data[64];
+		udp::endpoint from;
+	};
+	std::shared_ptr<DiscBuf> g_discBuf;
+
+	void DoDiscovery()
+	{
+		g_discBuf = std::make_shared<DiscBuf>();
+		auto db = g_discBuf;
+		H.disc->async_receive_from(asio::buffer(db->data), db->from, [db](const boost::system::error_code& ec, size_t n) {
+			if (ec || !H.running)
+				return;
+			if (n >= 8 && std::memcmp(db->data, "NEBCOOP?", 8) == 0)
+			{
+				std::string r = "NEBCOOP!";
+				PutU16(r, kTcpPort);
+				std::string name, title;
+				int freeSlots;
+				{
+					std::scoped_lock l(H.m);
+					name = H.name;
+					freeSlots = kMaxGuests - (int)H.guests.size();
+				}
+				title = ControlApi::CurrentTitle();
+				if (name.size() > 40) name.resize(40);
+				if (title.size() > 60) title.resize(60);
+				r.push_back((char)name.size()); r += name;
+				r.push_back((char)title.size()); r += title;
+				r.push_back((char)freeSlots);
+				boost::system::error_code e2;
+				H.disc->send_to(asio::buffer(r), db->from, 0, e2);
+			}
+			DoDiscovery();
+		});
+	}
+
+	void IoLoop()
+	{
+		DoAccept();
+		DoDiscovery();
+		H.io->run();
+	}
+
+	void EncodeLoop()
+	{
+		std::vector<uint8_t> local;
+		while (H.running)
+		{
+			int w, h;
+			{
+				std::unique_lock l(H.em);
+				H.ecv.wait_for(l, std::chrono::milliseconds(200), [] { return H.pendNew || !H.running; });
+				if (!H.running)
+					break;
+				if (!H.pendNew)
+					continue;
+				local.swap(H.pend);
+				w = H.pw;
+				h = H.ph;
+				H.pendNew = false;
+			}
+			std::string jpg = JpegEnc::Encode(local.data(), w, h, H.quality);
+			if (jpg.empty())
+				continue;
+			std::string payload;
+			PutU16(payload, (uint32_t)w);
+			PutU16(payload, (uint32_t)h);
+			payload += jpg;
+			std::scoped_lock l(H.m);
+			for (auto& g : H.guests)
+			{
+				std::scoped_lock gl(g->m);
+				g->frame = payload;
+				g->frameNew = true;
+				g->cv.notify_one();
+			}
+		}
+	}
+
+	// Linux test source: a moving pattern so the pipeline can be checked without a game
+	void TestLoop()
+	{
+		std::vector<uint8_t> px;
+		int t = 0;
+		while (H.running && H.test)
+		{
+			if (Coop::WantFrame())
+			{
+				const int w = std::min(H.maxWidth.load(), 1280) & ~1, h = (w * 9 / 16) & ~1;
+				px.resize((size_t)w * h * 3);
+				for (int y = 0; y < h; y++)
+					for (int x = 0; x < w; x++)
+					{
+						uint8_t* p = &px[((size_t)y * w + x) * 3];
+						const bool bar = (x > (t * 6) % w && x < (t * 6) % w + 24);
+						p[0] = bar ? 255 : (uint8_t)(x * 255 / w);
+						p[1] = bar ? 255 : (uint8_t)(y * 255 / h);
+						p[2] = bar ? 255 : (uint8_t)((t * 3) & 255);
+					}
+				Coop::SubmitFrame(px.data(), w, h);
+				t++;
+			}
+			std::this_thread::sleep_for(std::chrono::milliseconds(1000 / std::max(1, H.fps.load())));
+		}
+	}
+
+	void StopHost()
+	{
+		if (!H.running.exchange(false))
+			return;
+		std::vector<std::shared_ptr<GuestConn>> gs;
+		{
+			std::scoped_lock l(H.m);
+			gs = H.guests;
+		}
+		for (auto& g : gs)
+		{
+			{
+				std::scoped_lock wl(g->wm);
+				SendMsg(g->sock, kBye, nullptr, 0);
+			}
+			DropGuest(g);
+		}
+		boost::system::error_code ec;
+		if (H.acc) H.acc->close(ec);
+		if (H.disc) H.disc->close(ec);
+		if (H.io) H.io->stop();
+		H.ecv.notify_all();
+		if (H.ioThread.joinable()) H.ioThread.join();
+		if (H.encThread.joinable()) H.encThread.join();
+		if (H.testThread.joinable()) H.testThread.join();
+		H.acc.reset();
+		H.disc.reset();
+		H.io.reset();
+		g_guestCount = 0;
+	}
+
+	std::string StartHost(const std::string& name, std::string& err)
+	{
+		if (H.running)
+			return H.code;
+		try
+		{
+			H.io = std::make_unique<asio::io_context>();
+			H.acc = std::make_unique<tcp::acceptor>(*H.io);
+			tcp::endpoint ep(asio::ip::make_address("0.0.0.0"), kTcpPort);
+			H.acc->open(ep.protocol());
+			H.acc->set_option(tcp::acceptor::reuse_address(true));
+			H.acc->bind(ep);
+			H.acc->listen();
+			H.disc = std::make_unique<udp::socket>(*H.io);
+			udp::endpoint uep(asio::ip::make_address("0.0.0.0"), kUdpPort);
+			H.disc->open(uep.protocol());
+			H.disc->set_option(udp::socket::reuse_address(true));
+			H.disc->bind(uep);
+		}
+		catch (const std::exception& ex)
+		{
+			err = std::string("couldn't open the co-op port (") + ex.what() + "). Is another NEBULATOR already hosting?";
+			H.acc.reset();
+			H.disc.reset();
+			H.io.reset();
+			return "";
+		}
+		{
+			std::scoped_lock l(H.m);
+			H.code = MakeCode();
+			H.name = name.empty() ? "NEBULATOR host" : name;
+			H.guests.clear();
+		}
+		H.wrongTries = 0;
+		H.running = true;
+		H.test = std::getenv("NEBULATOR_COOP_TEST") != nullptr;
+		H.ioThread = std::thread(IoLoop);
+		H.encThread = std::thread(EncodeLoop);
+		if (H.test)
+			H.testThread = std::thread(TestLoop);
+		return H.code;
+	}
+
+	// ====================================================================== guest
+	struct ClientState
+	{
+		std::mutex m;
+		std::condition_variable cv;
+		std::atomic_bool active{false};
+		std::string state = "idle"; // idle, connecting, connected, error
+		std::string message, host;
+		int slot = 0;
+		std::unique_ptr<asio::io_context> io;
+		std::shared_ptr<tcp::socket> sock;
+		std::mutex wm;
+		std::thread reader, pinger;
+		std::string frame; // newest JPEG
+		uint64_t frameSeq = 0;
+		int fw = 0, fh = 0;
+		std::deque<std::string> audio;
+		uint64_t audioSeq = 0;
+		std::atomic<int> pingMs{-1};
+		std::atomic<int> fps{0};
+		int fpsCount = 0;
+		int64_t fpsT = 0;
+		uint32_t lastButtons = 0xFFFFFFFF;
+		uint32_t lastAxes = 0;
+	} C;
+
+	void ClientSet(const std::string& state, const std::string& msg)
+	{
+		std::scoped_lock l(C.m);
+		C.state = state;
+		C.message = msg;
+		C.cv.notify_all();
+	}
+
+	void ClientReader(std::shared_ptr<tcp::socket> sock)
+	{
+		uint8_t type;
+		std::string p;
+		SetRecvTimeout(*sock, 8000);
+		while (C.active && RecvMsg(*sock, type, p, 8u << 20))
+		{
+			if (type == kFrame && p.size() > 4)
+			{
+				std::scoped_lock l(C.m);
+				C.fw = (uint8_t)p[0] | ((uint8_t)p[1] << 8);
+				C.fh = (uint8_t)p[2] | ((uint8_t)p[3] << 8);
+				C.frame.assign(p.data() + 4, p.size() - 4);
+				C.frameSeq++;
+				const int64_t now = NowMs();
+				C.fpsCount++;
+				if (now - C.fpsT >= 1000)
+				{
+					C.fps = C.fpsCount;
+					C.fpsCount = 0;
+					C.fpsT = now;
+				}
+				C.cv.notify_all();
+			}
+			else if (type == kAudio)
+			{
+				std::scoped_lock l(C.m);
+				C.audio.push_back(std::move(p));
+				while (C.audio.size() > 8) // never build a backlog: old sound is worse than a gap
+					C.audio.pop_front();
+				C.audioSeq++;
+				C.cv.notify_all();
+			}
+			else if (type == kPing && p.size() == 8)
+			{
+				std::scoped_lock wl(C.wm);
+				SendMsg(*sock, kPong, p);
+			}
+			else if (type == kPong && p.size() == 8)
+				C.pingMs = (int)((NowUs() - GetU64(p.data())) / 1000);
+			else if (type == kBye)
+			{
+				ClientSet("error", "The host ended the session");
+				break;
+			}
+		}
+		if (C.active)
+		{
+			std::scoped_lock l(C.m);
+			if (C.state == "connected")
+			{
+				C.state = "error";
+				C.message = "Lost the connection to the host";
+			}
+		}
+		C.active = false;
+		boost::system::error_code ec;
+		sock->close(ec);
+		C.cv.notify_all();
+	}
+
+	void LeaveClient(bool say = true)
+	{
+		const bool was = C.active.exchange(false);
+		std::shared_ptr<tcp::socket> s;
+		{
+			std::scoped_lock l(C.m);
+			s = C.sock;
+		}
+		if (s && was && say)
+		{
+			std::scoped_lock wl(C.wm);
+			SendMsg(*s, kBye, nullptr, 0);
+		}
+		if (s)
+		{
+			boost::system::error_code ec;
+			s->shutdown(tcp::socket::shutdown_both, ec);
+			s->close(ec);
+		}
+		C.cv.notify_all();
+		if (C.reader.joinable()) C.reader.join();
+		if (C.pinger.joinable()) C.pinger.join();
+		std::scoped_lock l(C.m);
+		C.sock.reset();
+		C.io.reset();
+		C.frame.clear();
+		C.audio.clear();
+		C.state = "idle";
+		C.message.clear();
+		C.slot = 0;
+		C.pingMs = -1;
+		C.fps = 0;
+		C.lastButtons = 0xFFFFFFFF;
+	}
+
+	bool JoinClient(const std::string& host, const std::string& code, const std::string& name, std::string& err)
+	{
+		LeaveClient(false);
+		try
+		{
+			C.io = std::make_unique<asio::io_context>();
+			auto sock = std::make_shared<tcp::socket>(*C.io);
+			boost::system::error_code ec;
+			tcp::endpoint ep(asio::ip::make_address(host, ec), kTcpPort);
+			if (ec)
+			{
+				err = "that isn't a valid address";
+				return false;
+			}
+			ClientSet("connecting", "Connecting...");
+			// connect with a timeout: non-blocking connect + wait
+			sock->open(ep.protocol());
+			sock->non_blocking(true);
+			sock->connect(ep, ec);
+			if (ec && ec != asio::error::in_progress && ec != asio::error::would_block)
+			{
+				err = "couldn't reach the host";
+				ClientSet("idle", "");
+				return false;
+			}
+			sock->non_blocking(false);
+			if (ec)
+			{
+				// in progress: wait for writability up to 4s
+				fd_set wf;
+				FD_ZERO(&wf);
+				FD_SET((unsigned)sock->native_handle(), &wf);
+				timeval tv{4, 0};
+				if (select((int)sock->native_handle() + 1, nullptr, &wf, nullptr, &tv) <= 0)
+				{
+					err = "couldn't reach the host (is it on the same Wi-Fi, and is hosting turned on?)";
+					ClientSet("idle", "");
+					return false;
+				}
+				boost::system::error_code e2;
+				sock->remote_endpoint(e2);
+				if (e2)
+				{
+					err = "couldn't reach the host";
+					ClientSet("idle", "");
+					return false;
+				}
+			}
+			Tune(*sock);
+			SetRecvTimeout(*sock, 5000);
+			std::string hello = "NEBCOOP1";
+			const std::string c = NormCode(code);
+			hello.push_back((char)c.size());
+			hello += c;
+			std::string nm = name.empty() ? "Guest" : name.substr(0, 24);
+			hello.push_back((char)nm.size());
+			hello += nm;
+			uint8_t type;
+			std::string p;
+			if (!SendMsg(*sock, kHello, hello) || !RecvMsg(*sock, type, p, 256) || type != kWelcome || p.size() < 3)
+			{
+				err = "the host didn't answer";
+				ClientSet("idle", "");
+				return false;
+			}
+			if (!p[0])
+			{
+				err = p.substr(3, (uint8_t)p[2]);
+				ClientSet("idle", "");
+				return false;
+			}
+			{
+				std::scoped_lock l(C.m);
+				C.sock = sock;
+				C.slot = (uint8_t)p[1];
+				C.host = host;
+				C.state = "connected";
+				C.message.clear();
+				C.frame.clear();
+				C.frameSeq = 0;
+				C.fpsT = NowMs();
+				C.fpsCount = 0;
+			}
+			C.active = true;
+			C.reader = std::thread(ClientReader, sock);
+			C.pinger = std::thread([sock] {
+				int64_t next = NowMs();
+				while (C.active)
+				{
+					if (NowMs() >= next)
+					{
+						std::string q;
+						PutU64(q, NowUs());
+						std::scoped_lock wl(C.wm);
+						SendMsg(*sock, kPing, q);
+						next = NowMs() + 1000;
+					}
+					std::this_thread::sleep_for(std::chrono::milliseconds(50));
+				}
+			});
+			return true;
+		}
+		catch (const std::exception& ex)
+		{
+			err = std::string("couldn't connect: ") + ex.what();
+			ClientSet("idle", "");
+			return false;
+		}
+	}
+
+	struct Found
+	{
+		std::string ip, name, title;
+		int freeSlots;
+	};
+
+	std::vector<Found> Discover()
+	{
+		std::vector<Found> out;
+		try
+		{
+			asio::io_context io;
+			udp::socket s(io);
+			s.open(udp::v4());
+			s.set_option(asio::socket_base::broadcast(true));
+			s.bind(udp::endpoint(udp::v4(), 0));
+			const char q[] = "NEBCOOP?";
+			boost::system::error_code ec;
+			s.send_to(asio::buffer(q, 8), udp::endpoint(asio::ip::make_address_v4("255.255.255.255"), kUdpPort), 0, ec);
+			if (std::getenv("NEBULATOR_COOP_TEST")) // lets two cores on one PC find each other in tests
+				s.send_to(asio::buffer(q, 8), udp::endpoint(asio::ip::make_address_v4("127.0.0.1"), kUdpPort), 0, ec);
+			s.non_blocking(true);
+			const int64_t end = NowMs() + 700;
+			char buf[256];
+			while (NowMs() < end)
+			{
+				udp::endpoint from;
+				const size_t n = s.receive_from(asio::buffer(buf), from, 0, ec);
+				if (ec)
+				{
+					std::this_thread::sleep_for(std::chrono::milliseconds(15));
+					continue;
+				}
+				if (n < 8 + 2 + 3 || std::memcmp(buf, "NEBCOOP!", 8) != 0)
+					continue;
+				size_t i = 10;
+				Found f;
+				f.ip = from.address().to_string();
+				const size_t nl = (uint8_t)buf[i++];
+				if (i + nl + 2 > n) continue;
+				f.name.assign(buf + i, nl);
+				i += nl;
+				const size_t tl = (uint8_t)buf[i++];
+				if (i + tl + 1 > n) continue;
+				f.title.assign(buf + i, tl);
+				i += tl;
+				f.freeSlots = (uint8_t)buf[i];
+				bool dup = false;
+				for (auto& o : out)
+					dup |= o.ip == f.ip;
+				if (!dup)
+					out.push_back(f);
+			}
+		}
+		catch (...)
+		{
+		}
+		return out;
+	}
+} // namespace
+
+// ============================================================================ public hooks
+namespace Coop
+{
+	bool WantFrame()
+	{
+		if (!H.running || g_guestCount.load() == 0)
+			return false;
+		// rate limit by the configured fps
+		const int64_t now = NowMs();
+		const int64_t gap = 1000 / std::max(1, H.fps.load());
+		return now - H.lastWant.load() >= gap;
+	}
+
+	bool HasGuests() { return H.running && g_guestCount.load() > 0; }
+
+	int MaxWidth() { return H.maxWidth; }
+
+	void SubmitFrame(const uint8_t* rgb, int w, int h)
+	{
+		if (!H.running || w <= 0 || h <= 0)
+			return;
+		H.lastWant = NowMs();
+		std::scoped_lock l(H.em);
+		H.pend.assign(rgb, rgb + (size_t)w * h * 3);
+		H.pw = w;
+		H.ph = h;
+		H.pendNew = true;
+		H.ecv.notify_one();
+	}
+
+	void SubmitAudio(const int16_t* stereo, int frames)
+	{
+		if (!H.running || g_guestCount.load() == 0 || frames <= 0)
+			return;
+		const std::string chunk((const char*)stereo, (size_t)frames * 4);
+		std::scoped_lock l(H.m);
+		for (auto& g : H.guests)
+		{
+			std::scoped_lock gl(g->m);
+			g->audio.push_back(chunk);
+			while (g->audio.size() > 6) // cap the backlog (~60 ms at 10 ms chunks)
+				g->audio.pop_front();
+			g->cv.notify_one();
+		}
+	}
+} // namespace Coop
+
+// ============================================================================ API
+namespace ControlApi
+{
+	namespace
+	{
+		HttpResponse Status()
+		{
+			Json j;
+			j.w.StartObject();
+			const bool hosting = H.running;
+			const bool joined = C.active || C.state == "connecting" || C.state == "error";
+			j.KS("role", hosting ? "host" : (joined ? "guest" : "none"));
+			j.KS("ip", LocalIp());
+			j.K("host");
+			j.w.StartObject();
+			j.KB("running", hosting);
+			if (hosting)
+			{
+				std::scoped_lock l(H.m);
+				j.KS("code", H.code);
+				j.KS("name", H.name);
+				j.KI("quality", H.quality);
+				j.KI("fps", H.fps);
+				j.KI("maxWidth", H.maxWidth);
+				j.KB("test", H.test);
+				j.K("guests");
+				j.w.StartArray();
+				for (auto& g : H.guests)
+				{
+					j.w.StartObject();
+					j.KI("slot", g->slot);
+					j.KS("name", g->name);
+					j.KI("pingMs", g->pingMs);
+					j.w.EndObject();
+				}
+				j.w.EndArray();
+			}
+			j.w.EndObject();
+			j.K("guest");
+			j.w.StartObject();
+			{
+				std::scoped_lock l(C.m);
+				j.KS("state", C.state);
+				j.KS("message", C.message);
+				j.KS("host", C.host);
+				j.KI("slot", C.slot);
+				j.KI("pingMs", C.pingMs);
+				j.KI("fps", C.fps);
+				j.KI("w", C.fw);
+				j.KI("h", C.fh);
+				j.KI("frames", (int64_t)C.frameSeq);
+			}
+			j.w.EndObject();
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		HttpResponse StreamFrames()
+		{
+			HttpResponse r;
+			r.contentType = "multipart/x-mixed-replace; boundary=nebframe";
+			r.stream = [](const std::function<bool(const std::string&)>& write) {
+				uint64_t seen = 0;
+				while (C.active)
+				{
+					std::string f;
+					{
+						std::unique_lock l(C.m);
+						C.cv.wait_for(l, std::chrono::milliseconds(500), [&] { return C.frameSeq != seen || !C.active; });
+						if (!C.active)
+							break;
+						if (C.frameSeq == seen)
+							continue;
+						seen = C.frameSeq;
+						f = C.frame;
+					}
+					std::string part = "--nebframe\r\nContent-Type: image/jpeg\r\nContent-Length: " + std::to_string(f.size()) + "\r\n\r\n";
+					part += f;
+					part += "\r\n";
+					if (!write(part))
+						break;
+				}
+			};
+			return r;
+		}
+
+		HttpResponse StreamAudio()
+		{
+			HttpResponse r;
+			r.contentType = "application/octet-stream";
+			r.stream = [](const std::function<bool(const std::string&)>& write) {
+				uint64_t seen;
+				{
+					std::scoped_lock l(C.m);
+					seen = C.audioSeq;
+				}
+				while (C.active)
+				{
+					std::deque<std::string> take;
+					{
+						std::unique_lock l(C.m);
+						C.cv.wait_for(l, std::chrono::milliseconds(500), [&] { return C.audioSeq != seen || !C.active; });
+						if (!C.active)
+							break;
+						if (C.audioSeq == seen)
+							continue;
+						seen = C.audioSeq;
+						take.swap(C.audio);
+					}
+					std::string out;
+					for (auto& t : take)
+						out += t;
+					if (!write(out))
+						break;
+				}
+			};
+			return r;
+		}
+	} // namespace
+
+	HttpResponse HandleCoop(const HttpRequest& req, const std::string& sub)
+	{
+		const bool post = req.method == "POST";
+		if (sub.rfind("/lock", 0) == 0)
+			return HandleLock(req, sub.substr(5));
+		if (sub.empty() || sub == "/status")
+			return Status();
+		if (sub == "/stream")
+			return C.active ? StreamFrames() : Err(409, "not in a session");
+		if (sub == "/audio")
+			return C.active ? StreamAudio() : Err(409, "not in a session");
+		if (sub == "/discover")
+		{
+			auto list = Discover();
+			Json j;
+			j.w.StartObject();
+			j.K("hosts");
+			j.w.StartArray();
+			for (auto& f : list)
+			{
+				j.w.StartObject();
+				j.KS("ip", f.ip);
+				j.KS("name", f.name);
+				j.KS("title", f.title);
+				j.KI("freeSlots", f.freeSlots);
+				j.w.EndObject();
+			}
+			j.w.EndArray();
+			j.w.EndObject();
+			return Ok(j);
+		}
+		if (!post)
+			return Err(405, "method not allowed");
+		rapidjson::Document d;
+		if (!ParseBody(req, d))
+			return Err(400, "invalid json");
+		if (sub == "/host/start")
+		{
+			if (C.active)
+				return Err(409, "leave the session you joined first");
+			std::string err;
+			if (StartHost(GetStr(d, "name"), err).empty())
+				return Err(500, err);
+			return Status();
+		}
+		if (sub == "/host/stop")
+		{
+			StopHost();
+			return Status();
+		}
+		if (sub == "/host/settings")
+		{
+			if (Has(d, "quality"))
+				H.quality = (int)std::clamp<int64_t>(GetInt(d, "quality", 60), 20, 95);
+			if (Has(d, "fps"))
+				H.fps = (int)std::clamp<int64_t>(GetInt(d, "fps", 30), 10, 60);
+			if (Has(d, "maxWidth"))
+				H.maxWidth = (int)std::clamp<int64_t>(GetInt(d, "maxWidth", 640), 320, 1280);
+			return Status();
+		}
+		if (sub == "/host/kick")
+		{
+			const int slot = (int)GetInt(d, "slot", 0);
+			std::shared_ptr<GuestConn> hit;
+			{
+				std::scoped_lock l(H.m);
+				for (auto& g : H.guests)
+					if (g->slot == slot)
+						hit = g;
+			}
+			if (hit)
+			{
+				{
+					std::scoped_lock wl(hit->wm);
+					SendMsg(hit->sock, kBye, nullptr, 0);
+				}
+				DropGuest(hit);
+			}
+			return Status();
+		}
+		if (sub == "/join")
+		{
+			if (H.running)
+				return Err(409, "stop hosting first");
+			std::string err;
+			if (!JoinClient(GetStr(d, "host"), GetStr(d, "code"), GetStr(d, "name"), err))
+				return Err(502, err);
+			return Status();
+		}
+		if (sub == "/leave")
+		{
+			LeaveClient();
+			return Status();
+		}
+		if (sub == "/input")
+		{
+			if (!C.active)
+				return Err(409, "not in a session");
+			const uint32_t b = (uint32_t)GetInt(d, "b", 0);
+			const int8_t ax[4] = {(int8_t)std::clamp<int64_t>(GetInt(d, "lx", 0), -127, 127), (int8_t)std::clamp<int64_t>(GetInt(d, "ly", 0), -127, 127),
+								  (int8_t)std::clamp<int64_t>(GetInt(d, "rx", 0), -127, 127), (int8_t)std::clamp<int64_t>(GetInt(d, "ry", 0), -127, 127)};
+			uint32_t packed;
+			std::memcpy(&packed, ax, 4);
+			std::shared_ptr<tcp::socket> s;
+			{
+				std::scoped_lock l(C.m);
+				if (b == C.lastButtons && packed == C.lastAxes)
+					return OkSimple();
+				C.lastButtons = b;
+				C.lastAxes = packed;
+				s = C.sock;
+			}
+			std::string p;
+			PutU32(p, b);
+			for (int i = 0; i < 4; i++)
+				p.push_back((char)ax[i]);
+			std::scoped_lock wl(C.wm);
+			if (s)
+				SendMsg(*s, kInput, p);
+			return OkSimple();
+		}
+		return Err(404, "unknown route");
+	}
+} // namespace ControlApi
