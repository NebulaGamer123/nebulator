+			constexpr const char* kAlpha = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
+
+			// The join code carries the host's address (4 bytes) plus a 2 byte secret, so joining needs nothing but the code.
+			std::string MakeCode(const std::string& ip)
+			{
+				boost::system::error_code ec;
+				const auto addr = asio::ip::make_address_v4(ip, ec);
+				if (ec)
+					return {};
+				std::random_device rd;
+				uint64_t v = 0;
+				for (uint8_t b : addr.to_bytes())
+					v = (v << 8) | b;
+				v = (v << 16) | (rd() & 0xFFFF);
+				v <<= 2; // 48 bits -> 50 bits = 10 characters
+				std::string c(10, 'A');
+				for (int i = 9; i >= 0; i--)
+				{
+					c[(size_t)i] = kAlpha[v & 31];
+					v >>= 5;
+				}
+				return c;
+			}
+
+			std::string NormalizeCode(const std::string& in)
+			{
+				std::string out;
+				for (char ch : in)
+				{
+					const char u = (char)toupper((unsigned char)ch);
+					if (strchr(kAlpha, u) && u != 0)
+						out += u;
+				}
+				return out;
+			}
+
+			bool HostFromCode(const std::string& code, std::string& ip)
+			{
+				if (code.size() != 10)
+					return false;
+				uint64_t v = 0;
+				for (char ch : code)
+					v = (v << 5) | (uint64_t)(strchr(kAlpha, ch) - kAlpha);
+				v >>= 2;
+				const uint32_t a = (uint32_t)(v >> 16);
+				ip = std::to_string(a >> 24) + "." + std::to_string((a >> 16) & 255) + "." + std::to_string((a >> 8) & 255) + "." + std::to_string(a & 255);
+				return true;
+			}
