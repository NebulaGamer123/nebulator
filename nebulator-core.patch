-	if (hotkey.alt)
-	{
-		ret.append(_("Alt + "));
-	}
-	if (hotkey.ctrl)
-	{
-		ret.append(_("Ctrl + "));
-	}
-	if (hotkey.shift)
-	{
-		ret.append(_("Shift + "));
-	}
-	ret.append(wxAcceleratorEntry(0, hotkey.key).ToString());
-	return ret;
-}
