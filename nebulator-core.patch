+		// ======================================================================= core-facing API
+		Mode GetMode()
+		{
+			if (s.lab.mode != Mode::Off)
+				return s.lab.mode;
+			return (s.role.empty() || s.state != "running") ? Mode::Off : Mode::Session;
+		}
+		int LocalSlot() { return s.role == "guest" ? s.slot : 0; }
+		int PlayerCount() { return s.lab.mode != Mode::Off ? 1 : std::max(1, s.nPlayers); }
+		int InputDelay() { return s.effDelay; }
+		int HashEvery() { return std::max(1, s.hashEvery); }
+		uint32_t PingMs()
+		{
+			std::scoped_lock l(s.m);
+			for (auto& p : s.roster)
+				if (p.slot == s.slot)
+					return (uint32_t)std::max(0, p.ping);
+			return 0;
+		}
+
+		void Log(const std::string& t)
+		{
+			std::scoped_lock l(s.m);
+			LogLocked(t);
+		}
+
+		void Stats(uint32_t tick, uint32_t stalls, uint32_t impure, const std::string& waiting)
+		{
+			std::scoped_lock l(s.m);
+			s.liveTick = tick;
+			s.liveStalls = stalls;
+			s.liveImpure = impure;
+			s.waitingFor = waiting;
+			if (s.lab.mode != Mode::Off)
+				s.lab.ticks = std::max(s.lab.ticks, tick);
+		}
+
+		void SendInput(uint32_t tick, const PadState& p)
+		{
+			std::scoped_lock l(s.m);
+			if (s.role == "host")
+			{
+				StoreInputLocked(tick, 0, p);
+				SendToOthersLocked(INPUT, InputPacket(tick, 0, p), nullptr);
+			}
+			else if (s.role == "guest" && s.up)
+			{
+				StoreInputLocked(tick, s.slot, p);
+				s.up->Send(INPUT, InputPacket(tick, s.slot, p));
+			}
+		}
+
+		bool WaitInputs(uint32_t tick, PadState out[kMaxPlayers], int64_t& waitedMs)
+		{
+			const int64_t t0 = NowMs();
+			std::unique_lock l(s.m);
+			if (tick < (uint32_t)s.effDelay)
+			{
+				for (int i = 0; i < kMaxPlayers; i++)
+					out[i] = PadState{};
+				waitedMs = 0;
+				return true;
+			}
+			auto have = [&] {
+				auto it = s.inputs.find(tick);
+				for (int i = 0; i < s.nPlayers; i++)
+				{
+					if (s.gone[i])
+						continue;
+					if (it == s.inputs.end() || !((it->second.mask >> i) & 1))
+						return false;
+				}
+				return true;
+			};
+			while (!have() && !s.stop && !s.role.empty())
+			{
+				auto it = s.inputs.find(tick);
+				s.waitingFor.clear();
+				for (int i = 0; i < s.nPlayers; i++)
+					if (!s.gone[i] && (it == s.inputs.end() || !((it->second.mask >> i) & 1)))
+						s.waitingFor += (s.waitingFor.empty() ? "" : ", ") + std::string("player ") + std::to_string(i + 1);
+				s.cv.wait_for(l, std::chrono::milliseconds(50));
+			}
+			s.waitingFor.clear();
+			waitedMs = NowMs() - t0;
+			if (s.role.empty())
+			{
+				for (int i = 0; i < kMaxPlayers; i++)
+					out[i] = PadState{};
+				return false;
+			}
+			auto it = s.inputs.find(tick);
+			for (int i = 0; i < kMaxPlayers; i++)
+				out[i] = (it != s.inputs.end() && ((it->second.mask >> i) & 1)) ? it->second.p[i] : PadState{};
+			while (!s.inputs.empty() && s.inputs.begin()->first + 2 < tick)
+				s.inputs.erase(s.inputs.begin());
+			return true;
+		}
+
+		void SendHash(const HashReport& r)
+		{
+			std::scoped_lock l(s.m);
+			HashRec h{r.tick, r.total, r.chunks};
+			s.myHash[r.tick] = h;
+			if (s.role == "host")
+				CheckHashLocked(r.tick);
+			else if (s.role == "guest" && s.up)
+			{
+				std::string b(12, 0);
+				memcpy(&b[0], &r.tick, 4);
+				memcpy(&b[4], &r.total, 8);
+				b += r.chunks;
+				s.up->Send(HASH, b);
+			}
+		}
+
+		void LabInput(uint32_t tick, PadState& slot0, bool record)
+		{
+			std::scoped_lock l(s.m);
+			if (record)
+			{
+				s.lab.inputs.push_back(slot0);
+				s.lab.fIn.write((const char*)&slot0.buttons, 4);
+				s.lab.fIn.write((const char*)&slot0.lx, 4);
+				if ((tick & 31) == 0)
+					s.lab.fIn.flush();
+				s.lab.ticks = tick;
+			}
+			else
+				slot0 = tick < s.lab.inputs.size() ? s.lab.inputs[tick] : PadState{};
+		}
+
+		void LabHash(const HashReport& r)
+		{
+			std::scoped_lock l(s.m);
+			if (s.lab.mode == Mode::LabRecord)
+			{
+				const uint32_t n = (uint32_t)r.chunks.size();
+				s.lab.fHash.write((const char*)&r.tick, 4);
+				s.lab.fHash.write((const char*)&r.total, 8);
+				s.lab.fHash.write((const char*)&n, 4);
+				s.lab.fHash.write(r.chunks.data(), n);
+				s.lab.fHash.flush();
+				s.lab.fIn.flush();
+				LabSaveMeta("recorded", AgreedUnixTime());
+			}
+			else if (s.lab.mode == Mode::LabReplay)
+			{
+				for (auto& h : s.lab.hashes)
+					if (h.tick == r.tick)
+					{
+						s.lab.checked++;
+						if (h.total != r.total && !s.lab.mismatch)
+						{
+							s.lab.mismatch = true;
+							s.lab.firstTick = r.tick;
+							s.lab.region = FirstDifferentRegion(h.chunks, r.chunks);
+							LogLocked("Replay drifted at tick " + std::to_string(r.tick) + " (" + s.lab.region + ")");
+						}
+						LabWriteResult();
+						break;
+					}
+			}
+		}
+
+		// ======================================================================= API
+		namespace
+		{
+			using ControlApi::Json;
+
+			void WriteStatus(Json& j)
+			{
+				std::scoped_lock l(s.m);
+				if (s.role == "host")
+					RebuildRosterLocked(s.name);
+				j.w.StartObject();
+				j.KS("role", s.role);
+				j.KS("state", s.state);
+				j.KS("code", s.role == "host" ? s.code : "");
+				j.KS("ip", s.role == "host" ? LocalIp() : "");
+				j.KI("port", kPort);
+				j.KI("slot", s.slot);
+				j.KS("hostAddr", s.hostAddr);
+				j.KS("titleId", s.titleId);
+				j.KS("error", s.error);
+				j.KS("backupDir", s.backupDir);
+				j.K("manifest");
+				if (s.manifestJson.empty())
+					j.w.Null();
+				else
+					j.w.RawValue(s.manifestJson.c_str(), s.manifestJson.size(), rapidjson::kObjectType);
+				j.K("players");
+				j.w.StartArray();
+				for (auto& p : s.roster)
+				{
+					j.w.StartObject();
+					j.KI("slot", p.slot);
+					j.KS("name", p.name);
+					j.KB("you", p.slot == (s.role == "guest" ? s.slot : 0));
+					j.KB("ready", p.ready);
+					j.KI("pingMs", p.ping);
+					j.K("problems");
+					j.w.StartArray();
+					for (auto& t : p.problems)
+						j.S(t);
+					j.w.EndArray();
+					j.w.EndObject();
+				}
+				j.w.EndArray();
+				j.K("settings");
+				j.w.StartObject();
+				j.KI("delay", s.delay);
+				j.KI("hashEvery", s.hashEvery);
+				j.KS("cpu", s.cpu);
+				j.KB("shareSave", s.shareSave);
+				j.w.EndObject();
+				j.K("desync");
+				if (s.desync)
+				{
+					j.w.StartObject();
+					j.KI("tick", s.desyncTick);
+					j.KS("region", s.desyncRegion);
+					j.w.EndObject();
+				}
+				else
+					j.w.Null();
+				j.K("lab");
+				j.w.StartObject();
+				j.KS("phase", s.lab.phase);
+				j.KS("titleId", s.lab.titleId);
+				j.KI("seconds", s.lab.seconds);
+				j.KI("ticks", s.lab.ticks);
+				{
+					std::ifstream f(LabDir() / "result.json");
+					std::string t((std::istreambuf_iterator<char>(f)), {});
+					rapidjson::Document d;
+					d.Parse(t.c_str());
+					j.K("result");
+					if (d.IsObject())
+						j.w.RawValue(t.c_str(), t.size(), rapidjson::kObjectType);
+					else
+						j.w.Null();
+				}
+				j.w.EndObject();
+				j.K("live");
+				j.w.StartObject();
+				j.KI("tick", s.liveTick);
+				j.KS("waitingFor", s.waitingFor);
+				j.KI("stalls", s.liveStalls);
+				j.KI("impure", s.liveImpure);
+				j.KI("pingMs", -1);
+				j.w.EndObject();
+				j.K("log");
+				j.w.StartArray();
+				for (auto& t : s.log)
+					j.S(t);
+				j.w.EndArray();
+				j.w.EndObject();
+			}
+		} // namespace
+	} // namespace Net
+
+	void Init(const std::string& dataDir)
+	{
+		Net::s.dataDir = dataDir;
+		Net::RestorePending();
+		// lab phase after a restart
+		std::error_code ec;
+		if (stdfs::exists(Net::LabDir() / "meta.json", ec))
+			Net::LabLoadMeta();
+	}
+} // namespace Lockstep
+
+namespace ControlApi
+{
+	static HttpResponse HandleLockImpl(const HttpRequest& req, const std::string& sub)
+	{
+		using namespace Lockstep::Net;
+		auto status = [&]() {
+			Json j;
+			WriteStatus(j);
+			return Ok(j);
+		};
+		if (sub.empty() || sub == "/status")
+			return status();
+		if (req.method != "POST")
+			return Err(405, "POST expected");
+		rapidjson::Document d;
+		if (!req.body.empty() && !ParseBody(req, d))
+			return Err(400, "invalid json");
+		if (!d.IsObject())
+			d.SetObject();
+
+		if (sub == "/host/start")
+		{
+			std::unique_lock l(s.m);
+			if (!s.role.empty())
+				return Err(409, "already in a session");
+			if (s.lab.mode != Mode::Off)
+				return Err(409, "a lab run is active");
+			s.stop = false;
+			s.error.clear();
+			s.name = GetStr(d, "name", "Host");
+			if (s.name.empty())
+				s.name = "Host";
+			const std::string myIp = LocalIp();
+			s.code = myIp.empty() ? std::string() : MakeCode(myIp);
+			if (s.code.empty())
+				return Err(503, "This PC does not seem to be on a network. Connect to Wi-Fi or Ethernet and try again.");
+			s.role = "host";
+			s.state = "idle";
+			s.slot = 0;
+			s.nPlayers = 1;
+			s.titleId.clear();
+			s.manifestJson.clear();
+			s.desync = false;
+			s.log.clear();
+			try
+			{
+				s.acc.reset(new tcp::acceptor(s.io, tcp::endpoint(tcp::v4(), kPort)));
+				s.acc->set_option(asio::socket_base::reuse_address(true));
+			}
+			catch (const std::exception& e)
+			{
+				s.role.clear();
+				return Err(500, std::string("Could not open port 17810: ") + e.what());
+			}
+			if (s.accThread.joinable())
+				s.accThread.join();
+			s.accThread = std::thread(AcceptLoop);
+			if (s.pinger.joinable())
+				s.pinger.join();
+			s.pinger = std::thread(PingLoop);
+			RebuildRosterLocked(s.name);
+			LogLocked("Hosting with code " + s.code);
+			l.unlock();
+			return status();
+		}
+		if (sub == "/host/stop" || sub == "/leave")
+		{
+			{
+				std::unique_lock l(s.m);
+				if (s.state == "running")
+					return Err(409, "a game is running");
+				StopAllLocked();
+			}
+			if (s.accThread.joinable())
+				s.accThread.join();
+			if (s.pinger.joinable())
+				s.pinger.join();
+			return status();
+		}
+		if (sub == "/join")
+		{
+			const std::string code = NormalizeCode(GetStr(d, "code")), name = GetStr(d, "name", "Guest");
+			std::string host = GetStr(d, "host"); // optional override (advanced)
+			if (host.empty() && !HostFromCode(code, host))
+				return Err(400, "That code does not look right. It has 10 letters and numbers.");
+			{
+				std::unique_lock l(s.m);
+				if (!s.role.empty())
+					return Err(409, "already in a session");
+				s.stop = false;
+				s.error.clear();
+			}
+			auto c = std::make_shared<Conn>(s.io);
+			try
+			{
+				tcp::resolver rs(s.io);
+				boost::system::error_code ec;
+				auto eps = rs.resolve(host, std::to_string(kPort), ec);
+				if (ec)
+					return Err(502, "Could not find that address.");
+				// short connect timeout
+				c->sock.non_blocking(true, ec);
+				bool ok = false;
+				for (auto& ep : eps)
+				{
+					c->sock.close(ec);
+					c->sock.open(ep.endpoint().protocol(), ec);
+					c->sock.non_blocking(true, ec);
+					c->sock.connect(ep.endpoint(), ec);
+					if (!ec || ec == asio::error::in_progress || ec == asio::error::would_block)
+					{
+						const auto t0 = NowMs();
+						while (NowMs() - t0 < 4000)
+						{
+							boost::system::error_code e2;
+							c->sock.connect(ep.endpoint(), e2);
+							if (!e2 || e2 == asio::error::already_connected)
+							{
+								ok = true;
+								break;
+							}
+							std::this_thread::sleep_for(std::chrono::milliseconds(30));
+						}
+					}
+					if (ok)
+						break;
+				}
+				c->sock.non_blocking(false, ec);
+				if (!ok)
+					return Err(502, "Could not reach the host. Check the address and that you are on the same network.");
+				c->sock.set_option(tcp::no_delay(true), ec);
+			}
+			catch (const std::exception& e)
+			{
+				return Err(502, std::string("Connection failed: ") + e.what());
+			}
+			Json h;
+			h.w.StartObject();
+			h.KS("magic", "NEBLOCK1");
+			h.KS("code", code);
+			h.KS("name", name);
+			h.KS("build", AppVersion());
+			h.w.EndObject();
+			c->Send(HELLO, h.sb.GetString());
+			uint8_t t;
+			std::string p;
+			if (!c->Recv(t, p) || t != WELCOME)
+			{
+				c->Close();
+				return Err(502, "The host did not answer.");
+			}
+			rapidjson::Document w;
+			w.Parse(p.c_str());
+			if (!w.IsObject() || !w["ok"].GetBool())
+			{
+				c->Close();
+				return Err(403, w.IsObject() && w.HasMember("msg") ? w["msg"].GetString() : "Refused.");
+			}
+			{
+				std::unique_lock l(s.m);
+				s.role = "guest";
+				s.state = "idle";
+				s.slot = w["slot"].GetInt();
+				s.name = name;
+				s.hostAddr = host;
+				s.up = c;
+				s.titleId.clear();
+				s.manifestJson.clear();
+				s.desync = false;
+				s.log.clear();
+				for (auto& g : s.gone)
+					g = false;
+				LogLocked("Joined " + host + " as player " + std::to_string(s.slot + 1));
+			}
+			std::thread(GuestLoop, c).detach();
+			return status();
+		}
+		if (sub == "/host/pick")
+		{
+			const std::string id = GetStr(d, "titleId");
+			if (id.empty())
+				return Err(400, "no game");
+			std::string err;
+			const std::string man = BuildManifest(id, &err);
+			if (!err.empty())
+				return Err(409, err);
+			std::unique_lock l(s.m);
+			if (s.role != "host" || s.state == "running")
+				return Err(409, "not hosting");
+			s.titleId = id;
+			s.manifestJson = man;
+			for (auto& g : s.guests)
+			{
+				g->ready = false;
+				g->problems.clear();
+			}
+			BroadcastRosterLocked();
+			l.unlock();
+			return status();
+		}
+		if (sub == "/host/settings")
+		{
+			std::unique_lock l(s.m);
+			if (s.role != "host" || s.state == "running")
+				return Err(409, "not available now");
+			if (Has(d, "delay"))
+				s.delay = (int)std::max<int64_t>(0, std::min<int64_t>(12, GetInt(d, "delay")));
+			if (Has(d, "hashEvery"))
+				s.hashEvery = (int)std::max<int64_t>(5, std::min<int64_t>(120, GetInt(d, "hashEvery")));
+			if (Has(d, "cpu"))
+				s.cpu = GetStr(d, "cpu") == "interpreter" ? "interpreter" : "recompiler";
+			if (Has(d, "shareSave"))
+				s.shareSave = GetBool(d, "shareSave", true);
+			BroadcastRosterLocked();
+			l.unlock();
+			return status();
+		}
+		if (sub == "/host/launch")
+		{
+			std::unique_lock l(s.m);
+			if (s.role != "host" || s.titleId.empty())
+				return Err(409, "choose a game first");
+			if (s.state == "running")
+				return Err(409, "already running");
+			for (auto& g : s.guests)
+				if (!g->problems.empty() || !g->ready)
+					return Err(409, g->name + " is not ready (see Players & game)");
+			std::string err;
+			BuildManifest(s.titleId, &err);
+			if (!err.empty())
+				return Err(409, err);
+			const int delay = s.delay > 0 ? s.delay : AutoDelay();
+			const uint64_t now = (uint64_t)time(nullptr);
+			if (s.shareSave && !s.guests.empty())
+			{
+				std::string pack;
+				if (!PackDir(SaveDir(s.titleId), pack))
+					return Err(413, "The save is too large to share.");
+				for (auto& g : s.guests)
+					g->Send(SAVE, pack);
+			}
+			const int players = (int)s.guests.size() + 1;
+			Json j;
+			j.w.StartObject();
+			j.KI("unix", (int64_t)now);
+			j.KI("delay", delay);
+			j.KI("hashEvery", s.hashEvery);
+			j.KS("cpu", s.cpu);
+			j.KI("players", players);
+			j.KS("titleId", s.titleId);
+			j.w.EndObject();
+			for (auto& g : s.guests)
+				g->Send(START, j.sb.GetString());
+			s.nPlayers = players;
+			BeginGameLocked(std::to_string(now), delay, s.hashEvery, s.cpu, players, s.titleId, false);
+			l.unlock();
+			return status();
+		}
+		if (sub == "/lab/record" || sub == "/lab/replay")
+		{
+			std::unique_lock l(s.m);
+			if (!s.role.empty())
+				return Err(409, "leave the session first");
+			if (s.state == "running" || s.lab.mode != Mode::Off)
+				return Err(409, "a game is running");
+			std::string id = GetStr(d, "titleId");
+			const bool rec = sub == "/lab/record";
+			if (!rec)
+			{
+				LabLoadMeta();
+				id = s.lab.titleId;
+				if (s.lab.phase != "recorded")
+					return Err(409, "record a run first");
+			}
+			if (id.empty())
+				return Err(400, "choose a game");
+			std::string err;
+			BuildManifest(id, &err);
+			if (!err.empty())
+				return Err(409, err);
+			s.state = "running";
+			LabStart(id, rec, (int)GetInt(d, "seconds", 60));
+			std::thread([id] {
+				std::string e;
+				if (!ControlApi::LaunchTitle(id, e))
+				{
+					std::scoped_lock l2(s.m);
+					s.error = e;
+					s.state = "idle";
+					s.lab.mode = Mode::Off;
+					Lockstep::g_active = false;
+				}
+			}).detach();
+			l.unlock();
+			return status();
+		}
+		if (sub == "/lab/reset")
+		{
+			std::unique_lock l(s.m);
+			if (s.state == "running")
+				return Err(409, "a game is running");
+			std::error_code ec;
+			stdfs::remove_all(LabDir(), ec);
+			s.lab = LabState{};
+			l.unlock();
+			return status();
+		}
+		return Err(404, "unknown route");
+	}
+
+	HttpResponse HandleLock(const HttpRequest& req, const std::string& sub)
+	{
+		try
+		{
+			return HandleLockImpl(req, sub);
+		}
+		catch (const std::exception& e)
+		{
+			Lockstep::Net::Log(std::string("Internal error on ") + sub + ": " + e.what());
+			return Err(500, std::string("Lockstep error (") + sub + "): " + e.what());
+		}
+		catch (...)
+		{
+			return Err(500, "Lockstep error (unknown) on " + sub);
+		}
+	}
+} // namespace ControlApi
