+						packs.push_back(gp->GetVirtualPath());
+				std::sort(packs.begin(), packs.end());
+				j.K("packs");
+				j.w.StartArray();
+				for (auto& p : packs)
+					j.S(p);
+				j.w.EndArray();
+				j.w.EndObject();
