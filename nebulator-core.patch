+			// ------------------------------------------------------------------ inputs / hashes
+			void StoreInputLocked(uint32_t tick, int slot, const PadState& p)
+			{
+				if (slot < 0 || slot >= kMaxPlayers)
+					return;
+				auto& e = s.inputs[tick];
+				e.p[slot] = p;
+				e.mask |= 1u << slot;
