+		{
+			std::scoped_lock l(g_ipcM);
+			g_ipc.clear();
+			g_ipcByBody.clear();
+		}
+		g_active = true;
+		if (!g_dbgRun.exchange(true))
+		{
+			if (g_dbgThread.joinable())
+				g_dbgThread.join();
+			g_dbgThread = std::thread(Watchdog);
+		}
+	}
