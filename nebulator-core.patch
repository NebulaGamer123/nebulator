+	void ApplyKeyboardDefaults(const EmulatedControllerPtr& vpad, const std::shared_ptr<ControllerBase>& kb)
+	{
+		using V = VPADController;
+		const std::pair<uint64, SDL_Keycode> map[] = {
+			{V::kButtonId_A, 'x'}, {V::kButtonId_B, 'z'}, {V::kButtonId_X, 'c'}, {V::kButtonId_Y, 'v'},
+			{V::kButtonId_L, 'q'}, {V::kButtonId_R, 'e'}, {V::kButtonId_ZL, '1'}, {V::kButtonId_ZR, '3'},
+			{V::kButtonId_Plus, SDLK_RETURN}, {V::kButtonId_Minus, SDLK_BACKSPACE}, {V::kButtonId_Home, 'h'},
+			{V::kButtonId_Up, SDLK_UP}, {V::kButtonId_Down, SDLK_DOWN}, {V::kButtonId_Left, SDLK_LEFT}, {V::kButtonId_Right, SDLK_RIGHT},
+			{V::kButtonId_StickL_Up, 'w'}, {V::kButtonId_StickL_Down, 's'}, {V::kButtonId_StickL_Left, 'a'}, {V::kButtonId_StickL_Right, 'd'},
+			{V::kButtonId_StickR_Up, 'i'}, {V::kButtonId_StickR_Down, 'k'}, {V::kButtonId_StickR_Left, 'j'}, {V::kButtonId_StickR_Right, 'l'},
+		};
+		for (const auto& [id, key] : map)
+			vpad->set_mapping(id, kb, NativeKey(key));
+	}
+
+	void AssignDefaultInput()
+	{
+		if (g_userProfileLoaded || ControlApi::InputHasUserProfile())
+			return;
+		auto& im = InputManager::instance();
+
+		std::vector<std::shared_ptr<ControllerBase>> pads;
+		if (im.is_api_available(InputAPI::SDLController))
+			if (auto provider = im.get_api_provider(InputAPI::SDLController))
+				pads = provider->get_controllers();
+
+		const AutoInput wanted = pads.empty() ? AutoInput::Keyboard : AutoInput::Gamepad;
+		if (wanted == g_autoInput)
+			return;
+
+		try
+		{
+			auto vpad = im.set_controller(0, EmulatedController::Type::VPAD);
+			if (wanted == AutoInput::Gamepad)
+			{
+				vpad->add_controller(pads.front());
+				vpad->set_default_mapping(pads.front());
+			}
+			else if (im.is_api_available(InputAPI::Keyboard))
+			{
+				auto kbs = im.get_api_provider(InputAPI::Keyboard)->get_controllers();
+				if (!kbs.empty())
+				{
+					vpad->add_controller(kbs.front());
+					ApplyKeyboardDefaults(vpad, kbs.front());
+				}
+			}
+			g_autoInput = wanted;
+		}
+		catch (const std::exception& ex)
+		{
+			cemuLog_log(LogType::Force, "Failed to set up default controller: {}", ex.what());
+		}
+	}
