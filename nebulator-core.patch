+			constexpr uint16_t kPort = 17810;
+			constexpr size_t kMaxSave = 192u << 20;
+
+			int64_t NowMs() { return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count(); }
+
+			struct Conn
+			{
+				tcp::socket sock;
+				std::mutex wm;
+				std::atomic<bool> alive{true};
+				int slot = -1;
+				std::string name;
+				std::vector<std::string> problems;
+				bool ready = false;
+				std::atomic<int> pingMs{-1};
+				int64_t pingSent = 0;
+				explicit Conn(asio::io_context& io) : sock(io) {}
+				bool Send(uint8_t t, const std::string& payload)
+				{
+					std::scoped_lock l(wm);
+					if (!alive)
+						return false;
+					std::string buf;
+					buf.resize(5 + payload.size());
+					buf[0] = (char)t;
+					const uint32_t n = (uint32_t)payload.size();
+					memcpy(&buf[1], &n, 4);
+					memcpy(&buf[5], payload.data(), payload.size());
+					boost::system::error_code ec;
+					asio::write(sock, asio::buffer(buf), ec);
+					if (ec)
+					{
+						alive = false;
+						return false;
+					}
+					return true;
+				}
+				bool Recv(uint8_t& t, std::string& payload)
+				{
+					boost::system::error_code ec;
+					uint8_t hdr[5];
+					asio::read(sock, asio::buffer(hdr, 5), ec);
+					if (ec)
+						return false;
+					uint32_t n;
+					memcpy(&n, hdr + 1, 4);
+					if (n > kMaxSave + (1u << 20))
+						return false;
+					t = hdr[0];
+					payload.resize(n);
+					if (n)
+						asio::read(sock, asio::buffer(payload.data(), n), ec);
+					return !ec;
+				}
+				void Close()
+				{
+					alive = false;
+					boost::system::error_code ec;
+					sock.shutdown(tcp::socket::shutdown_both, ec);
+					sock.close(ec);
+				}
+			};
