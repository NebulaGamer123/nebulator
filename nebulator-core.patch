-bool HotkeySettings::IsValidKeycodeUp(int keycode)
-{
-	switch (keycode)
-	{
-	case WXK_NONE:
-	case WXK_ESCAPE:
-	case WXK_ALT:
-	case WXK_CONTROL:
-	case WXK_SHIFT:
-		return false;
-	default:
-		return true;
-	}
-}
