+	// ---------------------------------------------------------------------------------------------
+	// paths and first-run files (what CemuApp::DeterminePaths / CreateDefaultMLCFiles did)
+	// ---------------------------------------------------------------------------------------------
+	void DeterminePaths(std::set<fs::path>& failedWriteAccess)
+	{
+		const char* base = SDL_GetBasePath();
+		fs::path exeDir = base ? fs::path(base) : fs::current_path();
+		fs::path dataPath = exeDir; // resources/ and gameProfiles/ live next to the executable
+		fs::path userData;
+		if (const char* env = SDL_getenv("NEBULATOR_DATA"); env && *env)
+			userData = fs::path(env);
+		else
+		{
+			// Portable layout (zip download, or a "portable.txt" next to the exe) keeps data beside the program.
+			// An installed copy (Program Files etc.) keeps it per-user, so the install folder can stay read-only.
+			std::error_code pec;
+			const fs::path portableData = exeDir / "nebulator-data";
+			if (fs::exists(exeDir / "portable.txt", pec) || fs::exists(portableData, pec))
+				userData = portableData;
+			else if (char* pref = SDL_GetPrefPath(nullptr, "NEBULATOR"))
+			{
+				userData = fs::path(pref);
+				SDL_free(pref);
+			}
+			else
+				userData = portableData;
+		}
+		std::error_code ec;
+		fs::create_directories(userData, ec);
+		ActiveSettings::SetPaths(true, exeDir / "nebulator-core", userData, userData, userData, dataPath, failedWriteAccess);
+	}
+
+	bool CreateDefaultMLCFiles(const fs::path& mlc)
+	{
+		auto mk = [](const fs::path& p)
+		{
+			std::error_code ec;
+			if (!fs::exists(p, ec))
+				return fs::create_directories(p, ec);
+			return true;
+		};
+		const fs::path directories[] = {
+			mlc,
+			mlc / "sys",
+			mlc / "usr",
+			mlc / "usr/title/00050000", // base
+			mlc / "usr/title/0005000c", // dlc
+			mlc / "usr/title/0005000e", // update
+			mlc / "usr/save/00050010/1004a000/user/common/db", // Mii Maker save folders
+			mlc / "usr/save/00050010/1004a100/user/common/db",
+			mlc / "usr/save/00050010/1004a200/user/common/db",
+			mlc / "sys/title/0005001b/1005c000/content" // language files
+		};
+		for (auto& d : directories)
+			if (!mk(d))
+				return false;
+		try
+		{
+			const auto langDir = fs::path(mlc).append("sys/title/0005001b/1005c000/content");
+			auto langFile = fs::path(langDir).append("language.txt");
+			if (!fs::exists(langFile))
+			{
+				std::ofstream file(langFile);
+				if (file.is_open())
+				{
+					const char* langStrings[] = {"ja", "en", "fr", "de", "it", "es", "zh", "ko", "nl", "pt", "ru", "zh"};
+					for (const char* lang : langStrings)
+						file << fmt::format(R"("{}",)", lang) << std::endl;
+				}
+			}
+			auto countryFile = fs::path(langDir).append("country.txt");
+			if (!fs::exists(countryFile))
+			{
+				std::ofstream file(countryFile);
+				for (sint32 i = 0; i < NCrypto::GetCountryCount(); i++)
+				{
+					const char* countryCode = NCrypto::GetCountryAsString(i);
+					if (boost::iequals(countryCode, "NN"))
+						file << "NULL," << std::endl;
+					else
+						file << fmt::format(R"("{}",)", countryCode) << std::endl;
+				}
+			}
+			const auto dummyFile = fs::path(mlc).append("writetestdummy");
+			std::ofstream file(dummyFile);
+			if (!file.is_open())
+				return false;
+			file.close();
+			fs::remove(dummyFile);
+		}
+		catch (const std::exception&)
+		{
+			return false;
+		}
+		return true;
+	}
