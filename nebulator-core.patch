+#pragma once
+// LAN co-op: hooks used by the renderer / audio code on the host.
+#include <cstdint>
+
+namespace Coop
+{
+	// true while a hosted session has at least one guest that wants a picture. Cheap, safe from any thread.
+	bool WantFrame();
+	bool HasGuests();
+	// RGB (3 bytes per pixel, top row first). Copies the data and returns immediately; the encoder runs on its own thread.
+	void SubmitFrame(const uint8_t* rgb, int w, int h);
+	// interleaved signed 16-bit stereo at 48 kHz
+	void SubmitAudio(const int16_t* stereo, int frames);
+	// largest frame width the host wants (the renderer downscales to this)
+	int MaxWidth();
+} // namespace Coop
