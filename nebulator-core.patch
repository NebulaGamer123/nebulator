-static std::string GenerateSecureRandomString()
-{
-	std::array<unsigned char, 20> bytes{};
-	if (RAND_bytes(bytes.data(), bytes.size()) != 1)
-		return "";
-	std::string result;
-	result.reserve(21);
-	for (unsigned char byte : bytes)
-	{
-		result.push_back('a' + (byte % 26));
-	}
-	return result;
-}
