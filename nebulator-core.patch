+	// ---------------------------------------------------------------------------------------------
+	// launching the game (what MainWindow::FileLoad did)
+	// ---------------------------------------------------------------------------------------------
+	bool PrepareTitle(const std::optional<fs::path>& loadFile, std::optional<uint64> loadTitleId, std::string& error)
+	{
+		if (!loadFile && loadTitleId)
+		{
+			auto r = CafeSystem::PrepareForegroundTitle(*loadTitleId);
+			if (r != CafeSystem::PREPARE_STATUS_CODE::SUCCESS)
+			{
+				error = "Failed to launch the title with that title id. Is it in one of the game paths in settings?";
+				return false;
+			}
+			return true;
+		}
+		if (!loadFile)
+		{
+			error = "No game given.";
+			return false;
+		}
+		const fs::path launchPath = *loadFile;
+		TitleInfo launchTitle{launchPath};
+		if (launchTitle.IsValid())
+		{
+			CafeTitleList::AddTitleFromPath(launchPath);
+			TitleId baseTitleId;
+			if (!CafeTitleList::FindBaseTitleId(launchTitle.GetAppTitleId(), baseTitleId))
+			{
+				error = "Unable to launch game because the base files were not found.";
+				return false;
+			}
+			auto r = CafeSystem::PrepareForegroundTitle(baseTitleId);
+			if (r == CafeSystem::PREPARE_STATUS_CODE::UNABLE_TO_MOUNT)
+			{
+				error = "Unable to mount title:\n" + _pathToUtf8(launchPath);
+				return false;
+			}
+			if (r != CafeSystem::PREPARE_STATUS_CODE::SUCCESS)
+			{
+				error = "Failed to launch game:\n" + _pathToUtf8(launchPath);
+				return false;
+			}
+			return true;
+		}
+		// not a valid title folder/archive: a bare RPX or ELF can still be launched directly
+		CafeTitleFileType fileType = DetermineCafeSystemFileType(launchPath);
+		if (fileType == CafeTitleFileType::RPX || fileType == CafeTitleFileType::ELF)
+		{
+			if (CafeSystem::PrepareForegroundTitleFromStandaloneRPX(launchPath) != CafeSystem::PREPARE_STATUS_CODE::SUCCESS)
+			{
+				error = "Failed to launch executable:\n" + _pathToUtf8(launchPath);
+				return false;
+			}
+			return true;
+		}
+		error = "Unable to launch game:\n" + _pathToUtf8(launchPath);
+		if (launchTitle.GetInvalidReason() == TitleInfo::InvalidReason::NO_DISC_KEY)
+			error += "\n\nCould not decrypt title. Make sure keys.txt (in the NEBULATOR data folder) contains the disc key for this title.";
+		if (launchTitle.GetInvalidReason() == TitleInfo::InvalidReason::NO_TITLE_TIK)
+			error += "\n\nCould not decrypt title because title.tik is missing.";
+		return false;
+	}
