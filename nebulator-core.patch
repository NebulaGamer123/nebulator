+	// ---------------------------------------------------------------------------------------------
+	// event handling
+	// ---------------------------------------------------------------------------------------------
+	void UpdateMouse(float x, float y, std::optional<bool> leftDown, std::optional<bool> rightDown)
+	{
+		const float sx = g_window_info.width > 0 ? (float)g_window_info.phys_width / (float)g_window_info.width : 1.0f;
+		const float sy = g_window_info.height > 0 ? (float)g_window_info.phys_height / (float)g_window_info.height : 1.0f;
+		auto& im = InputManager::instance();
+		std::scoped_lock lock(im.m_main_mouse.m_mutex);
+		im.m_main_mouse.position = {(int)(x * sx), (int)(y * sy)};
+		if (leftDown)
+		{
+			im.m_main_mouse.left_down = *leftDown;
+			if (*leftDown)
+				im.m_main_mouse.left_down_toggle = true;
+		}
+		if (rightDown)
+		{
+			im.m_main_mouse.right_down = *rightDown;
+			if (*rightDown)
+				im.m_main_mouse.right_down_toggle = true;
+		}
+	}
+
+	void HandleEvent(SDL_Event& e)
+	{
+		// gamepad hotplug and state updates belong to the SDL controller provider
+		if (e.type >= 0x600 && e.type < 0x700)
+		{
+			SDLControllerProvider::HandleSDLEvent(e);
+			if (e.type == SDL_EVENT_GAMEPAD_ADDED || e.type == SDL_EVENT_GAMEPAD_REMOVED)
+				AssignDefaultInput();
+			return;
+		}
+		switch (e.type)
+		{
+		case SDL_EVENT_QUIT:
+		case SDL_EVENT_WINDOW_CLOSE_REQUESTED:
+			g_quit = true;
+			break;
+		case SDL_EVENT_WINDOW_RESIZED:
+		case SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED:
+		case SDL_EVENT_WINDOW_DISPLAY_SCALE_CHANGED:
+			RefreshSizes();
+			break;
+		case SDL_EVENT_WINDOW_FOCUS_GAINED:
+			g_window_info.app_active = true;
+			break;
+		case SDL_EVENT_WINDOW_FOCUS_LOST:
+			g_window_info.app_active = false;
+			g_window_info.set_keystatesup();
+			break;
+		case SDL_EVENT_KEY_DOWN:
+		case SDL_EVENT_KEY_UP:
+		{
+			const bool down = e.type == SDL_EVENT_KEY_DOWN;
+			if (down && !e.key.repeat)
+			{
+				const bool alt = (e.key.mod & SDL_KMOD_ALT) != 0;
+				if (e.key.key == SDLK_F11 || (alt && e.key.key == SDLK_RETURN))
+				{
+					SetFullscreen(!g_window_info.is_fullscreen);
+					break;
+				}
+			}
+			if (uint32 key = NativeKey(e.key.key))
+				g_window_info.set_keystate(key, down);
+			break;
+		}
+		case SDL_EVENT_MOUSE_MOTION:
+			UpdateMouse(e.motion.x, e.motion.y, std::nullopt, std::nullopt);
+			break;
+		case SDL_EVENT_MOUSE_BUTTON_DOWN:
+		case SDL_EVENT_MOUSE_BUTTON_UP:
+		{
+			const bool down = e.type == SDL_EVENT_MOUSE_BUTTON_DOWN;
+			if (e.button.button == SDL_BUTTON_LEFT)
+				UpdateMouse(e.button.x, e.button.y, down, std::nullopt);
+			else if (e.button.button == SDL_BUTTON_RIGHT)
+				UpdateMouse(e.button.x, e.button.y, std::nullopt, down);
+			break;
+		}
+		default:
+			break;
+		}
+	}
