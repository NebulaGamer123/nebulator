+			try
+			{
+				std::error_code ec;
+				fs::remove(ActiveSettings::GetUserDataPath() / "lockstep" / "engine.log", ec); // one log per session
+			}
+			catch (...)
+			{
+			}
+			EngineLog("---- lockstep session started ----", false);
+			while (g_dbgRun.load() && Active())
+			{
+				for (int i = 0; i < 10 && g_dbgRun.load(); i++)
+					std::this_thread::sleep_for(std::chrono::milliseconds(100));
+				if (!g_dbgRun.load())
+					break;
+				sec++;
+				const uint64_t sys = g_dbgSys.load(), idle = g_dbgIdle.load(), sl = g_dbgSlices.load(), win = g_dbgWin.load(), poll = g_dbgPoll.load();
+				const bool gx2 = LatteGPUState.gx2InitCalled != 0;
+				if (gx2 && !loggedInit)
