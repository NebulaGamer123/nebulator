+// Controller setup and binding API (players 1-4).
+
+#include "ControlApi.h"
+#include "SdlKeys.h"
+
+#include "input/InputManager.h"
+#include "input/emulated/VPADController.h"
+#include "input/emulated/ProController.h"
+#include "input/api/Controller.h"
+
+namespace ControlApi
+{
+	namespace
+	{
+		std::atomic_bool g_userProfile{false};
+
+		struct BtnDef
+		{
+			const char* name;
+			const char* label;
+			const char* group;
+			uint64 id;
+		};
+
+		template<class C>
+		std::vector<BtnDef> MakeButtons()
+		{
+			return {
+				{"A", "A", "face", C::kButtonId_A},
+				{"B", "B", "face", C::kButtonId_B},
+				{"X", "X", "face", C::kButtonId_X},
+				{"Y", "Y", "face", C::kButtonId_Y},
+				{"L", "L", "shoulder", C::kButtonId_L},
+				{"R", "R", "shoulder", C::kButtonId_R},
+				{"ZL", "ZL", "shoulder", C::kButtonId_ZL},
+				{"ZR", "ZR", "shoulder", C::kButtonId_ZR},
+				{"Plus", "+", "system", C::kButtonId_Plus},
+				{"Minus", "-", "system", C::kButtonId_Minus},
+				{"Home", "Home", "system", C::kButtonId_Home},
+				{"Up", "Up", "dpad", C::kButtonId_Up},
+				{"Down", "Down", "dpad", C::kButtonId_Down},
+				{"Left", "Left", "dpad", C::kButtonId_Left},
+				{"Right", "Right", "dpad", C::kButtonId_Right},
+				{"LUp", "Up", "lstick", C::kButtonId_StickL_Up},
+				{"LDown", "Down", "lstick", C::kButtonId_StickL_Down},
+				{"LLeft", "Left", "lstick", C::kButtonId_StickL_Left},
+				{"LRight", "Right", "lstick", C::kButtonId_StickL_Right},
+				{"LClick", "Click", "lstick", C::kButtonId_StickL},
+				{"RUp", "Up", "rstick", C::kButtonId_StickR_Up},
+				{"RDown", "Down", "rstick", C::kButtonId_StickR_Down},
+				{"RLeft", "Left", "rstick", C::kButtonId_StickR_Left},
+				{"RRight", "Right", "rstick", C::kButtonId_StickR_Right},
+				{"RClick", "Click", "rstick", C::kButtonId_StickR},
+			};
+		}
+
+		const std::vector<BtnDef>& Buttons(EmulatedController::Type t)
+		{
+			static const auto vpad = MakeButtons<VPADController>();
+			static const auto pro = MakeButtons<ProController>();
+			return t == EmulatedController::Type::VPAD ? vpad : pro;
+		}
+
+		const BtnDef* FindButton(EmulatedController::Type t, const std::string& name)
+		{
+			for (auto& b : Buttons(t))
+				if (name == b.name)
+					return &b;
+			return nullptr;
+		}
+
+		std::string DeviceId(const ControllerPtr& c) { return std::string(c->api_name()) + "|" + c->uuid(); }
+
+		std::vector<ControllerPtr> AllDevices()
+		{
+			std::vector<ControllerPtr> out;
+			auto& im = InputManager::instance();
+			for (auto api : {InputAPI::Keyboard, InputAPI::SDLController})
+			{
+				if (!im.is_api_available(api))
+					continue;
+				if (auto p = im.get_api_provider(api))
+					for (auto& c : p->get_controllers())
+						out.push_back(c);
+			}
+			return out;
+		}
+
+		ControllerPtr FindDevice(const std::string& id)
+		{
+			for (auto& c : AllDevices())
+				if (DeviceId(c) == id)
+					return c;
+			return {};
+		}
+
+		bool IsKeyboard(const ControllerPtr& c) { return c->api() == InputAPI::Keyboard; }
+
+		template<class C>
+		void ApplyKeyboardDefaultsT(const EmulatedControllerPtr& pad, const ControllerPtr& kb)
+		{
+			const std::pair<uint64, SDL_Keycode> map[] = {
+				{C::kButtonId_A, 'x'}, {C::kButtonId_B, 'z'}, {C::kButtonId_X, 'c'}, {C::kButtonId_Y, 'v'},
+				{C::kButtonId_L, 'q'}, {C::kButtonId_R, 'e'}, {C::kButtonId_ZL, '1'}, {C::kButtonId_ZR, '3'},
+				{C::kButtonId_Plus, SDLK_RETURN}, {C::kButtonId_Minus, SDLK_BACKSPACE}, {C::kButtonId_Home, 'h'},
+				{C::kButtonId_Up, SDLK_UP}, {C::kButtonId_Down, SDLK_DOWN}, {C::kButtonId_Left, SDLK_LEFT}, {C::kButtonId_Right, SDLK_RIGHT},
+				{C::kButtonId_StickL_Up, 'w'}, {C::kButtonId_StickL_Down, 's'}, {C::kButtonId_StickL_Left, 'a'}, {C::kButtonId_StickL_Right, 'd'},
+				{C::kButtonId_StickR_Up, 'i'}, {C::kButtonId_StickR_Down, 'k'}, {C::kButtonId_StickR_Left, 'j'}, {C::kButtonId_StickR_Right, 'l'},
+			};
+			for (const auto& [id, key] : map)
+				pad->set_mapping(id, kb, SdlKeys::NativeFromSdl(key));
+		}
+
+		const char* TypeName(EmulatedController::Type t) { return t == EmulatedController::Type::VPAD ? "vpad" : "pro"; }
+
+		HttpResponse Overview()
+		{
+			auto& im = InputManager::instance();
+			Json j;
+			j.w.StartObject();
+			j.K("devices");
+			j.w.StartArray();
+			for (auto& c : AllDevices())
+			{
+				j.w.StartObject();
+				j.KS("id", DeviceId(c));
+				j.KS("name", c->display_name());
+				j.KS("kind", IsKeyboard(c) ? "keyboard" : "gamepad");
+				j.w.EndObject();
+			}
+			j.w.EndArray();
+			j.K("buttons");
+			j.w.StartObject();
+			for (auto t : {EmulatedController::Type::VPAD, EmulatedController::Type::Pro})
+			{
+				j.K(TypeName(t));
+				j.w.StartArray();
+				for (auto& b : Buttons(t))
+				{
+					j.w.StartObject();
+					j.KS("name", b.name);
+					j.KS("label", b.label);
+					j.KS("group", b.group);
+					j.w.EndObject();
+				}
+				j.w.EndArray();
+			}
+			j.w.EndObject();
+			j.K("players");
+			j.w.StartArray();
+			for (size_t p = 0; p < 4; p++)
+			{
+				j.w.StartObject();
+				j.KI("index", (int64_t)p);
+				auto emu = im.get_controller(p);
+				j.KB("configured", emu != nullptr);
+				if (emu)
+				{
+					const auto type = emu->type();
+					const bool known = type == EmulatedController::Type::VPAD || type == EmulatedController::Type::Pro;
+					j.KS("type", known ? TypeName(type) : "other");
+					j.K("devices");
+					j.w.StartArray();
+					for (auto& c : emu->get_controllers())
+						j.S(DeviceId(c));
+					j.w.EndArray();
+					j.K("bindings");
+					j.w.StartObject();
+					if (known)
+						for (auto& b : Buttons(type))
+							j.KS(b.name, emu->get_mapping_name(b.id));
+					j.w.EndObject();
+				}
+				j.w.EndObject();
+			}
+			j.w.EndArray();
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		bool ValidPlayer(int64_t p) { return p >= 0 && p < 4; }
+
+		HttpResponse Setup(const HttpRequest& req)
+		{
+			rapidjson::Document d;
+			if (!ParseBody(req, d))
+				return Err(400, "invalid json");
+			const int64_t p = GetInt(d, "player", -1);
+			if (!ValidPlayer(p))
+				return Err(400, "bad player");
+			const std::string typeStr = GetStr(d, "type", "pro");
+			const auto type = typeStr == "vpad" ? EmulatedController::Type::VPAD : EmulatedController::Type::Pro;
+			if (type == EmulatedController::Type::VPAD && p > 1)
+				return Err(400, "only players 1 and 2 can use the GamePad layout");
+			auto dev = FindDevice(GetStr(d, "device"));
+			if (!dev)
+				return Err(404, "device not found");
+			auto& im = InputManager::instance();
+			auto emu = im.set_controller((size_t)p, type);
+			if (!emu)
+				return Err(500, "couldn't create the controller");
+			emu->clear_controllers();
+			emu->add_controller(dev);
+			if (IsKeyboard(dev))
+			{
+				if (p == 0)
+				{
+					if (type == EmulatedController::Type::VPAD)
+						ApplyKeyboardDefaultsT<VPADController>(emu, dev);
+					else
+						ApplyKeyboardDefaultsT<ProController>(emu, dev);
+				}
+			}
+			else
+				emu->set_default_mapping(dev);
+			im.save((size_t)p);
+			if (p == 0)
+				InputSetUserProfile();
+			return Overview();
+		}
+
+		HttpResponse Clear(const HttpRequest& req)
+		{
+			rapidjson::Document d;
+			if (!ParseBody(req, d))
+				return Err(400, "invalid json");
+			const int64_t p = GetInt(d, "player", -1);
+			if (!ValidPlayer(p))
+				return Err(400, "bad player");
+			InputManager::instance().delete_controller((size_t)p, true);
+			return Overview();
+		}
+
+		HttpResponse BindKey(const HttpRequest& req)
+		{
+			rapidjson::Document d;
+			if (!ParseBody(req, d))
+				return Err(400, "invalid json");
+			const int64_t p = GetInt(d, "player", -1);
+			if (!ValidPlayer(p))
+				return Err(400, "bad player");
+			auto emu = InputManager::instance().get_controller((size_t)p);
+			if (!emu)
+				return Err(409, "player not set up");
+			const BtnDef* b = FindButton(emu->type(), GetStr(d, "button"));
+			if (!b)
+				return Err(400, "bad button");
+			const uint32 native = SdlKeys::NativeFromName(GetStr(d, "key"));
+			if (native == 0)
+				return Err(400, "that key can't be used");
+			ControllerPtr kb;
+			for (auto& c : AllDevices())
+				if (IsKeyboard(c))
+					kb = c;
+			if (!kb)
+				return Err(404, "no keyboard device");
+			bool has = false;
+			for (auto& c : emu->get_controllers())
+				if (c == kb)
+					has = true;
+			if (!has)
+				emu->add_controller(kb);
+			emu->set_mapping(b->id, kb, native);
+			InputManager::instance().save((size_t)p);
+			if (p == 0)
+				InputSetUserProfile();
+			Json j;
+			j.w.StartObject();
+			j.KS("label", emu->get_mapping_name(b->id));
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		HttpResponse Unbind(const HttpRequest& req)
+		{
+			rapidjson::Document d;
+			if (!ParseBody(req, d))
+				return Err(400, "invalid json");
+			const int64_t p = GetInt(d, "player", -1);
+			if (!ValidPlayer(p))
+				return Err(400, "bad player");
+			auto emu = InputManager::instance().get_controller((size_t)p);
+			if (!emu)
+				return Err(409, "player not set up");
+			const BtnDef* b = FindButton(emu->type(), GetStr(d, "button"));
+			if (!b)
+				return Err(400, "bad button");
+			emu->delete_mapping(b->id);
+			InputManager::instance().save((size_t)p);
+			if (p == 0)
+				InputSetUserProfile();
+			return OkSimple();
+		}
+
+		bool g_captureArmed = false;
+		std::mutex g_captureMutex;
+
+		// Polled by the UI while it waits for a gamepad press. Returns captured=true once a button was bound.
+		HttpResponse Capture(const HttpRequest& req)
+		{
+			rapidjson::Document d;
+			if (!ParseBody(req, d))
+				return Err(400, "invalid json");
+			const int64_t p = GetInt(d, "player", -1);
+			if (!ValidPlayer(p))
+				return Err(400, "bad player");
+			auto emu = InputManager::instance().get_controller((size_t)p);
+			if (!emu)
+				return Err(409, "player not set up");
+			const BtnDef* b = FindButton(emu->type(), GetStr(d, "button"));
+			if (!b)
+				return Err(400, "bad button");
+
+			std::scoped_lock lock(g_captureMutex);
+			if (GetBool(d, "begin", false))
+				g_captureArmed = false;
+
+			Json j;
+			j.w.StartObject();
+			for (auto& c : emu->get_controllers())
+			{
+				if (IsKeyboard(c))
+					continue;
+				const auto& state = c->update_state();
+				if (state.buttons.IsIdle())
+				{
+					g_captureArmed = true;
+					continue;
+				}
+				if (!g_captureArmed)
+					continue;
+				for (const auto id : state.buttons.GetButtonList())
+				{
+					if (c->has_axis())
+					{
+						const auto& s = state;
+						auto dominated = [&](uint32 a, uint32 a2, uint32 o, uint32 o2, float av, float ov)
+						{
+							return (id == a || id == a2) && (s.buttons.GetButtonState(o) || s.buttons.GetButtonState(o2)) && std::abs(ov) > std::abs(av);
+						};
+						if (dominated(kAxisXP, kAxisXN, kAxisYP, kAxisYN, s.axis.x, s.axis.y) ||
+							dominated(kAxisYP, kAxisYN, kAxisXP, kAxisXN, s.axis.y, s.axis.x) ||
+							dominated(kRotationXP, kRotationXN, kRotationYP, kRotationYN, s.rotation.x, s.rotation.y) ||
+							dominated(kRotationYP, kRotationYN, kRotationXP, kRotationXN, s.rotation.y, s.rotation.x) ||
+							dominated(kTriggerXP, kTriggerXN, kTriggerYP, kTriggerYN, s.trigger.x, s.trigger.y) ||
+							dominated(kTriggerYP, kTriggerYN, kTriggerXP, kTriggerXN, s.trigger.y, s.trigger.x))
+							continue;
+						if (id >= kButtonAxisStart && c->get_axis_value(id) < 0.33f)
+							continue;
+					}
+					emu->set_mapping(b->id, c, id);
+					InputManager::instance().save((size_t)p);
+					if (p == 0)
+						InputSetUserProfile();
+					g_captureArmed = false;
+					j.KB("captured", true);
+					j.KS("label", emu->get_mapping_name(b->id));
+					j.w.EndObject();
+					return Ok(j);
+				}
+			}
+			j.KB("captured", false);
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		// which emulated buttons are held right now (for the live preview on the binding screen)
+		HttpResponse LiveState(const HttpRequest& req)
+		{
+			const int64_t p = std::atoi(QueryParam(req, "player").c_str());
+			if (!ValidPlayer(p))
+				return Err(400, "bad player");
+			auto emu = InputManager::instance().get_controller((size_t)p);
+			Json j;
+			j.w.StartObject();
+			j.K("down");
+			j.w.StartArray();
+			if (emu && (emu->type() == EmulatedController::Type::VPAD || emu->type() == EmulatedController::Type::Pro))
+			{
+				emu->controllers_update_states();
+				for (auto& b : Buttons(emu->type()))
+					if (emu->is_mapping_down(b.id))
+						j.S(b.name);
+			}
+			j.w.EndArray();
+			j.w.EndObject();
+			return Ok(j);
+		}
+	} // namespace
+
+	void InputSetUserProfile() { g_userProfile = true; }
+	bool InputHasUserProfile() { return g_userProfile; }
+
+	HttpResponse HandleInput(const HttpRequest& req, const std::string& sub)
+	{
+		const bool post = req.method == "POST";
+		if (sub.empty())
+			return Overview();
+		if (sub == "/state")
+			return LiveState(req);
+		if (!post)
+			return Err(405, "method not allowed");
+		if (sub == "/setup")
+			return Setup(req);
+		if (sub == "/clear")
+			return Clear(req);
+		if (sub == "/bind-key")
+			return BindKey(req);
+		if (sub == "/capture")
+			return Capture(req);
+		if (sub == "/unbind")
+			return Unbind(req);
+		return Err(404, "unknown route");
+	}
+} // namespace ControlApi
diff --git a/src/gui/sdlgui/ControlSky.cpp b/src/gui/sdlgui/ControlSky.cpp
new file mode 100644
index 0000000..b410087
--- /dev/null
+++ b/src/gui/sdlgui/ControlSky.cpp
@@ -0,0 +1,316 @@
+// Skylanders portal API: figure collection, portal slots, emulated/real portal switch.
+
+#include "ControlApi.h"
+
+#include "config/ActiveSettings.h"
+#include "config/CemuConfig.h"
+#include "Cafe/OS/libs/nsyshid/Skylander.h"
+#include "Common/FileStream.h"
+
+#include <array>
+#include <mutex>
+
+namespace ControlApi
+{
+	namespace
+	{
+		constexpr int kSlots = 16;
+
+		struct Slot
+		{
+			bool used = false;
+			uint8 portalSlot = 0xFF;
+			std::string file;
+			uint16 id = 0;
+			uint16 var = 0;
+		};
+
+		std::mutex g_mutex;
+		std::array<Slot, kSlots> g_slots;
+		bool g_restored = false;
+
+		fs::path Dir()
+		{
+			fs::path p = ActiveSettings::GetUserDataPath("skylanders");
+			std::error_code ec;
+			fs::create_directories(p, ec);
+			return p;
+		}
+
+		bool SafeName(const std::string& n)
+		{
+			if (n.empty() || n.size() > 120 || n[0] == '.')
+				return false;
+			for (char c : n)
+				if (c == '/' || c == '\\' || c == ':' || c == '\0' || (unsigned char)c < 0x20)
+					return false;
+			std::string ext = _pathToUtf8(_utf8ToPath(n).extension());
+			for (auto& ch : ext) ch = (char)std::tolower((unsigned char)ch);
+			return ext == ".sky" || ext == ".bin" || ext == ".dump" || ext == ".dmp";
+		}
+
+		bool ReadFigure(const fs::path& p, std::array<uint8, nsyshid::SKY_FIGURE_SIZE>& out, uint16& id, uint16& var)
+		{
+			std::unique_ptr<FileStream> f(FileStream::openFile2(p, false));
+			if (!f)
+				return false;
+			if (f->readData(out.data(), out.size()) != out.size())
+				return false;
+			id = uint16(out[0x11]) << 8 | uint16(out[0x10]);
+			var = uint16(out[0x1D]) << 8 | uint16(out[0x1C]);
+			return true;
+		}
+
+		void SaveSlots()
+		{
+			Json j;
+			j.w.StartArray();
+			for (int i = 0; i < kSlots; i++)
+				if (g_slots[i].used)
+				{
+					j.w.StartObject();
+					j.KI("slot", i);
+					j.KS("file", g_slots[i].file);
+					j.w.EndObject();
+				}
+			j.w.EndArray();
+			std::ofstream out(Dir() / "portal.json", std::ios::binary | std::ios::trunc);
+			out.write(j.sb.GetString(), (std::streamsize)j.sb.GetSize());
+		}
+
+		bool PlaceLocked(int slot, const std::string& file, std::string& err)
+		{
+			if (slot < 0 || slot >= kSlots)
+			{
+				err = "bad slot";
+				return false;
+			}
+			if (!SafeName(file))
+			{
+				err = "bad file name";
+				return false;
+			}
+			for (int i = 0; i < kSlots; i++)
+				if (g_slots[i].used && g_slots[i].file == file && i != slot)
+				{
+					err = "that figure is already on the portal";
+					return false;
+				}
+			const fs::path path = Dir() / _utf8ToPath(file);
+			std::array<uint8, nsyshid::SKY_FIGURE_SIZE> data;
+			uint16 id, var;
+			if (!ReadFigure(path, data, id, var))
+			{
+				err = "couldn't read the figure file (is it 1024 bytes?)";
+				return false;
+			}
+			if (g_slots[slot].used)
+			{
+				nsyshid::g_skyportal.RemoveSkylander(g_slots[slot].portalSlot);
+				g_slots[slot] = {};
+			}
+			std::unique_ptr<FileStream> stream(FileStream::openFile2(path, true));
+			if (!stream)
+			{
+				err = "couldn't open the figure file for writing";
+				return false;
+			}
+			const uint8 portalSlot = nsyshid::g_skyportal.LoadSkylander(data.data(), std::move(stream));
+			if (portalSlot == 0xFF)
+			{
+				err = "the portal is full";
+				return false;
+			}
+			g_slots[slot] = {true, portalSlot, file, id, var};
+			return true;
+		}
+
+		void RestoreLocked()
+		{
+			if (g_restored)
+				return;
+			g_restored = true;
+			std::ifstream in(Dir() / "portal.json", std::ios::binary);
+			if (!in)
+				return;
+			std::string text((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+			rapidjson::Document d;
+			d.Parse(text.c_str(), text.size());
+			if (d.HasParseError() || !d.IsArray())
+				return;
+			for (auto& v : d.GetArray())
+			{
+				if (!v.IsObject())
+					continue;
+				std::string err;
+				PlaceLocked((int)GetInt(v, "slot", -1), GetStr(v, "file"), err);
+			}
+		}
+
+		std::string UniqueName(const std::string& base)
+		{
+			std::string clean;
+			for (char c : base)
+				clean += (std::isalnum((unsigned char)c) || c == ' ' || c == '-' || c == '_' || c == '\'') ? c : '_';
+			if (clean.empty()) clean = "figure";
+			fs::path dir = Dir();
+			std::error_code ec;
+			std::string name = clean + ".sky";
+			for (int i = 2; fs::exists(dir / _utf8ToPath(name), ec); i++)
+				name = fmt::format("{} ({}).sky", clean, i);
+			return name;
+		}
+
+		HttpResponse SkyState()
+		{
+			Json j;
+			j.w.StartObject();
+			j.KB("emulated", GetConfig().emulated_usb_devices.emulate_skylander_portal.GetValue());
+			j.KS("folder", _pathToUtf8(Dir()));
+			j.K("collection");
+			j.w.StartArray();
+			std::error_code ec;
+			std::vector<fs::path> files;
+			for (fs::directory_iterator it(Dir(), ec), end; !ec && it != end; it.increment(ec))
+				if (it->is_regular_file(ec))
+					files.push_back(it->path());
+			std::sort(files.begin(), files.end());
+			for (auto& p : files)
+			{
+				const std::string name = _pathToUtf8(p.filename());
+				if (!SafeName(name))
+					continue;
+				std::array<uint8, nsyshid::SKY_FIGURE_SIZE> data;
+				uint16 id, var;
+				if (!ReadFigure(p, data, id, var))
+					continue;
+				j.w.StartObject();
+				j.KS("file", name);
+				j.KI("id", id);
+				j.KI("var", var);
+				j.KS("name", nsyshid::g_skyportal.FindSkylander(id, var));
+				j.w.EndObject();
+			}
+			j.w.EndArray();
+			j.K("slots");
+			j.w.StartArray();
+			for (int i = 0; i < kSlots; i++)
+			{
+				j.w.StartObject();
+				j.KI("slot", i);
+				if (g_slots[i].used)
+				{
+					j.KS("file", g_slots[i].file);
+					j.KI("id", g_slots[i].id);
+					j.KI("var", g_slots[i].var);
+					j.KS("name", nsyshid::g_skyportal.FindSkylander(g_slots[i].id, g_slots[i].var));
+				}
+				else
+					j.Null("file");
+				j.w.EndObject();
+			}
+			j.w.EndArray();
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		HttpResponse Catalog()
+		{
+			Json j;
+			j.w.StartArray();
+			for (const auto& it : nsyshid::SkylanderUSB::GetListSkylanders())
+			{
+				j.w.StartObject();
+				j.KI("id", it.first.first);
+				j.KI("var", it.first.second);
+				j.KS("name", it.second);
+				j.w.EndObject();
+			}
+			j.w.EndArray();
+			HttpResponse r;
+			r.body.assign(j.sb.GetString(), j.sb.GetSize());
+			return r;
+		}
+	} // namespace
+
+	void SkyRestore()
+	{
+		std::scoped_lock lock(g_mutex);
+		RestoreLocked();
+	}
+
+	HttpResponse HandleSky(const HttpRequest& req, const std::string& sub)
+	{
+		std::scoped_lock lock(g_mutex);
+		RestoreLocked();
+		const bool post = req.method == "POST";
+		if (sub.empty())
+			return SkyState();
+		if (sub == "/catalog")
+			return Catalog();
+		if (!post)
+			return Err(405, "method not allowed");
+		rapidjson::Document d;
+		if (!ParseBody(req, d))
+			return Err(400, "invalid json");
+
+		if (sub == "/mode")
+		{
+			GetConfig().emulated_usb_devices.emulate_skylander_portal = GetBool(d, "emulated", true);
+			GetConfigHandle().Save();
+			return SkyState();
+		}
+		if (sub == "/create")
+		{
+			const int64_t id = GetInt(d, "id", -1), var = GetInt(d, "var", -1);
+			if (id < 0 || id > 0xFFFF || var < 0 || var > 0xFFFF)
+				return Err(400, "bad id/variant");
+			const std::string name = UniqueName(nsyshid::g_skyportal.FindSkylander((uint16)id, (uint16)var));
+			if (!nsyshid::g_skyportal.CreateSkylander(Dir() / _utf8ToPath(name), (uint16)id, (uint16)var))
+				return Err(500, "couldn't create the figure file");
+			Json j;
+			j.w.StartObject();
+			j.KS("file", name);
+			j.w.EndObject();
+			return Ok(j);
+		}
+		if (sub == "/import")
+		{
+			const fs::path src = _utf8ToPath(GetStr(d, "path"));
+			std::error_code ec;
+			if (!fs::is_regular_file(src, ec) || fs::file_size(src, ec) != nsyshid::SKY_FIGURE_SIZE)
+				return Err(400, "that is not a 1024-byte figure dump");
+			const std::string name = UniqueName(_pathToUtf8(src.stem()));
+			fs::copy_file(src, Dir() / _utf8ToPath(name), ec);
+			if (ec)
+				return Err(500, "couldn't copy the file");
+			Json j;
+			j.w.StartObject();
+			j.KS("file", name);
+			j.w.EndObject();
+			return Ok(j);
+		}
+		if (sub == "/place")
+		{
+			std::string err;
+			if (!PlaceLocked((int)GetInt(d, "slot", -1), GetStr(d, "file"), err))
+				return Err(400, err);
+			SaveSlots();
+			return SkyState();
+		}
+		if (sub == "/remove")
+		{
+			const int s = (int)GetInt(d, "slot", -1);
+			if (s < 0 || s >= kSlots)
+				return Err(400, "bad slot");
+			if (g_slots[s].used)
+			{
+				nsyshid::g_skyportal.RemoveSkylander(g_slots[s].portalSlot);
+				g_slots[s] = {};
+				SaveSlots();
+			}
+			return SkyState();
+		}
+		return Err(404, "unknown route");
+	}
+} // namespace ControlApi
diff --git a/src/gui/sdlgui/ControlUpdate.cpp b/src/gui/sdlgui/ControlUpdate.cpp
new file mode 100644
index 0000000..d38fa7c
--- /dev/null
+++ b/src/gui/sdlgui/ControlUpdate.cpp
@@ -0,0 +1,417 @@
+// Self-update: asks GitHub whether a newer release exists, downloads its installer, checks the SHA-256 that is
+// published next to it, then runs the installer silently and exits so the files can be replaced.
+//
+//   GET  /api/update/check    -> {current, latest, available, offline, error, notes, canInstall}
+//   POST /api/update/install  -> starts the download (progress via /api/update/status)
+//   GET  /api/update/status   -> {stage: idle|downloading|verifying|ready|error, percent, message}
+//   POST /api/update/apply    -> runs the downloaded installer and quits NEBULATOR (Windows)
+
+#include "ControlApi.h"
+
+#include "config/ActiveSettings.h"
+
+#include <SDL3/SDL.h>
+#include <curl/curl.h>
+#include <openssl/evp.h>
+#include <atomic>
+#include <fstream>
+#include <mutex>
+#include <set>
+#include <thread>
+
+#if BOOST_OS_WINDOWS
+#include <windows.h>
+#endif
+
+namespace ControlApi
+{
+	namespace
+	{
+		constexpr const char* kRepo = "NebulaGamer123/nebulator";
+		constexpr const char* kSetupAsset = "NEBULATOR-Setup.exe";
+		constexpr const char* kShaAsset = "NEBULATOR-Setup.exe.sha256";
+
+		struct Upd
+		{
+			std::mutex m;
+			std::string stage = "idle";
+			std::string message;
+			std::atomic<int> percent{0};
+			std::string latest, notes, setupUrl, shaUrl;
+			fs::path file;
+			std::atomic_bool working{false};
+		} g_u;
+
+		void SetStage(const std::string& s, const std::string& msg = {})
+		{
+			std::scoped_lock l(g_u.m);
+			g_u.stage = s;
+			g_u.message = msg;
+		}
+
+		std::string Trim(std::string s)
+		{
+			while (!s.empty() && std::isspace((unsigned char)s.back())) s.pop_back();
+			size_t i = 0;
+			while (i < s.size() && std::isspace((unsigned char)s[i])) i++;
+			return s.substr(i);
+		}
+
+		std::vector<int> ParseVer(std::string s)
+		{
+			s = Trim(s);
+			if (!s.empty() && (s[0] == 'v' || s[0] == 'V')) s.erase(0, 1);
+			std::vector<int> v;
+			size_t i = 0;
+			while (i < s.size())
+			{
+				if (!std::isdigit((unsigned char)s[i])) break;
+				int n = 0;
+				while (i < s.size() && std::isdigit((unsigned char)s[i])) n = n * 10 + (s[i++] - '0');
+				v.push_back(n);
+				if (i < s.size() && s[i] == '.') i++; else break;
+			}
+			return v;
+		}
+		// >0 when a is newer than b
+		int CmpVer(const std::string& a, const std::string& b)
+		{
+			auto x = ParseVer(a), y = ParseVer(b);
+			const size_t n = std::max(x.size(), y.size());
+			for (size_t i = 0; i < n; i++)
+			{
+				const int p = i < x.size() ? x[i] : 0, q = i < y.size() ? y[i] : 0;
+				if (p != q) return p > q ? 1 : -1;
+			}
+			return 0;
+		}
+
+		bool UrlAllowed(const std::string& url)
+		{
+			static const std::set<std::string> hosts = {"github.com", "api.github.com", "objects.githubusercontent.com",
+														"release-assets.githubusercontent.com", "github-releases.githubusercontent.com"};
+			if (url.rfind("https://", 0) != 0)
+				return false;
+			const size_t e = url.find_first_of("/?#", 8);
+			return hosts.count(url.substr(8, e == std::string::npos ? std::string::npos : e - 8)) != 0;
+		}
+
+		struct Sink
+		{
+			std::string* text = nullptr;
+			std::ofstream* file = nullptr;
+			std::atomic<int>* percent = nullptr;
+		};
+		size_t OnData(void* p, size_t sz, size_t n, Sink* s)
+		{
+			if (s->text) s->text->append((const char*)p, sz * n);
+			if (s->file) s->file->write((const char*)p, (std::streamsize)(sz * n));
+			return sz * n;
+		}
+		int OnProgress(Sink* s, curl_off_t total, curl_off_t now, curl_off_t, curl_off_t)
+		{
+			if (s->percent && total > 0) *s->percent = (int)(now * 100 / total);
+			return 0;
+		}
+
+		// returns the curl result; http status in code
+		CURLcode Get(const std::string& url, Sink& sink, long timeoutSec, long& code)
+		{
+			code = 0;
+			CURL* curl = curl_easy_init();
+			if (!curl)
+				return CURLE_FAILED_INIT;
+			curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+			curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, OnData);
+			curl_easy_setopt(curl, CURLOPT_WRITEDATA, &sink);
+			curl_easy_setopt(curl, CURLOPT_XFERINFOFUNCTION, OnProgress);
+			curl_easy_setopt(curl, CURLOPT_XFERINFODATA, &sink);
+			curl_easy_setopt(curl, CURLOPT_NOPROGRESS, 0L);
+			curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+			curl_easy_setopt(curl, CURLOPT_MAXREDIRS, 6L);
+			curl_easy_setopt(curl, CURLOPT_PROTOCOLS_STR, "https");
+			curl_easy_setopt(curl, CURLOPT_REDIR_PROTOCOLS_STR, "https");
+			curl_easy_setopt(curl, CURLOPT_SSL_VERIFYHOST, 2L);
+			curl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, 1L);
+			curl_easy_setopt(curl, CURLOPT_SSL_OPTIONS, CURLSSLOPT_NATIVE_CA);
+			curl_easy_setopt(curl, CURLOPT_USERAGENT, "NEBULATOR-updater");
+			curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 6L);
+			curl_easy_setopt(curl, CURLOPT_TIMEOUT, timeoutSec);
+			curl_easy_setopt(curl, CURLOPT_FAILONERROR, 0L);
+			const CURLcode res = curl_easy_perform(curl);
+			curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &code);
+			curl_easy_cleanup(curl);
+			return res;
+		}
+
+		bool IsOfflineError(CURLcode c)
+		{
+			return c == CURLE_COULDNT_RESOLVE_HOST || c == CURLE_COULDNT_RESOLVE_PROXY || c == CURLE_COULDNT_CONNECT ||
+				   c == CURLE_OPERATION_TIMEDOUT || c == CURLE_SEND_ERROR || c == CURLE_RECV_ERROR || c == CURLE_GOT_NOTHING;
+		}
+
+		bool Sha256Hex(const fs::path& file, std::string& out)
+		{
+			std::ifstream in(file, std::ios::binary);
+			if (!in)
+				return false;
+			EVP_MD_CTX* ctx = EVP_MD_CTX_new();
+			EVP_DigestInit_ex(ctx, EVP_sha256(), nullptr);
+			std::vector<char> buf(1 << 16);
+			while (in)
+			{
+				in.read(buf.data(), (std::streamsize)buf.size());
+				if (in.gcount() > 0)
+					EVP_DigestUpdate(ctx, buf.data(), (size_t)in.gcount());
+			}
+			unsigned char md[EVP_MAX_MD_SIZE];
+			unsigned int len = 0;
+			EVP_DigestFinal_ex(ctx, md, &len);
+			EVP_MD_CTX_free(ctx);
+			static const char* hex = "0123456789abcdef";
+			out.clear();
+			for (unsigned i = 0; i < len; i++) { out += hex[md[i] >> 4]; out += hex[md[i] & 15]; }
+			return true;
+		}
+
+		bool CanInstall()
+		{
+#if BOOST_OS_WINDOWS
+			// the portable zip has no installation to update in place: it just points people to the new download
+			const char* base = SDL_GetBasePath();
+			std::error_code ec;
+			return !(base && fs::exists(fs::path(base) / "portable.txt", ec));
+#else
+			return false;
+#endif
+		}
+
+		HttpResponse Check()
+		{
+			const std::string current = AppVersion();
+			Json j;
+			j.w.StartObject();
+			j.KS("current", current);
+			std::string body;
+			Sink sink;
+			sink.text = &body;
+			long code = 0;
+			const CURLcode res = Get(std::string("https://api.github.com/repos/") + kRepo + "/releases/latest", sink, 12, code);
+			bool offline = false, available = false;
+			std::string err, latest, notes;
+			if (res != CURLE_OK)
+			{
+				offline = IsOfflineError(res);
+				err = curl_easy_strerror(res);
+			}
+			else if (code == 404)
+			{
+				// no release published yet: nothing to update to
+			}
+			else if (code != 200)
+			{
+				err = "GitHub answered HTTP " + std::to_string(code);
+			}
+			else
+			{
+				rapidjson::Document d;
+				d.Parse(body.c_str());
+				if (!d.HasParseError() && d.IsObject() && d.HasMember("tag_name") && d["tag_name"].IsString())
+				{
+					latest = d["tag_name"].GetString();
+					if (d.HasMember("body") && d["body"].IsString())
+						notes = d["body"].GetString();
+					std::string setupUrl, shaUrl;
+					if (d.HasMember("assets") && d["assets"].IsArray())
+						for (auto& a : d["assets"].GetArray())
+						{
+							if (!a.IsObject() || !a.HasMember("name") || !a["name"].IsString() || !a.HasMember("browser_download_url") || !a["browser_download_url"].IsString())
+								continue;
+							const std::string n = a["name"].GetString(), u = a["browser_download_url"].GetString();
+							if (n == kSetupAsset && UrlAllowed(u)) setupUrl = u;
+							if (n == kShaAsset && UrlAllowed(u)) shaUrl = u;
+						}
+					available = CmpVer(latest, current) > 0 && !setupUrl.empty() && !shaUrl.empty();
+					std::scoped_lock l(g_u.m);
+					g_u.latest = latest;
+					g_u.notes = notes;
+					g_u.setupUrl = setupUrl;
+					g_u.shaUrl = shaUrl;
+				}
+				else
+					err = "unreadable answer from GitHub";
+			}
+			j.KS("latest", latest);
+			j.KB("available", available);
+			j.KB("offline", offline);
+			j.KS("error", err);
+			j.KS("notes", notes.size() > 1500 ? notes.substr(0, 1500) : notes);
+			j.KB("canInstall", CanInstall());
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		void DownloadWorker(std::string setupUrl, std::string shaUrl, fs::path file)
+		{
+			std::error_code ec;
+			fs::create_directories(file.parent_path(), ec);
+			g_u.percent = 0;
+			SetStage("downloading");
+			{
+				std::ofstream out(file, std::ios::binary | std::ios::trunc);
+				if (!out)
+				{
+					SetStage("error", "can't write the update file");
+					g_u.working = false;
+					return;
+				}
+				Sink sink;
+				sink.file = &out;
+				sink.percent = &g_u.percent;
+				long code = 0;
+				const CURLcode res = Get(setupUrl, sink, 1800, code);
+				out.close();
+				if (res != CURLE_OK || code != 200)
+				{
+					SetStage("error", res != CURLE_OK ? std::string("download failed: ") + curl_easy_strerror(res) : "download failed (HTTP " + std::to_string(code) + ")");
+					fs::remove(file, ec);
+					g_u.working = false;
+					return;
+				}
+			}
+			SetStage("verifying");
+			std::string shaText;
+			{
+				Sink sink;
+				sink.text = &shaText;
+				long code = 0;
+				const CURLcode res = Get(shaUrl, sink, 60, code);
+				if (res != CURLE_OK || code != 200)
+				{
+					SetStage("error", "couldn't fetch the checksum");
+					fs::remove(file, ec);
+					g_u.working = false;
+					return;
+				}
+			}
+			std::string want = Trim(shaText).substr(0, 64);
+			for (auto& c : want) c = (char)std::tolower((unsigned char)c);
+			std::string got;
+			if (want.size() != 64 || !Sha256Hex(file, got) || got != want)
+			{
+				SetStage("error", "the download doesn't match its checksum, so it was discarded");
+				fs::remove(file, ec);
+				g_u.working = false;
+				return;
+			}
+			g_u.percent = 100;
+			SetStage("ready");
+			g_u.working = false;
+		}
+	} // namespace
+
+	std::string AppVersion()
+	{
+		static std::string v;
+		static std::once_flag once;
+		std::call_once(once, []
+		{
+			v = "dev";
+			const char* base = SDL_GetBasePath();
+			if (!base)
+				return;
+			std::ifstream in(fs::path(base) / "version.txt");
+			std::string line;
+			if (in && std::getline(in, line))
+			{
+				line = Trim(line);
+				if (!line.empty() && line.size() < 40)
+					v = line;
+			}
+		});
+		return v;
+	}
+
+	HttpResponse HandleUpdate(const HttpRequest& req, const std::string& sub)
+	{
+		const bool post = req.method == "POST";
+		if (sub == "/check")
+			return Check();
+		if (sub == "/status")
+		{
+			Json j;
+			j.w.StartObject();
+			std::scoped_lock l(g_u.m);
+			j.KS("stage", g_u.stage);
+			j.KI("percent", g_u.percent.load());
+			j.KS("message", g_u.message);
+			j.KS("latest", g_u.latest);
+			j.w.EndObject();
+			return Ok(j);
+		}
+		if (sub == "/install" && post)
+		{
+			if (!CanInstall())
+				return Err(400, "automatic updates are only available in the Windows build");
+			std::string setupUrl, shaUrl;
+			{
+				std::scoped_lock l(g_u.m);
+				setupUrl = g_u.setupUrl;
+				shaUrl = g_u.shaUrl;
+			}
+			if (setupUrl.empty() || shaUrl.empty())
+				return Err(409, "check for updates first");
+			if (g_u.working.exchange(true))
+				return OkSimple();
+			const fs::path file = ActiveSettings::GetUserDataPath() / "update" / kSetupAsset;
+			std::thread(DownloadWorker, setupUrl, shaUrl, file).detach();
+			{
+				std::scoped_lock l(g_u.m);
+				g_u.file = file;
+			}
+			return OkSimple();
+		}
+		if (sub == "/apply" && post)
+		{
+			fs::path file;
+			{
+				std::scoped_lock l(g_u.m);
+				if (g_u.stage != "ready")
+					return Err(409, "update isn't downloaded yet");
+				file = g_u.file;
+			}
+#if BOOST_OS_WINDOWS
+			// Run the installer through cmd so we can (a) log what it does and (b) bring the old version back if it fails.
+			// /FORCECLOSEAPPLICATIONS makes Inno Setup close NEBULATOR itself instead of waiting for it. The installer's own
+			// "Launch NEBULATOR" step reopens the new version.
+			wchar_t exePath[MAX_PATH]{};
+			GetModuleFileNameW(nullptr, exePath, MAX_PATH);
+			const fs::path logFile = file.parent_path() / "setup.log";
+			// install over the copy that is running right now, wherever it lives (installed, portable or moved), so the version
+			// that keeps asking for the update is the one that actually gets replaced
+			const fs::path appDir = fs::path(exePath).parent_path();
+			std::wstring cmd = L"cmd.exe /d /s /c \"\"" + file.wstring() + L"\" /VERYSILENT /SUPPRESSMSGBOXES /NORESTART /CLOSEAPPLICATIONS /FORCECLOSEAPPLICATIONS /DIR=\"" + appDir.wstring() + L"\" /LOG=\"" + logFile.wstring() +
+							   L"\" & if errorlevel 1 start \"\" \"" + exePath + L"\"\"";
+			STARTUPINFOW si{};
+			si.cb = sizeof(si);
+			si.dwFlags = STARTF_USESHOWWINDOW;
+			si.wShowWindow = SW_HIDE;
+			PROCESS_INFORMATION pi{};
+			if (!CreateProcessW(nullptr, cmd.data(), nullptr, nullptr, FALSE, CREATE_NO_WINDOW | CREATE_NEW_PROCESS_GROUP, nullptr, nullptr, &si, &pi))
+				return Err(500, "couldn't start the installer");
+			CloseHandle(pi.hThread);
+			CloseHandle(pi.hProcess);
+			RequestQuit(true);
+			// make sure we really go away so the installer can replace our files, even if the normal shutdown hangs
+			std::thread([] {
+				std::this_thread::sleep_for(std::chrono::seconds(4));
+				TerminateProcess(GetCurrentProcess(), 0);
+			}).detach();
+			return OkSimple();
+#else
+			return Err(400, "automatic updates are only available in the Windows build");
+#endif
+		}
+		return Err(404, "no such route");
+	}
+} // namespace ControlApi
diff --git a/src/gui/sdlgui/CoopRemote.h b/src/gui/sdlgui/CoopRemote.h
new file mode 100644
