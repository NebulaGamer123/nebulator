+	std::string FirstDifferentRegion(const std::string& a, const std::string& b)
+	{
+		const size_t n = std::min(a.size(), b.size()) / 4;
+		for (size_t i = 0; i < n; i++)
+			if (memcmp(a.data() + i * 4, b.data() + i * 4, 4) != 0)
+			{
+				char buf[96];
+				snprintf(buf, sizeof(buf), "game memory at 0x%08X-0x%08X", (unsigned)(mmuRange_MEM2.getBase() + (i << 20)), (unsigned)(mmuRange_MEM2.getBase() + ((i + 1) << 20) - 1));
+				return buf;
+			}
+		return "unknown";
+	}
