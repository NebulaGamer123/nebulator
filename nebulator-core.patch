+	void RefreshSizes()
+	{
+		int w = 0, h = 0, pw = 0, ph = 0;
+		SDL_GetWindowSize(g_window, &w, &h);
+		SDL_GetWindowSizeInPixels(g_window, &pw, &ph);
+		g_window_info.width = w;
+		g_window_info.height = h;
+		g_window_info.phys_width = pw;
+		g_window_info.phys_height = ph;
+		float scale = SDL_GetWindowDisplayScale(g_window);
+		g_window_info.dpi_scale = scale > 0.0f ? scale : 1.0f;
+	}
+
+	WindowSystem::WindowHandleInfo GetNativeHandle(SDL_Window* window)
+	{
+		WindowSystem::WindowHandleInfo info{};
+		SDL_PropertiesID props = SDL_GetWindowProperties(window);
+#if BOOST_OS_WINDOWS
+		info.backend = WindowSystem::WindowHandleInfo::Backend::Windows;
+		info.surface = SDL_GetPointerProperty(props, SDL_PROP_WINDOW_WIN32_HWND_POINTER, nullptr);
+#elif BOOST_OS_LINUX || BOOST_OS_BSD
+		const char* driver = SDL_GetCurrentVideoDriver();
+		if (driver && std::string_view(driver) == "wayland")
+		{
+			info.backend = WindowSystem::WindowHandleInfo::Backend::Wayland;
+			info.display = SDL_GetPointerProperty(props, SDL_PROP_WINDOW_WAYLAND_DISPLAY_POINTER, nullptr);
+			info.surface = SDL_GetPointerProperty(props, SDL_PROP_WINDOW_WAYLAND_SURFACE_POINTER, nullptr);
+		}
+		else
+		{
+			info.backend = WindowSystem::WindowHandleInfo::Backend::X11;
+			info.display = SDL_GetPointerProperty(props, SDL_PROP_WINDOW_X11_DISPLAY_POINTER, nullptr);
+			info.surface = reinterpret_cast<void*>((uintptr_t)SDL_GetNumberProperty(props, SDL_PROP_WINDOW_X11_WINDOW_NUMBER, 0));
+		}
+#endif
+		return info;
+	}
