+void WindowSystem::UpdateWindowTitles(bool isIdle, bool isLoading, double fps)
+{
+	std::string t = "NEBULATOR";
+	if (!isIdle)
+	{
+		if (isLoading)
+			t += " - Loading...";
+		else
+			t += fmt::format(" - {} - {:.1f} FPS", CafeSystem::GetForegroundTitleName(), fps);
+	}
+	std::scoped_lock lock(g_titleMutex);
+	if (t != g_pendingTitle)
