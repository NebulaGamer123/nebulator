-void wxGameList::RequestLoadIconAsync(TitleId titleId)
-{
-	m_async_worker_mutex.lock();
-	m_icon_load_queue.push_back(titleId);
-	m_async_worker_mutex.unlock();
-	m_async_task_count.increment();
-}
