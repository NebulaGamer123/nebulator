+// Graphic packs API: list, enable/disable, presets, download of the community pack.
+
+#include "ControlApi.h"
+
+#include "config/ActiveSettings.h"
+#include "config/CemuConfig.h"
+#include "Cafe/GraphicPack/GraphicPack2.h"
+#include "Common/FileStream.h"
+
+#include <curl/curl.h>
+#include <zip.h>
+#include <atomic>
+#include <mutex>
+#include <thread>
+
+namespace ControlApi
+{
+	namespace
+	{
+		struct Download
+		{
+			std::mutex m;
+			std::atomic_bool running{false};
+			std::atomic<int> percent{0};
+			std::string stage = "idle"; // idle, checking, downloading, extracting, done, error
+			std::string message;
+			std::thread worker;
+		} g_dl;
+
+		void SetStage(const std::string& s, const std::string& msg = {})
+		{
+			std::scoped_lock l(g_dl.m);
+			g_dl.stage = s;
+			g_dl.message = msg;
+		}
+
+		struct Buf
+		{
+			std::vector<uint8> data;
+			std::atomic<int>* percent = nullptr;
+		};
+
+		size_t Write(void* ptr, size_t size, size_t n, Buf* b)
+		{
+			const uint8* p = (const uint8*)ptr;
+			b->data.insert(b->data.end(), p, p + size * n);
+			return size * n;
+		}
+		int Progress(Buf* b, curl_off_t total, curl_off_t now, curl_off_t, curl_off_t)
+		{
+			if (b->percent && total > 0)
+				*b->percent = (int)(now * 100 / total);
+			return 0;
+		}
+
+		bool Fetch(const std::string& url, Buf& buf)
+		{
+			CURL* curl = curl_easy_init();
+			if (!curl)
+				return false;
+			curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+			curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, Write);
+			curl_easy_setopt(curl, CURLOPT_WRITEDATA, &buf);
+			curl_easy_setopt(curl, CURLOPT_XFERINFOFUNCTION, Progress);
+			curl_easy_setopt(curl, CURLOPT_XFERINFODATA, &buf);
+			curl_easy_setopt(curl, CURLOPT_NOPROGRESS, 0L);
+			curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+			curl_easy_setopt(curl, CURLOPT_SSL_VERIFYHOST, 2L);
+			curl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, 1L);
+			curl_easy_setopt(curl, CURLOPT_SSL_OPTIONS, CURLSSLOPT_NATIVE_CA);
+			curl_easy_setopt(curl, CURLOPT_USERAGENT, "NEBULATOR");
+			curl_easy_setopt(curl, CURLOPT_TIMEOUT, 300L);
+			const CURLcode res = curl_easy_perform(curl);
+			long code = 0;
+			curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &code);
+			curl_easy_cleanup(curl);
+			return res == CURLE_OK && code >= 200 && code < 300;
+		}
+
+		void DownloadWorker()
+		{
+			const fs::path root = ActiveSettings::GetUserDataPath("graphicPacks/downloadedGraphicPacks");
+			try
+			{
+				SetStage("checking");
+				g_dl.percent = 0;
+				Buf meta;
+				if (!Fetch("https://api.github.com/repos/cemu-project/cemu_graphic_packs/releases/latest", meta))
+				{
+					SetStage("error", "Couldn't reach GitHub.");
+					g_dl.running = false;
+					return;
+				}
+				rapidjson::Document d;
+				d.Parse((const char*)meta.data.data(), meta.data.size());
+				if (d.HasParseError() || !d.IsObject() || !d.HasMember("assets") || !d["assets"].IsArray() || d["assets"].Empty() ||
+					!d["assets"][0].IsObject() || !d["assets"][0].HasMember("browser_download_url") || !d["assets"][0]["browser_download_url"].IsString())
+				{
+					SetStage("error", "Unexpected answer from GitHub.");
+					g_dl.running = false;
+					return;
+				}
+				const std::string url = d["assets"][0]["browser_download_url"].GetString();
+				const std::string version = d.HasMember("name") && d["name"].IsString() ? d["name"].GetString() : "";
+				if (url.rfind("https://", 0) != 0)
+				{
+					SetStage("error", "Refusing a non-HTTPS download link.");
+					g_dl.running = false;
+					return;
+				}
+
+				SetStage("downloading");
+				Buf zipData;
+				zipData.percent = &g_dl.percent;
+				if (!Fetch(url, zipData))
+				{
+					SetStage("error", "The download failed.");
+					g_dl.running = false;
+					return;
+				}
+
+				SetStage("extracting");
+				g_dl.percent = 0;
+				zip_error_t error;
+				zip_error_init(&error);
+				zip_source_t* src = zip_source_buffer_create(zipData.data.data(), zipData.data.size(), 0, &error);
+				if (!src)
+				{
+					zip_error_fini(&error);
+					SetStage("error", "Bad archive.");
+					g_dl.running = false;
+					return;
+				}
+				zip_t* za = zip_open_from_source(src, 0, &error);
+				if (!za)
+				{
+					zip_source_free(src);
+					zip_error_fini(&error);
+					SetStage("error", "Bad archive.");
+					g_dl.running = false;
+					return;
+				}
+				std::error_code ec;
+				if (fs::exists(root, ec))
+					for (auto& p : fs::directory_iterator(root, ec))
+						fs::remove_all(p.path(), ec);
+				fs::create_directories(root, ec);
+
+				const zip_int64_t entries = zip_get_num_entries(za, 0);
+				for (zip_int64_t i = 0; i < entries; i++)
+				{
+					g_dl.percent = (int)(i * 100 / std::max<zip_int64_t>(entries, 1));
+					zip_stat_t sb;
+					zip_stat_init(&sb);
+					if (zip_stat_index(za, i, 0, &sb) != 0 || !(sb.valid & ZIP_STAT_NAME))
+						continue;
+					const std::string name = sb.name;
+					if (name.empty() || name.find("..") != std::string::npos || name[0] == '/' || name.find('\\') != std::string::npos || name.find(':') != std::string::npos)
+						continue;
+					const fs::path out = root / _utf8ToPath(name);
+					if (name.back() == '/')
+					{
+						fs::create_directories(out, ec);
+						continue;
+					}
+					if (!(sb.valid & ZIP_STAT_SIZE) || sb.size == 0 || sb.size > 128u * 1024 * 1024)
+						continue;
+					zip_file_t* zf = zip_fopen_index(za, i, 0);
+					if (!zf)
+						continue;
+					std::vector<uint8> bytes(sb.size);
+					if ((zip_uint64_t)zip_fread(zf, bytes.data(), sb.size) == sb.size)
+					{
+						fs::create_directories(out.parent_path(), ec);
+						std::ofstream f(out, std::ios::binary);
+						f.write((const char*)bytes.data(), (std::streamsize)bytes.size());
+					}
+					zip_fclose(zf);
+				}
+				zip_discard(za);
+				zip_error_fini(&error);
+				{
+					std::ofstream v(root / "version.txt");
+					v << version;
+				}
+				GraphicPack2::ClearGraphicPacks();
+				GraphicPack2::LoadAll();
+				g_dl.percent = 100;
+				SetStage("done", version);
+			}
+			catch (const std::exception& ex)
+			{
+				SetStage("error", ex.what());
+			}
+			g_dl.running = false;
+		}
+
+		void SaveStateToConfig()
+		{
+			auto& data = GetConfigHandle().data();
+			data.graphic_pack_entries.clear();
+			for (const auto& gp : GraphicPack2::GetGraphicPacks())
+			{
+				auto filename = _utf8ToPath(gp->GetNormalizedPathString());
+				if (gp->IsEnabled())
+				{
+					auto& it = data.graphic_pack_entries[filename];
+					for (const auto& preset : gp->GetActivePresets())
+						it.try_emplace(preset->category, preset->name);
+				}
+				else if (gp->IsDefaultEnabled())
+				{
+					data.graphic_pack_entries[filename].try_emplace("_disabled", "false");
+				}
+			}
+			GetConfigHandle().Save();
+		}
+
+		std::shared_ptr<GraphicPack2> FindPack(const std::string& id)
+		{
+			for (const auto& gp : GraphicPack2::GetGraphicPacks())
+				if (gp->GetNormalizedPathString() == id)
+					return gp;
+			return {};
+		}
+
+		HttpResponse List()
+		{
+			Json j;
+			j.w.StartObject();
+			{
+				std::ifstream v(ActiveSettings::GetUserDataPath("graphicPacks/downloadedGraphicPacks/version.txt"));
+				std::string ver;
+				std::getline(v, ver);
+				j.KS("downloadedVersion", ver);
+			}
+			j.K("packs");
+			j.w.StartArray();
+			for (const auto& gp : GraphicPack2::GetGraphicPacks())
+			{
+				j.w.StartObject();
+				j.KS("id", gp->GetNormalizedPathString());
+				j.KS("name", gp->GetName());
+				j.KS("path", gp->GetVirtualPath());
+				j.KS("description", gp->GetDescription());
+				j.KB("enabled", gp->IsEnabled());
+				j.K("titleIds");
+				j.w.StartArray();
+				for (auto t : gp->GetTitleIds())
+					j.S(HexId(t));
+				j.w.EndArray();
+				j.K("presets");
+				j.w.StartArray();
+				std::vector<std::string> order;
+				auto categorized = gp->GetCategorizedPresets(order);
+				for (const auto& cat : order)
+				{
+					const auto& list = categorized[cat];
+					bool anyVisible = false;
+					for (auto& p : list)
+						if (p->visible) anyVisible = true;
+					if (!anyVisible)
+						continue;
+					j.w.StartObject();
+					j.KS("category", cat);
+					j.KS("active", gp->GetActivePreset(cat));
+					j.K("options");
+					j.w.StartArray();
+					for (auto& p : list)
+						if (p->visible)
+							j.S(p->name);
+					j.w.EndArray();
+					j.w.EndObject();
+				}
+				j.w.EndArray();
+				j.w.EndObject();
+			}
+			j.w.EndArray();
+			j.w.EndObject();
+			return Ok(j);
+		}
+
+		HttpResponse DownloadStatus()
+		{
+			Json j;
+			j.w.StartObject();
+			std::scoped_lock l(g_dl.m);
+			j.KS("stage", g_dl.stage);
+			j.KS("message", g_dl.message);
+			j.KI("percent", g_dl.percent);
+			j.KB("running", g_dl.running);
+			j.w.EndObject();
+			return Ok(j);
+		}
+	} // namespace
+
+	HttpResponse HandleGfx(const HttpRequest& req, const std::string& sub)
+	{
+		const bool post = req.method == "POST";
+		if (sub.empty())
+			return List();
+		if (sub == "/download")
+		{
+			if (!post)
+				return DownloadStatus();
+			if (GetState() != State::Ui)
+				return Err(409, "stop the game first");
+			if (g_dl.running.exchange(true))
+				return Err(409, "already running");
+			if (g_dl.worker.joinable())
+				g_dl.worker.join();
+			SetStage("checking");
+			g_dl.worker = std::thread(DownloadWorker);
+			return OkSimple();
+		}
+		if (!post)
+			return Err(405, "method not allowed");
+		if (GetState() != State::Ui)
+			return Err(409, "graphics packs can only be changed outside a game");
+		rapidjson::Document d;
+		if (!ParseBody(req, d))
+			return Err(400, "invalid json");
+		if (sub == "/set")
+		{
+			auto gp = FindPack(GetStr(d, "id"));
+			if (!gp)
+				return Err(404, "pack not found");
+			if (Has(d, "enabled"))
+				gp->SetEnabled(GetBool(d, "enabled"));
+			if (Has(d, "preset"))
+			{
+				if (!gp->SetActivePreset(GetStr(d, "category"), GetStr(d, "preset")))
+					return Err(400, "bad preset");
+				gp->UpdatePresetVisibility();
+			}
+			SaveStateToConfig();
+			return List();
+		}
+		if (sub == "/reload")
+		{
+			GraphicPack2::ClearGraphicPacks();
+			GraphicPack2::LoadAll();
+			return List();
+		}
+		return Err(404, "unknown route");
+	}
+} // namespace ControlApi
