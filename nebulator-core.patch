+#pragma once
+// Translation between SDL keycodes, the platform key codes the core's KeyboardController uses
+// (Windows: VK_*, Linux: X11 keysyms) and human readable key names.
+
+#include <SDL3/SDL.h>
+#include <string>
+#include <vector>
+
+namespace SdlKeys
+{
+	struct KeyDef
+	{
+		SDL_Keycode sdl;
+		uint32 vk; // Windows virtual key
+		uint32 xk; // X11 keysym
+	};
+
+	inline const std::vector<KeyDef>& Table()
+	{
+		static const std::vector<KeyDef> table = []
+		{
+			std::vector<KeyDef> t = {
+				{SDLK_LEFT, 0x25, 0xFF51}, {SDLK_UP, 0x26, 0xFF52}, {SDLK_RIGHT, 0x27, 0xFF53}, {SDLK_DOWN, 0x28, 0xFF54},
+				{SDLK_RETURN, 0x0D, 0xFF0D}, {SDLK_ESCAPE, 0x1B, 0xFF1B}, {SDLK_TAB, 0x09, 0xFF09},
+				{SDLK_BACKSPACE, 0x08, 0xFF08}, {SDLK_SPACE, 0x20, 0x20},
+				{SDLK_LSHIFT, 0xA0, 0xFFE1}, {SDLK_RSHIFT, 0xA1, 0xFFE2}, {SDLK_LCTRL, 0xA2, 0xFFE3},
+				{SDLK_RCTRL, 0xA3, 0xFFE4}, {SDLK_LALT, 0xA4, 0xFFE9}, {SDLK_RALT, 0xA5, 0xFFEA},
+				{SDLK_INSERT, 0x2D, 0xFF63}, {SDLK_DELETE, 0x2E, 0xFFFF}, {SDLK_HOME, 0x24, 0xFF50},
+				{SDLK_END, 0x23, 0xFF57}, {SDLK_PAGEUP, 0x21, 0xFF55}, {SDLK_PAGEDOWN, 0x22, 0xFF56},
+				{SDLK_MINUS, 0xBD, 0x2D}, {SDLK_EQUALS, 0xBB, 0x3D}, {SDLK_LEFTBRACKET, 0xDB, 0x5B},
+				{SDLK_RIGHTBRACKET, 0xDD, 0x5D}, {SDLK_BACKSLASH, 0xDC, 0x5C}, {SDLK_SEMICOLON, 0xBA, 0x3B},
+				{SDLK_APOSTROPHE, 0xDE, 0x27}, {SDLK_COMMA, 0xBC, 0x2C}, {SDLK_PERIOD, 0xBE, 0x2E},
+				{SDLK_SLASH, 0xBF, 0x2F}, {SDLK_GRAVE, 0xC0, 0x60},
+			};
+			for (int i = 0; i < 12; i++)
+				t.push_back({SDLK_F1 + (SDL_Keycode)i, 0x70u + i, 0xFFBEu + i});
+			const SDL_Keycode kp[10] = {SDLK_KP_0, SDLK_KP_1, SDLK_KP_2, SDLK_KP_3, SDLK_KP_4,
+										SDLK_KP_5, SDLK_KP_6, SDLK_KP_7, SDLK_KP_8, SDLK_KP_9};
+			for (int i = 0; i < 10; i++)
+				t.push_back({kp[i], 0x60u + i, 0xFFB0u + i});
+			return t;
+		}();
+		return table;
+	}
+
+	// SDL keycode -> platform key code (0 if the key is not supported)
+	inline uint32 NativeFromSdl(SDL_Keycode k)
+	{
+		if (k >= 'a' && k <= 'z')
+		{
+#if BOOST_OS_WINDOWS
+			return 'A' + (uint32)(k - 'a');
+#else
+			return (uint32)k;
+#endif
+		}
+		if (k >= '0' && k <= '9')
+			return (uint32)k;
+		for (const auto& d : Table())
+			if (d.sdl == k)
+			{
+#if BOOST_OS_WINDOWS
+				return d.vk;
+#else
+				return d.xk;
+#endif
+			}
+		return 0;
+	}
+
+	// platform key code -> readable name ("W", "Left", "Space", ...)
+	inline std::string NameFromNative(uint32 key)
+	{
+		if (key >= '0' && key <= '9')
+			return std::string(1, (char)key);
+#if BOOST_OS_WINDOWS
+		if (key >= 'A' && key <= 'Z')
+			return std::string(1, (char)key);
+#else
+		if (key >= 'a' && key <= 'z')
+			return std::string(1, (char)(key - 'a' + 'A'));
+#endif
+		for (const auto& d : Table())
+		{
+#if BOOST_OS_WINDOWS
+			if (d.vk == key)
+#else
+			if (d.xk == key)
+#endif
+				return SDL_GetKeyName(d.sdl);
+		}
+		return fmt::format("key_{}", key);
+	}
+
+	// name as produced by SDL_GetKeyName / the UI ("W", "Up", "Left Shift") -> platform key code
+	inline uint32 NativeFromName(const std::string& name)
+	{
+		SDL_Keycode k = SDL_GetKeyFromName(name.c_str());
+		if (k == SDLK_UNKNOWN)
+			return 0;
+		return NativeFromSdl(k);
+	}
+} // namespace SdlKeys
