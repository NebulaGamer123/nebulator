-	const auto& [address, symbol] = *m_visible_items[item];
-	if (column == ColumnName)
-		return symbol.name;
-	if (column == ColumnAddress)
-		return wxString::Format("%08x", address);
-	if (column == ColumnModule)
-		return symbol.libName;
-
-	return wxEmptyString;
