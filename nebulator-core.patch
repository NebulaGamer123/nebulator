diff --git a/src/gui/sdlgui/Lockstep.h b/src/gui/sdlgui/Lockstep.h
new file mode 100644
index 0000000..809aa2a
--- /dev/null
+++ b/src/gui/sdlgui/Lockstep.h
@@ -0,0 +1,87 @@
+#pragma once
+// Lockstep netplay engine (experimental).
+// Every player runs the game locally; only controller inputs are exchanged. For that to work the emulation must behave
+// identically on every PC, so while a lockstep session is active:
+//  - emulated time comes from executed cycles (virtual clock), never from the host clock
+//  - the CPU runs single-core with synchronous recompilation
+//  - the GPU thread only runs inside a short window at every 1/60 s tick, while the CPU is parked
+//  - IOSU replies are collected and delivered at the tick in a fixed order
+//  - vsync, audio frames and the RTC come from the virtual clock / the session
+#include <atomic>
+#include <cstdint>
+#include <string>
+
+namespace Lockstep
+{
+	extern std::atomic<bool> g_active;
+	inline bool Active() { return g_active.load(std::memory_order_relaxed); }
+
+	struct PadState
+	{
+		uint32_t buttons = 0; // bit i = Pro Controller button id (i + 1)
+		int8_t lx = 0, ly = 0, rx = 0, ry = 0; // up = negative y
+		bool operator==(const PadState& o) const { return buttons == o.buttons && lx == o.lx && ly == o.ly && rx == o.rx && ry == o.ry; }
+	};
+
+	constexpr int kMaxPlayers = 4;
+	constexpr int kTicksPerSecondNum = 60000, kTicksPerSecondDen = 1001; // 59.94 Hz
+
+	// ---- virtual clock (CPU side) ----
+	uint64_t VirtualCycles();
+	void SliceBegin(int32_t startRemaining); // a PPC thread got a timeslice
+	void SliceEnd(int32_t remainingNow); // the timeslice ended
+	void DbgWhere(const char* where); // diagnostics: which step the scheduler is in (string literal)
+	void IdleStep(); // nothing runnable: let time pass
+	void OnSystemEvents(); // main core idle loop, scheduler lock NOT held: runs the per-tick protocol
+	bool UseAudioClock(uint64_t& nextAxCycles); // AX: true when a 3 ms virtual interval elapsed
+
+	// ---- GPU gate ----
+	uint32_t GpuLimit(); // ring index the GPU may read up to
+	bool GpuGated(); // false once the engine gave up gating a graphics thread that never answered
+	void GpuPoll(); // GPU thread: called from every wait/idle loop iteration; parks until the next window
+
+	// ---- IOSU replies ----
+	void IpcSubmitted(void* originalBody);
+	bool IpcReplyDeferred(uint32_t coreIndex, void* originalBody); // true = Lockstep took the reply and will deliver it
+
+	// ---- diagnostics ----
+	void DbgCompiled(uint64_t micros); // a function was recompiled synchronously (lockstep forces this)
+
+	// ---- misc ----
+	uint64_t AgreedUnixTime(); // seconds, identical on every PC of the session
+	bool InterpreterOnly();
+	void SessionStarting(); // called right before the game is launched
+	void GameStopped(); // called when the game window closes
+	void Init(const std::string& dataDir);
+	void SetAgreedUnixTime(uint64_t seconds);
+	void SetInterpreterOnly(bool v);
+
+	// ---- net -> core interface (implemented by the core, called by LockstepNet) ----
+	struct HashReport
+	{
+		uint32_t tick = 0;
+		uint64_t total = 0;
+		std::string chunks; // 4 bytes per 1 MiB of MEM2
+	};
+	std::string FirstDifferentRegion(const std::string& a, const std::string& b);
+
+	// ---- core -> net interface (implemented by LockstepNet) ----
+	namespace Net
+	{
+		enum class Mode { Off, Session, LabRecord, LabReplay };
+		Mode GetMode();
+		int LocalSlot();
+		int PlayerCount();
+		int InputDelay();
+		int HashEvery();
+		void SendInput(uint32_t tick, const PadState& p);
+		// blocks (up to a long timeout) until inputs of all players for this tick are present; false = session is gone
+		bool WaitInputs(uint32_t tick, PadState out[kMaxPlayers], int64_t& waitedMs);
+		void SendHash(const HashReport& r);
+		void LabInput(uint32_t tick, PadState& slot0, bool record); // record: stores slot0, replay: fills it
+		void LabHash(const HashReport& r);
+		void Log(const std::string& s);
+		void Stats(uint32_t tick, uint32_t stalls, uint32_t impure, const std::string& waitingFor);
+		uint32_t PingMs();
+	} // namespace Net
+} // namespace Lockstep
diff --git a/src/gui/sdlgui/LockstepCore.cpp b/src/gui/sdlgui/LockstepCore.cpp
new file mode 100644
index 0000000..5c942c1
--- /dev/null
+++ b/src/gui/sdlgui/LockstepCore.cpp
@@ -0,0 +1,641 @@
+// Lockstep engine, CPU/GPU/IOSU side. See Lockstep.h for the overall idea.
+#include "Lockstep.h"
+#include "CoopRemote.h"
+
+#include "Cafe/OS/common/OSCommon.h"
+#include "Cafe/HW/Espresso/PPCState.h"
+#include "Cafe/HW/Espresso/Const.h"
+#include "Cafe/HW/MMU/MMU.h"
+#include "Cafe/HW/Latte/Core/Latte.h"
+#include "Cafe/OS/libs/coreinit/coreinit_IPC.h"
+#include "Cafe/OS/libs/coreinit/coreinit_Thread.h"
+#include "input/InputManager.h"
+#include "input/emulated/ProController.h"
+#include "input/emulated/VPADController.h"
+#include "config/ActiveSettings.h"
+#include <fstream>
+
+#include <chrono>
+#include <condition_variable>
+#include <map>
+#include <mutex>
+#include <thread>
+#include <unordered_map>
+
+void LatteTiming_signalVsync();
+namespace TCL
+{
+	uint32 TCLGetRingWriteIndex();
+	uint32 TCLGetRingReadIndex();
+}
+
+namespace Lockstep
+{
+	std::atomic<bool> g_active{false};
+
+	namespace
+	{
+		using Clock = std::chrono::steady_clock;
+		constexpr uint64_t kCoreClock = Espresso::CORE_CLOCK;
+		// one tick = one vsync = 1001/60000 s of virtual time
+		constexpr uint64_t kTickCycles = kCoreClock * 1001ull / 60000ull;
+		constexpr uint64_t kIdleStep = kCoreClock / 10000ull; // 0.1 ms
+		constexpr uint64_t kCpuShare = 3; // three emulated cores take turns on one host thread
+
+		// ---------------------------------------------------------------- virtual clock
+		std::atomic<uint64_t> g_cycNum{0}; // executed core cycles of all slices (undivided)
+		int32_t g_sliceStart = 0;
+		bool g_inSlice = false;
+		std::atomic<uint64_t> g_unixTime{0};
+		std::atomic<bool> g_interpOnly{false};
+
+		// ---------------------------------------------------------------- tick state (PPC main thread only)
+		bool g_started = false;
+		uint32_t g_tick = 0;
+		uint64_t g_nextTickV = 0;
+		Clock::time_point g_deadline;
+		uint32_t g_stalls = 0, g_impure = 0;
+		std::shared_ptr<EmulatedController> g_local;
+		std::shared_ptr<CoopRemote> g_pads[kMaxPlayers];
+
+		// ---------------------------------------------------------------- GPU gate
+		std::atomic<uint32_t> g_epoch{0};
+		std::atomic<uint32_t> g_gpuLimit{0};
+		std::atomic<uint32_t> g_gpuSeen{0xFFFFFFFFu};
+		std::atomic<bool> g_gpuAlive{false};
+		uint32_t g_gpuPrev = 0; // GPU thread only
+
+		std::atomic<bool> g_gpuUngated{false}; // the graphics thread never answered: stop gating it so the game can at least run
+		uint32_t g_gpuMisses = 0;
+
+		// ---------------------------------------------------------------- diagnostics (watchdog thread + engine.log)
+		std::atomic<uint64_t> g_dbgSys{0}, g_dbgIdle{0}, g_dbgSlices{0}, g_dbgWin{0}, g_dbgPoll{0};
+		std::atomic<uint32_t> g_dbgTick{0};
+	std::atomic<const char*> g_dbgWhere{"boot"};
+	std::atomic<uint32_t> g_dbgThrEntry{0}, g_dbgThrPc{0}, g_dbgThrLr{0};
+	std::atomic<const char*> g_dbgThrName{""};
+	std::atomic<PPCInterpreter_t*> g_dbgCpu{nullptr};
+		std::atomic<uint64_t> g_dbgCompiles{0}, g_dbgCompileUs{0};
+		std::atomic<bool> g_dbgRun{false};
+		std::thread g_dbgThread;
+		std::mutex g_dbgLogM;
+
+		void EngineLog(const std::string& line, bool toUi)
+		{
+			{
+				std::scoped_lock l(g_dbgLogM);
+				try
+				{
+					const fs::path dir = ActiveSettings::GetUserDataPath() / "lockstep";
+					std::error_code ec;
+					fs::create_directories(dir, ec);
+					std::ofstream f(dir / "engine.log", std::ios::app);
+					f << line << "\n";
+				}
+				catch (...)
+				{
+				}
+			}
+			if (toUi)
+				Net::Log(line);
+		}
+
+		// ---------------------------------------------------------------- IOSU replies
+		struct IpcEntry
+		{
+			Clock::time_point submitted;
+			bool done = false, exempt = false;
+			uint32_t core = 0;
+			void* body = nullptr;
+		};
+		std::mutex g_ipcM;
+		std::condition_variable g_ipcCv;
+		std::map<uint64_t, IpcEntry> g_ipc;
+		std::unordered_map<void*, uint64_t> g_ipcByBody;
+		uint64_t g_ipcSeq = 0;
+
+		inline uint64_t Mix(uint64_t h, uint64_t w)
+		{
+			h ^= w;
+			h *= 0x9E3779B97F4A7C15ull;
+			return h ^ (h >> 32);
+		}
+
+		// ---------------------------------------------------------------- local input
+		PadState Sample()
+		{
+			PadState p;
+			if (!g_local)
+				return p;
+			g_local->controllers_update_states();
+			const bool vpad = g_local->type() == EmulatedController::VPAD;
+			const int maxId = vpad ? 16 : 17;
+			for (int id = 1; id <= maxId; id++)
+			{
+				if (!g_local->is_mapping_down((uint64)id))
+					continue;
+				int proId = id;
+				if (vpad && id >= 11) // VPAD: Up Down Left Right sit one id earlier than on the Pro controller (Home comes between)
+					proId = id + 1;
+				p.buttons |= 1u << (proId - 1);
+			}
+			if (vpad && g_local->is_mapping_down((uint64)VPADController::kButtonId_Home))
+				p.buttons |= 1u << (ProController::kButtonId_Home - 1);
+			auto conv = [](float v) -> int8_t {
+				v = std::max(-1.0f, std::min(1.0f, v));
+				return (int8_t)std::lround(v * 127.0f);
+			};
+			const glm::vec2 a = g_local->get_axis(), r = g_local->get_rotation();
+			p.lx = conv(a.x);
+			p.ly = conv(-a.y);
+			p.rx = conv(r.x);
+			p.ry = conv(-r.y);
+			return p;
+		}
+
+		void AttachPads()
+		{
+			auto& im = InputManager::instance();
+			g_local = im.get_controller(0); // the player's own bindings (kept alive here even after the slot is replaced)
+			const int n = std::max(1, Net::PlayerCount());
+			for (int i = 0; i < n && i < kMaxPlayers; i++)
+			{
+				auto emu = im.set_controller((size_t)i, EmulatedController::Type::Pro);
+				if (!emu)
+					continue;
+				emu->clear_controllers();
+				emu->clear_mappings();
+				g_pads[i] = std::make_shared<CoopRemote>("lockstep-" + std::to_string(i), "Lockstep player " + std::to_string(i + 1));
+				emu->add_controller(g_pads[i]);
+				CoopRemote::ApplyMapping(emu, g_pads[i]);
+			}
+			if (!g_local)
+				Net::Log("No controller is bound to Player 1, so this PC cannot send any input. Bind one in the Controls tab.");
+		}
+
+		// ---------------------------------------------------------------- IOSU barrier
+		void DeliverIpc()
+		{
+			std::vector<std::pair<uint32_t, void*>> out;
+			{
+				std::unique_lock l(g_ipcM);
+				for (;;)
+				{
+					bool pending = false;
+					const auto now = Clock::now();
+					for (auto& [seq, e] : g_ipc)
+					{
+						if (e.done || e.exempt)
+							continue;
+						if (now - e.submitted > std::chrono::milliseconds(60))
+						{
+							e.exempt = true; // a request that waits for something outside our control (polling a device)
+							g_impure++;
+						}
+						else
+							pending = true;
+					}
+					if (!pending)
+						break;
+					g_ipcCv.wait_for(l, std::chrono::milliseconds(2));
+				}
+				for (auto it = g_ipc.begin(); it != g_ipc.end();)
+				{
+					if (it->second.done)
+					{
+						out.emplace_back(it->second.core, it->second.body);
+						g_ipcByBody.erase(it->second.body);
+						it = g_ipc.erase(it);
+					}
+					else
+						++it;
+				}
+			}
+			for (auto& [core, body] : out)
+			{
+				IPCCommandBody* arr[1] = {(IPCCommandBody*)body};
+				coreinit::IPCDriver_NotifyResponses(core, arr, 1);
+			}
+		}
+
+		// ---------------------------------------------------------------- GPU window
+		void GpuWindow()
+		{
+			const bool expectGpu = LatteGPUState.gx2InitCalled != 0;
+			if (!expectGpu || g_gpuUngated.load())
+				return;
+			g_dbgWin++;
+			g_gpuLimit.store(TCL::TCLGetRingWriteIndex(), std::memory_order_release);
+			const uint32_t e = g_epoch.fetch_add(1, std::memory_order_acq_rel) + 1;
+			const auto start = Clock::now();
+			// a graphics thread that has never answered gets only a short wait; one that is just busy (shader compiles) gets longer
+			const bool alive = g_gpuAlive.load();
+			const auto limit = std::chrono::milliseconds(alive ? 8000 : 400);
+			while (g_gpuSeen.load(std::memory_order_acquire) != e)
+			{
+				if (Clock::now() - start > limit)
+				{
+					g_impure++;
+					g_gpuMisses++;
+					if (g_gpuMisses <= 5 || g_gpuMisses % 50 == 0)
+						EngineLog("The graphics thread did not finish a frame in time (tick " + std::to_string(g_tick) + ", " + (alive ? "it was running" : "it has never answered") + ", miss #" + std::to_string(g_gpuMisses) + ")", true);
+					if (!alive && g_gpuMisses >= 3)
+					{
+						g_gpuUngated = true;
+						EngineLog("The graphics thread never reported in: running it without lockstep gating from now on. This session will NOT stay in sync.", true);
+					}
+					break;
+				}
+				std::this_thread::sleep_for(std::chrono::microseconds(15));
+			}
+		}
+
+		// ---------------------------------------------------------------- state fingerprint
+		HashReport ComputeHash(uint32_t tick)
+		{
+			HashReport r;
+			r.tick = tick;
+			const uint32_t base = mmuRange_MEM2.getBase();
+			const uint32_t size = mmuRange_MEM2.size;
+			const uint32_t chunks = size >> 20;
+			const uint32_t phase = (tick / (uint32_t)std::max(1, Net::HashEvery())) % 16;
+			const uint8_t* mem = memory_getPointerFromVirtualOffset(base);
+			r.chunks.resize((size_t)chunks * 4);
+			uint64_t total = Mix(0x1234567ull, VirtualCycles());
+			for (uint32_t c = 0; c < chunks; c++)
+			{
+				uint64_t h = 0xCBF29CE484222325ull + c;
+				for (uint32_t pg = phase; pg < 256; pg += 16)
+				{
+					const uint64_t* w = (const uint64_t*)(mem + ((size_t)c << 20) + (size_t)pg * 4096);
+					for (int i = 0; i < 512; i++)
+						h = Mix(h, w[i]);
+				}
+				const uint32_t h32 = (uint32_t)(h ^ (h >> 32));
+				memcpy(&r.chunks[(size_t)c * 4], &h32, 4);
+				total = Mix(total, h32);
+			}
+			r.total = total;
+			return r;
+		}
+
+		void Pace()
+		{
+			const auto period = std::chrono::nanoseconds(1000000000ll * kTicksPerSecondDen / kTicksPerSecondNum);
+			g_deadline += period;
+			const auto now = Clock::now();
+			if (g_deadline > now)
+				std::this_thread::sleep_until(g_deadline);
+			else if (now - g_deadline > std::chrono::milliseconds(200))
+				g_deadline = now; // far behind (slow PC): do not try to catch up
+		}
+
+		void DoTick()
+		{
+			const uint32_t N = g_tick;
+			const auto mode = Net::GetMode();
+			DbgWhere("tick: pace");
+			Pace();
+			DbgWhere("tick: input");
+
+			PadState all[kMaxPlayers];
+			const PadState local = Sample();
+			if (mode == Net::Mode::Session)
+			{
+				Net::SendInput(N + (uint32_t)Net::InputDelay(), local);
+				int64_t waited = 0;
+				if (!Net::WaitInputs(N, all, waited))
+					for (auto& p : all)
+						p = PadState{};
+				if (waited > 40)
+					g_stalls++;
+			}
+			else if (mode == Net::Mode::LabRecord)
+			{
+				all[0] = local;
+				Net::LabInput(N, all[0], true);
+			}
+			else if (mode == Net::Mode::LabReplay)
+				Net::LabInput(N, all[0], false);
+			else
+				all[0] = local;
+
+			for (int i = 0; i < kMaxPlayers; i++)
+				if (g_pads[i])
+					g_pads[i]->Set(all[i].buttons, all[i].lx, all[i].ly, all[i].rx, all[i].ry);
+
+			DbgWhere("tick: deliver ipc");
+			DeliverIpc();
+			DbgWhere("tick: signal vsync");
+			LatteTiming_signalVsync();
+			DbgWhere("tick: gpu window");
+			GpuWindow();
+			DbgWhere("tick: hash/stats");
+
+			const int every = std::max(1, Net::HashEvery());
+			if (N > 0 && (N % (uint32_t)every) == 0)
+			{
+				HashReport h = ComputeHash(N);
+				if (mode == Net::Mode::Session)
+					Net::SendHash(h);
+				else
+					Net::LabHash(h);
+			}
+			if ((N & 15) == 0)
+				Net::Stats(N, g_stalls, g_impure, "");
+			g_tick++;
+			DbgWhere("tick done");
+		}
+	} // namespace
+
+	// ======================================================================== public: clock
+	uint64_t VirtualCycles()
+	{
+		uint64_t used = 0;
+		if (g_inSlice)
+		{
+			if (auto* cpu = PPCInterpreter_getCurrentInstance())
+			{
+				const int64_t u = (int64_t)g_sliceStart - (int64_t)cpu->remainingCycles;
+				used = u > 0 ? (uint64_t)u : 0;
+			}
+		}
+		return (g_cycNum.load(std::memory_order_relaxed) + used) / kCpuShare;
+	}
+
+	void SliceBegin(int32_t startRemaining)
+	{
+		g_dbgSlices.fetch_add(1, std::memory_order_relaxed);
+		g_sliceStart = startRemaining;
+		g_inSlice = true;
+		DbgWhere("guest slice");
+		if (auto* cpu = PPCInterpreter_getCurrentInstance())
+		{
+			g_dbgCpu.store(cpu, std::memory_order_relaxed);
+			g_dbgThrPc.store(cpu->instructionPointer, std::memory_order_relaxed);
+			g_dbgThrLr.store(cpu->spr.LR, std::memory_order_relaxed);
+		}
+		if (auto* t = coreinit::OSGetCurrentThread())
+		{
+			g_dbgThrEntry.store((uint32_t)t->entrypoint.GetMPTR(), std::memory_order_relaxed);
+			g_dbgThrName.store(t->threadName ? (const char*)t->threadName.GetPtr() : "", std::memory_order_relaxed);
+		}
+	}
+
+	void DbgWhere(const char* where) { g_dbgWhere.store(where, std::memory_order_relaxed); }
+
+	void SliceEnd(int32_t remainingNow)
+	{
+		if (!g_inSlice)
+			return;
+		const int64_t u = (int64_t)g_sliceStart - (int64_t)remainingNow;
+		if (u > 0)
+			g_cycNum.fetch_add((uint64_t)u, std::memory_order_relaxed);
+		g_inSlice = false;
+	}
+
+	void IdleStep()
+	{
+		DbgWhere("idle step");
+		g_dbgIdle.fetch_add(1, std::memory_order_relaxed);
+		g_cycNum.fetch_add(kIdleStep * kCpuShare, std::memory_order_relaxed);
+	}
+
+	bool UseAudioClock(uint64_t& next)
+	{
+		const uint64_t v = VirtualCycles();
+		const uint64_t step = kCoreClock * 3 / 1000;
+		if (next == 0)
+			next = v;
+		if (v < next)
+			return false;
+		next += step;
+		if (v > next + step * 8)
+			next = v + step;
+		return true;
+	}
+
+	void OnSystemEvents()
+	{
+		DbgWhere("system events");
+		g_dbgSys.fetch_add(1, std::memory_order_relaxed);
+		if (!g_started)
+		{
+			g_started = true;
+			AttachPads();
+			g_deadline = Clock::now();
+			g_nextTickV = VirtualCycles() + kTickCycles;
+			EngineLog("First system event reached: the game's CPU scheduler is running", false);
+			Net::Log("Lockstep started (" + std::to_string(Net::PlayerCount()) + " player(s), delay " + std::to_string(Net::InputDelay()) + " frames)");
+			return;
+		}
+		if (VirtualCycles() < g_nextTickV)
+			return;
+		g_nextTickV += kTickCycles;
+		g_dbgTick.store(g_tick, std::memory_order_relaxed);
+		DoTick();
+	}
+
+	// ======================================================================== public: GPU
+	uint32_t GpuLimit() { return g_gpuLimit.load(std::memory_order_acquire); }
+	bool GpuGated() { return Active() && !g_gpuUngated.load(std::memory_order_relaxed); }
+
+	void GpuPoll()
+	{
+		g_dbgPoll.fetch_add(1, std::memory_order_relaxed);
+		g_gpuAlive.store(true, std::memory_order_relaxed);
+		if (g_gpuUngated.load(std::memory_order_relaxed))
+			return;
+		const uint32_t e = g_epoch.load(std::memory_order_acquire);
+		// the loop iteration that just ended began after we last saw g_gpuPrev
+		g_gpuSeen.store(g_gpuPrev, std::memory_order_release);
+		if (e != g_gpuPrev)
+		{
+			g_gpuPrev = e; // a new window opened while we were busy: go around once more
+			return;
+		}
+		while (Active() && !g_gpuUngated.load(std::memory_order_relaxed) && g_epoch.load(std::memory_order_acquire) == e && !Latte_GetStopSignal())
+			std::this_thread::sleep_for(std::chrono::microseconds(20));
+		g_gpuPrev = g_epoch.load(std::memory_order_acquire);
+	}
+
+	void DbgCompiled(uint64_t micros)
+	{
+		g_dbgCompiles.fetch_add(1, std::memory_order_relaxed);
+		g_dbgCompileUs.fetch_add(micros, std::memory_order_relaxed);
+	}
+
+	// ======================================================================== public: IOSU
+	void IpcSubmitted(void* originalBody)
+	{
+		std::scoped_lock l(g_ipcM);
+		const uint64_t seq = ++g_ipcSeq;
+		IpcEntry e;
+		e.submitted = Clock::now();
+		e.body = originalBody;
+		g_ipc[seq] = e;
+		g_ipcByBody[originalBody] = seq;
+	}
+
+	bool IpcReplyDeferred(uint32_t coreIndex, void* originalBody)
+	{
+		std::scoped_lock l(g_ipcM);
+		auto it = g_ipcByBody.find(originalBody);
+		if (it == g_ipcByBody.end())
+			return false;
+		auto& e = g_ipc[it->second];
+		e.done = true;
+		e.core = coreIndex;
+		g_ipcCv.notify_all();
+		return true;
+	}
+
+	// ======================================================================== public: misc
+	uint64_t AgreedUnixTime() { return g_unixTime.load(); }
+	void SetAgreedUnixTime(uint64_t s) { g_unixTime = s; }
+	bool InterpreterOnly() { return g_interpOnly.load(); }
+	void SetInterpreterOnly(bool v) { g_interpOnly = v; }
+
+
+	namespace
