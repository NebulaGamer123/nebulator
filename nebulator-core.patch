--- /dev/null
+++ b/src/gui/sdlgui/CoopRemote.h
@@ -0,0 +1,56 @@
+#pragma once
+// The controller a co-op guest shows up as on the host. Wire button bit i = ProController button id (i + 1).
+#include "input/api/Controller.h"
+#include "input/emulated/EmulatedController.h"
+#include "input/emulated/ProController.h"
+
+#include <atomic>
+
+class CoopRemote : public ControllerBase
+{
+  public:
+	// Calibrate right away, while nothing is pressed: the first poll would otherwise record whatever the guest is
+	// holding at that moment as the "neutral" state and hide those buttons for the whole session.
+	CoopRemote(std::string_view uuid, std::string_view name) : ControllerBase(uuid, name) { calibrate(); }
+
+	std::string_view api_name() const override { return "Remote"; }
+	InputAPI::Type api() const override { return InputAPI::Remote; }
+	bool is_connected() override { return true; }
+
+	void Set(uint32_t buttons, int8_t lx, int8_t ly, int8_t rx, int8_t ry)
+	{
+		m_buttons = buttons;
+		m_axes = (uint32_t)(uint8_t)lx | ((uint32_t)(uint8_t)ly << 8) | ((uint32_t)(uint8_t)rx << 16) | ((uint32_t)(uint8_t)ry << 24);
+	}
+
+	ControllerState raw_state() override
+	{
+		ControllerState s;
+		const uint32_t b = m_buttons;
+		for (int i = 0; i < 17; i++)
+			if (b & (1u << i))
+				s.buttons.SetButtonState(kButton0 + i, true);
+		const uint32_t a = m_axes;
+		s.axis = {(int8_t)(a & 0xFF) / 127.f, (int8_t)((a >> 8) & 0xFF) / 127.f};
+		s.rotation = {(int8_t)((a >> 16) & 0xFF) / 127.f, (int8_t)((a >> 24) & 0xFF) / 127.f};
+		return s;
+	}
+
+	static void ApplyMapping(const std::shared_ptr<EmulatedController>& emu, const std::shared_ptr<ControllerBase>& pad)
+	{
+		for (int id = ProController::kButtonId_A; id <= ProController::kButtonId_StickR; id++)
+			emu->set_mapping((uint64)id, pad, kButton0 + (uint64)(id - 1));
+		emu->set_mapping(ProController::kButtonId_StickL_Up, pad, kAxisYN);
+		emu->set_mapping(ProController::kButtonId_StickL_Down, pad, kAxisYP);
+		emu->set_mapping(ProController::kButtonId_StickL_Left, pad, kAxisXN);
+		emu->set_mapping(ProController::kButtonId_StickL_Right, pad, kAxisXP);
+		emu->set_mapping(ProController::kButtonId_StickR_Up, pad, kRotationYN);
+		emu->set_mapping(ProController::kButtonId_StickR_Down, pad, kRotationYP);
+		emu->set_mapping(ProController::kButtonId_StickR_Left, pad, kRotationXN);
+		emu->set_mapping(ProController::kButtonId_StickR_Right, pad, kRotationXP);
+	}
+
+  private:
+	std::atomic<uint32_t> m_buttons{0};
+	std::atomic<uint32_t> m_axes{0};
+};
diff --git a/src/gui/sdlgui/HttpServer.cpp b/src/gui/sdlgui/HttpServer.cpp
new file mode 100644
index 0000000..9f84b4b
--- /dev/null
+++ b/src/gui/sdlgui/HttpServer.cpp
@@ -0,0 +1,252 @@
+#include "HttpServer.h"
+
+#include <boost/asio.hpp>
+#include <atomic>
+#include <thread>
+
+namespace asio = boost::asio;
+using tcp = asio::ip::tcp;
+
+namespace
+{
+	constexpr size_t kMaxHeaderBytes = 64 * 1024;
+	constexpr size_t kMaxBodyBytes = 4 * 1024 * 1024;
+
+	const char* ReasonPhrase(int status)
+	{
+		switch (status)
+		{
+		case 200: return "OK";
+		case 204: return "No Content";
+		case 400: return "Bad Request";
+		case 401: return "Unauthorized";
+		case 403: return "Forbidden";
+		case 404: return "Not Found";
+		case 405: return "Method Not Allowed";
+		case 409: return "Conflict";
+		case 413: return "Payload Too Large";
+		case 421: return "Misdirected Request";
+		case 500: return "Internal Server Error";
+		default: return "OK";
+		}
+	}
+
+	std::string ToLower(std::string s)
+	{
+		for (auto& c : s)
+			c = (char)std::tolower((unsigned char)c);
+		return s;
+	}
+
+	std::string Trim(const std::string& s)
+	{
+		size_t b = s.find_first_not_of(" \t\r\n");
+		if (b == std::string::npos)
+			return {};
+		size_t e = s.find_last_not_of(" \t\r\n");
+		return s.substr(b, e - b + 1);
+	}
+
+	bool ReadRequest(tcp::socket& sock, HttpRequest& req)
+	{
+		asio::streambuf buf;
+		boost::system::error_code ec;
+		size_t headerLen = asio::read_until(sock, buf, "\r\n\r\n", ec);
+		if (ec || headerLen > kMaxHeaderBytes)
+			return false;
+
+		std::istream is(&buf);
+		std::string line;
+		if (!std::getline(is, line))
+			return false;
+		{
+			line = Trim(line);
+			size_t sp1 = line.find(' ');
+			size_t sp2 = line.rfind(' ');
+			if (sp1 == std::string::npos || sp2 == sp1)
+				return false;
+			req.method = line.substr(0, sp1);
+			std::string target = line.substr(sp1 + 1, sp2 - sp1 - 1);
+			size_t q = target.find('?');
+			req.path = target.substr(0, q);
+			if (q != std::string::npos)
+				req.query = target.substr(q + 1);
+		}
+		while (std::getline(is, line))
+		{
+			line = Trim(line);
+			if (line.empty())
+				break;
+			size_t colon = line.find(':');
+			if (colon == std::string::npos)
+				continue;
+			req.headers[ToLower(Trim(line.substr(0, colon)))] = Trim(line.substr(colon + 1));
+		}
+
+		size_t contentLength = 0;
+		if (auto it = req.headers.find("content-length"); it != req.headers.end())
+		{
+			try
+			{
+				contentLength = (size_t)std::stoull(it->second);
+			}
+			catch (...)
+			{
+				return false;
+			}
+		}
+		if (contentLength > kMaxBodyBytes)
+			return false;
+		if (contentLength > 0)
+		{
+			req.body.resize(contentLength);
+			is.read(req.body.data(), (std::streamsize)contentLength);
+			size_t got = (size_t)is.gcount();
+			if (got < contentLength)
+			{
+				asio::read(sock, asio::buffer(req.body.data() + got, contentLength - got), ec);
+				if (ec)
+					return false;
+			}
+		}
+		return true;
+	}
+
+	void WriteResponse(tcp::socket& sock, const HttpResponse& res)
+	{
+		std::string out = "HTTP/1.1 " + std::to_string(res.status) + " " + ReasonPhrase(res.status) + "\r\n";
+		out += "Content-Type: " + res.contentType + "\r\n";
+		if (res.stream)
+		{
+			out += "Cache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nConnection: close\r\n\r\n";
+			boost::system::error_code sec;
+			sock.set_option(tcp::no_delay(true), sec);
+			asio::write(sock, asio::buffer(out), sec);
+			if (sec)
+				return;
+			res.stream([&sock](const std::string& chunk) {
+				boost::system::error_code e;
+				asio::write(sock, asio::buffer(chunk), e);
+				return !e;
+			});
+			return;
+		}
+		out += "Content-Length: " + std::to_string(res.body.size()) + "\r\n";
+		out += "Cache-Control: no-store\r\n";
+		out += "X-Content-Type-Options: nosniff\r\n";
+		out += "Connection: close\r\n\r\n";
+		out += res.body;
+		boost::system::error_code ec;
+		asio::write(sock, asio::buffer(out), ec);
+	}
+} // namespace
+
+struct HttpServer::Impl
+{
+	asio::io_context io;
+	std::unique_ptr<tcp::acceptor> acceptor;
+	std::thread thread;
+	std::atomic_bool running{false};
+	Handler handler;
+	uint16_t port = 0;
+
+	void Serve(tcp::socket sock)
+	{
+		HttpRequest req;
+		HttpResponse res;
+		try
+		{
+			if (!ReadRequest(sock, req))
+			{
+				res.status = 400;
+				res.body = "{\"error\":\"bad request\"}";
+			}
+			else
+			{
+				// DNS-rebinding protection: only answer requests addressed to the loopback name we serve
+				const std::string host = ToLower(req.headers.count("host") ? req.headers["host"] : "");
+				const std::string a = "127.0.0.1:" + std::to_string(port);
+				const std::string b = "localhost:" + std::to_string(port);
+				if (host != a && host != b)
+				{
+					res.status = 421;
+					res.body = "{\"error\":\"bad host\"}";
+				}
+				else
+					res = handler(req);
+			}
+		}
+		catch (const std::exception& ex)
+		{
+			res.status = 500;
+			res.contentType = "application/json";
+			res.body = std::string("{\"error\":\"") + "internal error" + "\"}";
+			(void)ex;
+		}
+		WriteResponse(sock, res);
+		boost::system::error_code ec;
+		sock.shutdown(tcp::socket::shutdown_both, ec);
+		sock.close(ec);
+	}
+
+	void Run()
+	{
+		while (running)
+		{
+			tcp::socket sock(io);
+			boost::system::error_code ec;
+			acceptor->accept(sock, ec);
+			if (ec)
+			{
+				if (!running)
+					break;
+				continue;
+			}
+			std::thread([this, s = std::move(sock)]() mutable { Serve(std::move(s)); }).detach();
+		}
+	}
+};
+
+HttpServer::HttpServer() : m_impl(std::make_unique<Impl>()) {}
+HttpServer::~HttpServer() { Stop(); }
+
+bool HttpServer::Start(uint16_t firstPort, Handler handler)
+{
+	m_impl->handler = std::move(handler);
+	for (uint16_t p = firstPort; p < firstPort + 10; p++)
+	{
+		try
+		{
+			auto acc = std::make_unique<tcp::acceptor>(m_impl->io);
+			tcp::endpoint ep(asio::ip::make_address("127.0.0.1"), p);
+			acc->open(ep.protocol());
+			acc->bind(ep); // no SO_REUSEADDR: a second instance must not share the port
+			acc->listen();
+			m_impl->acceptor = std::move(acc);
+			m_impl->port = p;
+			m_impl->running = true;
+			m_impl->thread = std::thread([this] { m_impl->Run(); });
+			return true;
+		}
+		catch (const std::exception&)
+		{
+			// port busy, try the next one
+		}
+	}
+	return false;
+}
+
+void HttpServer::Stop()
+{
+	if (!m_impl->running.exchange(false))
+		return;
+	boost::system::error_code ec;
+	if (m_impl->acceptor)
+	{
+		m_impl->acceptor->close(ec);
+	}
+	if (m_impl->thread.joinable())
+		m_impl->thread.join();
+}
+
+uint16_t HttpServer::Port() const { return m_impl->port; }
diff --git a/src/gui/sdlgui/HttpServer.h b/src/gui/sdlgui/HttpServer.h
new file mode 100644
index 0000000..e8a2c17
--- /dev/null
+++ b/src/gui/sdlgui/HttpServer.h
@@ -0,0 +1,44 @@
+#pragma once
+// Minimal localhost-only HTTP/1.1 server (one request per connection). Used by the NEBULATOR UI.
+
+#include <functional>
+#include <map>
+#include <memory>
+#include <string>
+
+struct HttpRequest
+{
+	std::string method;
+	std::string path;  // without query string
+	std::string query; // raw, after '?'
+	std::string body;
+	std::map<std::string, std::string> headers; // lower-case names
+};
+
+struct HttpResponse
+{
+	int status = 200;
+	std::string contentType = "application/json";
+	std::string body;
+	// when set, the response is streamed: headers go out first (no Content-Length), then this runs on the
+	// connection thread and calls write() for every chunk until write() returns false or it returns.
+	std::function<void(const std::function<bool(const std::string&)>& write)> stream;
+};
+
+class HttpServer
+{
+  public:
+	using Handler = std::function<HttpResponse(const HttpRequest&)>;
+
+	HttpServer();
+	~HttpServer();
+
+	// binds 127.0.0.1 on the first free port in [firstPort, firstPort + 9]; returns false if none is free
+	bool Start(uint16_t firstPort, Handler handler);
+	void Stop();
+	uint16_t Port() const;
+
+  private:
+	struct Impl;
+	std::unique_ptr<Impl> m_impl;
+};
diff --git a/src/gui/sdlgui/JpegEnc.cpp b/src/gui/sdlgui/JpegEnc.cpp
new file mode 100644
index 0000000..f4c56b2
--- /dev/null
+++ b/src/gui/sdlgui/JpegEnc.cpp
@@ -0,0 +1,311 @@
+#include "JpegEnc.h"
+
+#include <algorithm>
+#include <cmath>
+#include <vector>
+
+namespace JpegEnc
+{
+	namespace
+	{
+		const uint8_t kZig[64] = {0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5, 12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13, 6, 7, 14, 21, 28,
+								  35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51, 58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63};
+		const uint8_t kQLuma[64] = {16, 11, 10, 16, 24, 40, 51, 61, 12, 12, 14, 19, 26, 58, 60, 55, 14, 13, 16, 24, 40, 57, 69, 56, 14, 17, 22, 29, 51, 87, 80, 62,
+									18, 22, 37, 56, 68, 109, 103, 77, 24, 35, 55, 64, 81, 104, 113, 92, 49, 64, 78, 87, 103, 121, 120, 101, 72, 92, 95, 98, 112, 100, 103, 99};
+		const uint8_t kQChroma[64] = {17, 18, 24, 47, 99, 99, 99, 99, 18, 21, 26, 66, 99, 99, 99, 99, 24, 26, 56, 99, 99, 99, 99, 99, 47, 66, 99, 99, 99, 99, 99, 99,
+									  99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99};
+
+		// A valid (not size-optimal) Huffman code: a few short codes for the most common AC symbols, 9 bits for the rest.
+		struct Huff
+		{
+			uint8_t bitsCount[17] = {}; // number of codes per length 1..16
+			std::vector<uint8_t> vals;
+			uint16_t code[256] = {};
+			uint8_t len[256] = {};
+			void Build()
+			{
+				uint32_t c = 0;
+				size_t k = 0;
+				for (int l = 1; l <= 16; l++)
+				{
+					for (int i = 0; i < bitsCount[l]; i++, k++)
+					{
+						code[vals[k]] = (uint16_t)c;
+						len[vals[k]] = (uint8_t)l;
+						c++;
+					}
+					c <<= 1;
+				}
+			}
+		};
+
+		struct Tables
+		{
+			Huff dc, ac;
+			float cosT[8][8];
+			Tables()
+			{
+				// DC: categories 0..11, all 4 bits
+				dc.bitsCount[4] = 12;
+				for (int i = 0; i < 12; i++)
+					dc.vals.push_back((uint8_t)i);
+				dc.Build();
+				// AC
+				const uint8_t s4[] = {0x01, 0x00, 0x02, 0x11};
+				const uint8_t s6[] = {0x03, 0x21, 0x12, 0x04, 0x31, 0x05, 0x13, 0x41, 0x22, 0x06};
+				bool used[256] = {};
+				for (uint8_t s : s4)
+				{
+					ac.vals.push_back(s);
+					used[s] = true;
+				}
+				for (uint8_t s : s6)
+				{
+					ac.vals.push_back(s);
+					used[s] = true;
+				}
+				ac.bitsCount[4] = 4;
+				ac.bitsCount[6] = 10;
+				int rest = 0;
+				for (int run = 0; run < 16; run++)
+					for (int sz = 1; sz <= 10; sz++)
+					{
+						uint8_t s = (uint8_t)((run << 4) | sz);
+						if (!used[s])
+						{
+							ac.vals.push_back(s);
+							used[s] = true;
+							rest++;
+						}
+					}
+				if (!used[0xF0])
+				{
+					ac.vals.push_back(0xF0);
+					rest++;
+				}
+				ac.bitsCount[9] = (uint8_t)rest;
+				ac.Build();
+				for (int u = 0; u < 8; u++)
+					for (int x = 0; x < 8; x++)
+						cosT[u][x] = (float)(std::cos((2 * x + 1) * u * 3.14159265358979 / 16.0) * (u == 0 ? std::sqrt(0.125) : 0.5));
+			}
+		};
+		const Tables& T()
+		{
+			static const Tables t;
+			return t;
+		}
+
+		struct Bits
+		{
+			std::string& out;
+			uint32_t acc = 0;
+			int n = 0;
+			explicit Bits(std::string& o) : out(o) {}
+			void Put(uint32_t v, int bits)
+			{
+				acc = (acc << bits) | (v & ((1u << bits) - 1));
+				n += bits;
+				while (n >= 8)
+				{
+					uint8_t b = (uint8_t)(acc >> (n - 8));
+					out.push_back((char)b);
+					if (b == 0xFF)
+						out.push_back(0);
+					n -= 8;
+				}
+			}
+			void Flush()
+			{
+				if (n > 0)
+					Put(0x7F, 8 - n);
+			}
+		};
+
+		void Word(std::string& o, int v)
+		{
+			o.push_back((char)(v >> 8));
+			o.push_back((char)v);
+		}
+
+		void Dct(const float in[64], float out[64])
+		{
+			const auto& c = T().cosT;
+			float tmp[64];
+			for (int y = 0; y < 8; y++)
+				for (int u = 0; u < 8; u++)
+				{
+					float s = 0;
+					for (int x = 0; x < 8; x++)
+						s += in[y * 8 + x] * c[u][x];
+					tmp[y * 8 + u] = s;
+				}
+			for (int u = 0; u < 8; u++)
+				for (int v = 0; v < 8; v++)
+				{
+					float s = 0;
+					for (int y = 0; y < 8; y++)
+						s += tmp[y * 8 + u] * c[v][y];
+					out[v * 8 + u] = s;
+				}
+		}
+
+		inline int Category(int v)
+		{
+			v = v < 0 ? -v : v;
+			int c = 0;
+			while (v)
+			{
+				c++;
+				v >>= 1;
+			}
+			return c;
+		}
+
+		void EncodeBlock(Bits& bw, const float px[64], const float q[64], int& prevDc)
+		{
+			const Tables& t = T();
+			float d[64];
+			Dct(px, d);
+			int qc[64];
+			for (int i = 0; i < 64; i++)
+				qc[i] = (int)std::lround(d[kZig[i]] / q[kZig[i]]);
+			int diff = qc[0] - prevDc;
+			prevDc = qc[0];
+			int cat = Category(diff);
+			bw.Put(t.dc.code[cat], t.dc.len[cat]);
+			if (cat)
+				bw.Put((uint32_t)(diff < 0 ? diff - 1 : diff), cat);
+			int run = 0;
+			for (int i = 1; i < 64; i++)
+			{
+				int v = qc[i];
+				if (v == 0)
+				{
+					run++;
+					continue;
+				}
+				while (run > 15)
+				{
+					bw.Put(t.ac.code[0xF0], t.ac.len[0xF0]);
+					run -= 16;
+				}
+				int c = Category(v);
+				if (c > 10)
+					c = 10, v = v < 0 ? -1023 : 1023;
+				int sym = (run << 4) | c;
+				bw.Put(t.ac.code[sym], t.ac.len[sym]);
+				bw.Put((uint32_t)(v < 0 ? v - 1 : v), c);
+				run = 0;
+			}
+			if (run > 0)
+				bw.Put(t.ac.code[0x00], t.ac.len[0x00]);
+		}
+	} // namespace
+
+	std::string Encode(const uint8_t* rgb, int w, int h, int quality)
+	{
+		if (!rgb || w < 1 || h < 1 || w > 8192 || h > 8192)
+			return {};
+		quality = std::clamp(quality, 1, 100);
+		const int scale = quality < 50 ? 5000 / quality : 200 - quality * 2;
+		float qy[64], qc[64];
+		uint8_t qyb[64], qcb[64];
+		for (int i = 0; i < 64; i++)
+		{
+			int a = std::clamp((kQLuma[i] * scale + 50) / 100, 1, 255);
+			int b = std::clamp((kQChroma[i] * scale + 50) / 100, 1, 255);
+			qy[i] = (float)a;
+			qc[i] = (float)b;
+			qyb[i] = (uint8_t)a;
+			qcb[i] = (uint8_t)b;
+		}
+		const Tables& t = T();
+		std::string o;
+		o.reserve((size_t)w * h / 8 + 700);
+		o += "\xFF\xD8";
+		// DQT (ids 0, 1; values in zigzag order)
+		o += "\xFF\xDB";
+		Word(o, 2 + 65 * 2);
+		o.push_back(0);
+		for (int i = 0; i < 64; i++)
+			o.push_back((char)qyb[kZig[i]]);
+		o.push_back(1);
+		for (int i = 0; i < 64; i++)
+			o.push_back((char)qcb[kZig[i]]);
+		// SOF0: 3 components, Y is 2x2, Cb/Cr 1x1
+		o += "\xFF\xC0";
+		Word(o, 17);
+		o.push_back(8);
+		Word(o, h);
+		Word(o, w);
+		o.push_back(3);
+		o.push_back(1); o.push_back(0x22); o.push_back(0);
+		o.push_back(2); o.push_back(0x11); o.push_back(1);
+		o.push_back(3); o.push_back(0x11); o.push_back(1);
+		// DHT: DC table 0, AC table 0 (shared by all components)
+		auto dht = [&](int cls, const Huff& hf) {
+			o += "\xFF\xC4";
+			Word(o, 2 + 1 + 16 + (int)hf.vals.size());
+			o.push_back((char)(cls << 4));
+			for (int l = 1; l <= 16; l++)
+				o.push_back((char)hf.bitsCount[l]);
+			for (uint8_t v : hf.vals)
+				o.push_back((char)v);
+		};
+		dht(0, t.dc);
+		dht(1, t.ac);
+		// SOS
+		o += "\xFF\xDA";
+		Word(o, 12);
+		o.push_back(3);
+		o.push_back(1); o.push_back(0x00);
+		o.push_back(2); o.push_back(0x00);
+		o.push_back(3); o.push_back(0x00);
+		o.push_back(0); o.push_back(63); o.push_back(0);
+
+		Bits bw(o);
+		int pY = 0, pCb = 0, pCr = 0;
+		const int mw = (w + 15) / 16, mh = (h + 15) / 16;
+		auto px = [&](int x, int y, int ch) -> float {
+			x = std::min(x, w - 1);
+			y = std::min(y, h - 1);
+			const uint8_t* p = rgb + ((size_t)y * w + x) * 3;
+			const float r = p[0], g = p[1], b = p[2];
+			if (ch == 0)
+				return 0.299f * r + 0.587f * g + 0.114f * b - 128.f;
+			if (ch == 1)
+				return -0.168736f * r - 0.331264f * g + 0.5f * b;
+			return 0.5f * r - 0.418688f * g - 0.081312f * b;
+		};
+		float blk[64];
+		for (int my = 0; my < mh; my++)
+			for (int mx = 0; mx < mw; mx++)
+			{
+				for (int by = 0; by < 2; by++)
+					for (int bx = 0; bx < 2; bx++)
+					{
+						for (int y = 0; y < 8; y++)
+							for (int x = 0; x < 8; x++)
+								blk[y * 8 + x] = px(mx * 16 + bx * 8 + x, my * 16 + by * 8 + y, 0);
+						EncodeBlock(bw, blk, qy, pY);
+					}
+				for (int ch = 1; ch <= 2; ch++)
+				{
+					for (int y = 0; y < 8; y++)
+						for (int x = 0; x < 8; x++)
+						{
+							float s = 0;
+							for (int dy = 0; dy < 2; dy++)
+								for (int dx = 0; dx < 2; dx++)
+									s += px(mx * 16 + x * 2 + dx, my * 16 + y * 2 + dy, ch);
+							blk[y * 8 + x] = s * 0.25f;
+						}
+					EncodeBlock(bw, blk, qc, ch == 1 ? pCb : pCr);
+				}
+			}
+		bw.Flush();
+		o += "\xFF\xD9";
+		return o;
+	}
+} // namespace JpegEnc
