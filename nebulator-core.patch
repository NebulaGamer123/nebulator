+// Lockstep netplay: session (TCP 17810), compatibility check, shared save, input exchange, desync report,
+// the Determinism Lab and the /api/coop/lock/* routes. The emulation side is in LockstepCore.cpp.
+//
+// Wire protocol: [u8 type][u32 length][payload] (little endian). Control messages carry JSON, INPUT/HASH are binary.
+//   1 HELLO   guest->host  {"magic":"NEBLOCK1","code","name","build"}
+//   2 WELCOME host->guest  {"ok","slot","msg"}
+//   3 ROSTER  host->guest  {"players":[...],"titleId","manifest","settings","state"}
+//   4 READY   guest->host  {"titleId","manifest"}
+//   5 SAVE    host->guest  archive of the host's save for the chosen game
+//   6 START   host->guest  {"unix","delay","hashEvery","cpu","players","titleId"}
+//   7 INPUT   both         u32 tick, u8 slot, u32 buttons, i8 lx ly rx ry
+//   8 HASH    guest->host  u32 tick, u64 total, chunk hashes
+//   9 BYE
+//  10 PING / 11 PONG       u64 echo
+//  12 DESYNC  host->guest  {"tick","region"}
+
