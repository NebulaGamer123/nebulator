+			std::string InputPacket(uint32_t tick, int slot, const PadState& p)
+			{
+				std::string b(13, 0);
+				memcpy(&b[0], &tick, 4);
+				b[4] = (char)slot;
+				memcpy(&b[5], &p.buttons, 4);
+				b[9] = (char)p.lx;
+				b[10] = (char)p.ly;
+				b[11] = (char)p.rx;
+				b[12] = (char)p.ry;
