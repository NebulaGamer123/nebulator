+
+			void CheckHashLocked(uint32_t tick)
+			{
+				auto mine = s.myHash.find(tick);
+				auto peers = s.peerHash.find(tick);
+				if (mine == s.myHash.end() || peers == s.peerHash.end())
+					return;
+				int need = 0;
+				for (int i = 1; i < s.nPlayers; i++)
+					if (!s.gone[i])
+						need++;
+				if ((int)peers->second.size() < need)
+					return;
+				for (auto& [slot, h] : peers->second)
+				{
+					if (h.total != mine->second.total && !s.desync)
+					{
+						s.desync = true;
+						s.desyncTick = tick;
+						s.desyncRegion = FirstDifferentRegion(mine->second.chunks, h.chunks);
+						LogLocked("DESYNC at tick " + std::to_string(tick) + " between player 1 and player " + std::to_string(slot + 1) + " (" + s.desyncRegion + ")");
+						ControlApi::Json j;
+						j.w.StartObject();
+						j.KI("tick", tick);
+						j.KS("region", s.desyncRegion);
+						j.w.EndObject();
+						SendToOthersLocked(DESYNC, j.sb.GetString(), nullptr);
+					}
+				}
+				s.peerHash.erase(tick);
+				while (s.myHash.size() > 64)
+					s.myHash.erase(s.myHash.begin());
+				while (s.peerHash.size() > 64)
+					s.peerHash.erase(s.peerHash.begin());
+			}
+
+			void DropGuest(const std::shared_ptr<Conn>& g)
+			{
+				g->Close();
+				std::scoped_lock l(s.m);
+				auto it = std::find(s.guests.begin(), s.guests.end(), g);
+				if (it == s.guests.end())
+					return;
+				if (g->slot >= 0 && g->slot < kMaxPlayers && s.state == "running")
+					s.gone[g->slot] = true;
+				LogLocked(g->name + " left");
+				if (s.state != "running")
+				{
+					s.guests.erase(it);
+					// keep slots contiguous before the game starts
+					int n = 1;
+					for (auto& x : s.guests)
+						x->slot = n++;
+				}
+				BroadcastRosterLocked();
+			}
+
+			// ------------------------------------------------------------------ guest side receive loop
+			void ApplyRosterLocked(const rapidjson::Document& d)
+			{
+				s.roster.clear();
+				if (d.HasMember("players") && d["players"].IsArray())
+					for (auto& p : d["players"].GetArray())
+					{
+						S::P e;
+						e.slot = p.HasMember("slot") ? p["slot"].GetInt() : 0;
+						e.name = p.HasMember("name") ? p["name"].GetString() : "";
+						e.ready = p.HasMember("ready") && p["ready"].GetBool();
+						e.ping = p.HasMember("ping") ? p["ping"].GetInt() : -1;
+						if (p.HasMember("problems"))
+							for (auto& t : p["problems"].GetArray())
+								e.problems.push_back(t.GetString());
+						s.roster.push_back(e);
+					}
+				if (d.HasMember("titleId"))
+					s.titleId = d["titleId"].GetString();
+				if (d.HasMember("manifest") && d["manifest"].IsObject())
+				{
+					rapidjson::StringBuffer sb;
+					rapidjson::Writer<rapidjson::StringBuffer> w(sb);
+					d["manifest"].Accept(w);
+					s.manifestJson = sb.GetString();
+				}
+				if (d.HasMember("settings") && d["settings"].IsObject())
+				{
+					auto& st = d["settings"];
+					s.delay = st.HasMember("delay") ? st["delay"].GetInt() : 0;
+					s.hashEvery = st.HasMember("hashEvery") ? st["hashEvery"].GetInt() : 30;
+					s.cpu = st.HasMember("cpu") ? st["cpu"].GetString() : "recompiler";
+					s.shareSave = !st.HasMember("shareSave") || st["shareSave"].GetBool();
+				}
+			}
+
+			void BeginGameLocked(const std::string& unixStr, int delay, int hashEvery, const std::string& cpu, int players, const std::string& titleId, bool applySave);
+
+			void GuestLoop(std::shared_ptr<Conn> c)
+			{
+				uint8_t t;
+				std::string p;
+				while (!s.stop && c->Recv(t, p))
+				{
+					rapidjson::Document d;
+					if (t == ROSTER)
+					{
+						d.Parse(p.c_str());
+						if (!d.IsObject())
+							continue;
+						std::string pickedBefore;
+						std::string newTitle;
+						{
+							std::scoped_lock l(s.m);
+							pickedBefore = s.titleId;
+							ApplyRosterLocked(d);
+							newTitle = s.titleId;
+						}
+						if (!newTitle.empty() && newTitle != pickedBefore)
+						{
+							std::string err;
+							const std::string man = BuildManifest(newTitle, &err);
+							ControlApi::Json j;
+							j.w.StartObject();
+							j.KS("titleId", newTitle);
+							j.K("manifest");
+							j.w.RawValue(man.c_str(), man.size(), rapidjson::kObjectType);
+							j.w.EndObject();
+							c->Send(READY, j.sb.GetString());
+						}
+						s.cv.notify_all();
+					}
+					else if (t == SAVE)
+					{
+						std::scoped_lock l(s.m);
+						s.pendingSave = p;
+					}
+					else if (t == START)
+					{
+						d.Parse(p.c_str());
+						if (!d.IsObject())
+							continue;
+						std::scoped_lock l(s.m);
+						BeginGameLocked(std::to_string(d["unix"].GetUint64()), d["delay"].GetInt(), d["hashEvery"].GetInt(), d["cpu"].GetString(), d["players"].GetInt(), d["titleId"].GetString(), true);
+					}
+					else if (t == INPUT && p.size() >= 13)
+					{
+						uint32_t tick;
+						memcpy(&tick, &p[0], 4);
+						PadState ps;
+						memcpy(&ps.buttons, &p[5], 4);
+						ps.lx = (int8_t)p[9];
+						ps.ly = (int8_t)p[10];
+						ps.rx = (int8_t)p[11];
+						ps.ry = (int8_t)p[12];
+						std::scoped_lock l(s.m);
+						StoreInputLocked(tick, (uint8_t)p[4], ps);
+					}
+					else if (t == DESYNC)
+					{
+						d.Parse(p.c_str());
+						std::scoped_lock l(s.m);
+						if (d.IsObject() && !s.desync)
+						{
+							s.desync = true;
+							s.desyncTick = d["tick"].GetUint();
+							s.desyncRegion = d["region"].GetString();
+							LogLocked("DESYNC at tick " + std::to_string(s.desyncTick) + " (" + s.desyncRegion + ")");
+						}
+					}
+					else if (t == PING)
+						c->Send(PONG, p);
+					else if (t == BYE)
+						break;
+				}
+				std::scoped_lock l(s.m);
+				if (s.role == "guest")
+				{
+					LogLocked("The host closed the session");
+					s.role.clear();
+					s.up.reset();
+					for (int i = 0; i < kMaxPlayers; i++)
+						s.gone[i] = true;
+					s.cv.notify_all();
+				}
+			}
+
+			// ------------------------------------------------------------------ host side
+			void HostConnLoop(std::shared_ptr<Conn> c)
+			{
+				uint8_t t;
+				std::string p;
+				// handshake
+				if (!c->Recv(t, p) || t != HELLO)
+				{
+					c->Close();
+					return;
+				}
+				rapidjson::Document hello;
+				hello.Parse(p.c_str());
+				std::string reject;
+				if (!hello.IsObject() || !hello.HasMember("magic") || std::string(hello["magic"].GetString()) != "NEBLOCK1")
+					reject = "That is not a NEBULATOR lockstep host.";
+				{
+					std::scoped_lock l(s.m);
+					if (reject.empty() && (s.role != "host"))
+						reject = "The host is not accepting players.";
+					else if (reject.empty() && (!hello.HasMember("code") || NormalizeCode(hello["code"].GetString()) != s.code))
+						reject = "Wrong join code.";
+					else if (reject.empty() && s.state == "running")
+						reject = "The game already started.";
+					else if (reject.empty() && (int)s.guests.size() >= kMaxPlayers - 1)
+						reject = "The session is full.";
+					if (reject.empty())
+					{
+						c->name = hello.HasMember("name") ? hello["name"].GetString() : "Guest";
+						if (c->name.size() > 24)
+							c->name.resize(24);
+						c->slot = (int)s.guests.size() + 1;
+						s.guests.push_back(c);
+						LogLocked(c->name + " joined as player " + std::to_string(c->slot + 1));
+					}
+				}
+				ControlApi::Json w;
+				w.w.StartObject();
+				w.KB("ok", reject.empty());
+				w.KI("slot", c->slot);
+				w.KS("msg", reject);
+				w.w.EndObject();
+				c->Send(WELCOME, w.sb.GetString());
+				if (!reject.empty())
+				{
+					c->Close();
+					return;
+				}
+				{
+					std::scoped_lock l(s.m);
+					BroadcastRosterLocked();
+				}
+				while (!s.stop && c->Recv(t, p))
+				{
+					if (t == READY)
+					{
+						rapidjson::Document d;
+						d.Parse(p.c_str());
+						if (!d.IsObject() || !d.HasMember("manifest"))
+							continue;
+						rapidjson::StringBuffer sb;
+						rapidjson::Writer<rapidjson::StringBuffer> wr(sb);
+						d["manifest"].Accept(wr);
+						std::scoped_lock l(s.m);
+						c->problems = Compare(s.manifestJson, sb.GetString());
+						c->ready = c->problems.empty();
+						BroadcastRosterLocked();
+					}
+					else if (t == INPUT && p.size() >= 13)
+					{
+						uint32_t tick;
+						memcpy(&tick, &p[0], 4);
+						PadState ps;
+						memcpy(&ps.buttons, &p[5], 4);
+						ps.lx = (int8_t)p[9];
+						ps.ly = (int8_t)p[10];
+						ps.rx = (int8_t)p[11];
+						ps.ry = (int8_t)p[12];
+						std::scoped_lock l(s.m);
+						StoreInputLocked(tick, c->slot, ps); // slot is decided by us, never by the sender
+						SendToOthersLocked(INPUT, InputPacket(tick, c->slot, ps), c.get());
+					}
+					else if (t == HASH && p.size() >= 12)
+					{
+						HashRec h;
+						memcpy(&h.tick, &p[0], 4);
+						memcpy(&h.total, &p[4], 8);
+						h.chunks = p.substr(12);
+						std::scoped_lock l(s.m);
+						s.peerHash[h.tick][c->slot] = h;
+						CheckHashLocked(h.tick);
+					}
+					else if (t == PONG && p.size() >= 8)
+						c->pingMs = (int)(NowMs() - c->pingSent);
+					else if (t == BYE)
+						break;
+				}
+				DropGuest(c);
+			}
+
+			void AcceptLoop()
+			{
+				while (!s.stop && s.acc)
+				{
+					auto c = std::make_shared<Conn>(s.io);
+					boost::system::error_code ec;
+					s.acc->accept(c->sock, ec);
+					if (ec)
+						break;
+					c->sock.set_option(tcp::no_delay(true), ec);
+					std::thread(HostConnLoop, c).detach();
+				}
+			}
+
+			void PingLoop()
+			{
+				int tickN = 0;
+				while (!s.stop)
+				{
+					std::this_thread::sleep_for(std::chrono::seconds(1));
+					std::scoped_lock l(s.m);
+					if (s.role != "host")
+						return;
+					for (auto& g : s.guests)
+					{
+						g->pingSent = NowMs();
+						uint64_t e = (uint64_t)g->pingSent;
+						g->Send(PING, std::string((const char*)&e, 8));
+					}
+					if ((++tickN & 1) == 0 && s.state != "running")
+						BroadcastRosterLocked();
+				}
+			}
+
+			void StopAllLocked()
+			{
+				s.stop = true;
+				for (auto& g : s.guests)
+				{
+					g->Send(BYE, "");
+					g->Close();
+				}
+				s.guests.clear();
+				if (s.up)
+				{
+					s.up->Send(BYE, "");
+					s.up->Close();
+					s.up.reset();
+				}
+				boost::system::error_code ec;
+				if (s.acc)
+				{
+					s.acc->close(ec);
+					s.acc.reset();
+				}
+				s.role.clear();
+				s.state = "idle";
+				s.roster.clear();
+				s.titleId.clear();
+				s.manifestJson.clear();
+				s.inputs.clear();
+				s.cv.notify_all();
+			}
+
+			// called with s.m held; swaps the save (guests), configures the engine and launches the game
+			void BeginGameLocked(const std::string& unixStr, int delay, int hashEvery, const std::string& cpu, int players, const std::string& titleId, bool applySave)
+			{
+				if (s.state == "running")
+					return;
+				std::string err;
+				if (applySave && s.shareSave && !s.pendingSave.empty())
+				{
+					char ts[32];
+					const time_t now = time(nullptr);
+					strftime(ts, sizeof(ts), "%Y%m%d-%H%M%S", gmtime(&now));
+					const fs::path bdir = Dir() / "backups" / (titleId + "-" + ts);
+					CopyDir(SaveDir(titleId), bdir);
+					s.backupDir = bdir.string();
+					if (!UnpackDir(s.pendingSave, SaveDir(titleId)))
+						LogLocked("Could not apply the host's save");
+					else
+						LogLocked("Your save was backed up and replaced by the host's");
+					s.pendingSave.clear();
+				}
+				s.nPlayers = players;
+				s.effDelay = std::max(1, delay);
+				s.hashEvery = hashEvery;
+				s.titleId = titleId;
+				s.inputs.clear();
+				s.myHash.clear();
+				s.peerHash.clear();
+				s.desync = false;
+				for (auto& g : s.gone)
+					g = false;
+				SetAgreedUnixTime(std::strtoull(unixStr.c_str(), nullptr, 10));
+				SetInterpreterOnly(cpu == "interpreter");
+				SessionStarting();
+				s.state = "running";
+				LogLocked("Starting the game (delay " + std::to_string(s.effDelay) + " frames, " + std::to_string(players) + " players)");
+				std::thread([titleId] {
+					std::string e;
+					if (!ControlApi::LaunchTitle(titleId, e))
+					{
+						std::scoped_lock l(s.m);
+						s.error = e;
+						s.state = "idle";
+						Lockstep::g_active = false;
+						LogLocked("Launch failed: " + e);
+					}
+				}).detach();
+			}
+
+			int AutoDelay()
+			{
+				int a = 0, b = 0;
+				for (auto& g : s.guests)
+				{
+					const int p = std::max(0, g->pingMs.load());
+					if (p >= a)
+					{
+						b = a;
+						a = p;
+					}
+					else if (p > b)
+						b = p;
+				}
+				const double oneWay = (a + b) / 2.0 + (s.guests.size() > 1 ? 0 : 0);
+				return std::max(2, std::min(12, (int)std::ceil(oneWay / 16.68) + 1));
+			}
