+					j.KB("missing", true);
+					j.KS("titleId", titleIdHex);
+					j.w.EndObject();
+					return j.sb.GetString();
+				}
+				j.KS("titleId", titleIdHex);
+				j.KS("title", gi.GetTitleName());
+				j.KI("version", gi.GetVersion());
