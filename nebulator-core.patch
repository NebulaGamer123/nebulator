+std::ios_base& (*volatile g_nebulatorKeepHex)(std::ios_base&) = std::hex;
+std::string NebulatorKeepRv(std::string a, std::string b) { return std::move(a) + std::move(b); }
+std::string NebulatorKeepConcat(const std::string& a, const std::string& b)
