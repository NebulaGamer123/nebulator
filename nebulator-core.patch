+			std::vector<std::string> Compare(const std::string& hostJson, const std::string& guestJson)
+			{
+				std::vector<std::string> out;
+				rapidjson::Document a, b;
+				a.Parse(hostJson.c_str());
+				b.Parse(guestJson.c_str());
+				if (!b.IsObject() || b.HasMember("missing"))
+					return {"This PC does not have the game."};
+				if (!a.IsObject())
+					return out;
+				auto geti = [](rapidjson::Document& d, const char* k) { return d.HasMember(k) && d[k].IsInt64() ? d[k].GetInt64() : 0; };
+				auto gets = [](rapidjson::Document& d, const char* k) { return d.HasMember(k) && d[k].IsString() ? std::string(d[k].GetString()) : std::string(); };
+				if (geti(a, "version") != geti(b, "version"))
+					out.push_back("Game version differs (host v" + std::to_string(geti(a, "version")) + ", you v" + std::to_string(geti(b, "version")) + ").");
+				if (geti(a, "dlc") != geti(b, "dlc"))
+					out.push_back("DLC version differs.");
+				if (gets(a, "build") != gets(b, "build"))
+					out.push_back("NEBULATOR version differs (host " + gets(a, "build") + ", you " + gets(b, "build") + "). Update so everyone has the same one.");
+				auto packs = [](rapidjson::Document& d) { std::vector<std::string> v; if (d.HasMember("packs") && d["packs"].IsArray()) for (auto& x : d["packs"].GetArray()) if (x.IsString()) v.push_back(x.GetString()); return v; };
+				auto pa = packs(a), pb = packs(b);
+				if (pa != pb)
+				{
+					std::string t = "Rule-changing graphics packs differ. Host: " + (pa.empty() ? std::string("none") : pa[0] + (pa.size() > 1 ? " +" + std::to_string(pa.size() - 1) : "")) + ". You: " + (pb.empty() ? std::string("none") : pb[0] + (pb.size() > 1 ? " +" + std::to_string(pb.size() - 1) : "")) + ".";
+					out.push_back(t);
+				}
+				return out;
+			}
