+			// ------------------------------------------------------------------ Determinism Lab files
+			fs::path LabDir() { return Dir() / "lab"; }
+
+			void LabWriteResult()
+			{
+				ControlApi::Json j;
+				j.w.StartObject();
+				j.KS("titleId", s.lab.titleId);
+				j.KB("identical", !s.lab.mismatch);
+				j.KI("checked", s.lab.checked);
+				j.KI("ticks", s.lab.ticks);
+				j.KI("firstTick", s.lab.firstTick);
+				j.KS("region", s.lab.region);
+				j.w.EndObject();
+				std::ofstream(LabDir() / "result.json", std::ios::trunc) << j.sb.GetString();
+			}
+
+			void LabLoadMeta()
+			{
+				std::ifstream f(LabDir() / "meta.json");
+				std::string t((std::istreambuf_iterator<char>(f)), {});
+				rapidjson::Document d;
+				d.Parse(t.c_str());
+				if (d.IsObject())
+				{
+					s.lab.titleId = d.HasMember("titleId") ? d["titleId"].GetString() : "";
+					s.lab.seconds = d.HasMember("seconds") ? d["seconds"].GetInt() : 60;
+					s.lab.ticks = d.HasMember("ticks") ? d["ticks"].GetUint() : 0;
+					s.lab.phase = d.HasMember("phase") ? d["phase"].GetString() : "none";
+					SetAgreedUnixTime(d.HasMember("unix") ? d["unix"].GetUint64() : 0);
+					s.cpu = d.HasMember("cpu") ? d["cpu"].GetString() : "recompiler";
+				}
+			}
+
+			void LabSaveMeta(const std::string& phase, uint64_t unixT)
+			{
+				ControlApi::Json j;
+				j.w.StartObject();
+				j.KS("titleId", s.lab.titleId);
+				j.KI("seconds", s.lab.seconds);
+				j.KI("ticks", s.lab.ticks);
+				j.KS("phase", phase);
+				j.KI("unix", (int64_t)unixT);
+				j.KS("cpu", s.cpu);
+				j.w.EndObject();
+				std::ofstream(LabDir() / "meta.json", std::ios::trunc) << j.sb.GetString();
+			}
+
+			void RestorePending()
+			{
+				// a Determinism Lab run swaps the save for a known starting point; put the player's own back
+				const fs::path marker = LabDir() / "restore_pending.json";
+				std::error_code ec;
+				if (!stdfs::exists(marker, ec))
+					return;
+				std::ifstream f(marker);
+				std::string t((std::istreambuf_iterator<char>(f)), {});
+				rapidjson::Document d;
+				d.Parse(t.c_str());
+				if (d.IsObject() && d.HasMember("titleId"))
+				{
+					const std::string id = d["titleId"].GetString();
+					const fs::path orig = LabDir() / "save_orig";
+					stdfs::remove_all(SaveDir(id), ec);
+					if (stdfs::exists(orig, ec))
+						CopyDir(orig, SaveDir(id));
+				}
+				f.close();
+				stdfs::remove(marker, ec);
+			}
+
+			void LabStart(const std::string& titleId, bool record, int seconds)
+			{
+				std::error_code ec;
+				stdfs::create_directories(LabDir(), ec);
+				RestorePending();
+				// back up the player's own save and mark it for restore
+				CopyDir(SaveDir(titleId), LabDir() / "save_orig");
+				{
+					ControlApi::Json j;
+					j.w.StartObject();
+					j.KS("titleId", titleId);
+					j.w.EndObject();
+					std::ofstream(LabDir() / "restore_pending.json", std::ios::trunc) << j.sb.GetString();
+				}
+				s.lab.hashes.clear();
+				s.lab.inputs.clear();
+				s.lab.checked = 0;
+				s.lab.mismatch = false;
+				s.lab.firstTick = 0;
+				s.lab.region.clear();
+				s.lab.hasResult = false;
+				s.lab.titleId = titleId;
+				if (record)
+				{
+					s.lab.seconds = seconds;
+					CopyDir(SaveDir(titleId), LabDir() / "save_start");
+					const uint64_t now = (uint64_t)time(nullptr);
+					SetAgreedUnixTime(now);
+					s.lab.ticks = 0;
+					LabSaveMeta("recording", now);
+					s.lab.fIn.open(LabDir() / "inputs.bin", std::ios::binary | std::ios::trunc);
+					s.lab.fHash.open(LabDir() / "hashes.bin", std::ios::binary | std::ios::trunc);
+					stdfs::remove(LabDir() / "result.json", ec);
+					s.lab.mode = Mode::LabRecord;
+				}
+				else
+				{
+					LabLoadMeta();
+					// load the recording
+					std::ifstream fi(LabDir() / "inputs.bin", std::ios::binary);
+					PadState p;
+					while (fi.read((char*)&p.buttons, 4) && fi.read((char*)&p.lx, 4))
+						s.lab.inputs.push_back(p);
+					std::ifstream fh(LabDir() / "hashes.bin", std::ios::binary);
+					for (;;)
+					{
+						HashRec h;
+						uint32_t n;
+						if (!fh.read((char*)&h.tick, 4) || !fh.read((char*)&h.total, 8) || !fh.read((char*)&n, 4))
+							break;
+						h.chunks.resize(n);
+						if (!fh.read(&h.chunks[0], n))
+							break;
+						s.lab.hashes.push_back(std::move(h));
+					}
+					CopyDir(LabDir() / "save_start", SaveDir(titleId));
+					s.lab.mode = Mode::LabReplay;
+				}
+				SetInterpreterOnly(s.cpu == "interpreter");
+				s.nPlayers = 1;
+				s.hashEvery = 30;
+				s.effDelay = 0;
+				SessionStarting();
+			}
+		} // namespace
